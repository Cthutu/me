use src.document
use src.editor
use src.terminal
use src.view
use src.workspace
use std.term

test "mode presentation uses contrasting green/red cursors and UTF-8 status badges, including narrow layouts" {
    terminal : Terminal
    terminal.signal_fd = -1
    terminal.editor.workspace.lock_fd = -1
    defer terminal.release()
    terminal.editor.workspace.add_empty()
    doc := ^terminal.editor.workspace.active_document().text
    on doc.load("abc") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    view := ^terminal.editor.workspace.active_view().interaction
    view.state = Interaction.Normal
    terminal.paint(40, 8)
    assert terminal.cells[3].paper == 0x7bd88f.as(Colour)
    assert terminal.cells[3].ink == 0x171d27.as(Colour)
    assert terminal.cells[3].rune == 'a'.as(u32)
    assert terminal.cells[6 * 40].paper == 0x7bd88f.as(Colour)
    assert terminal.cells[6 * 40 + 39].paper == 0x214c38.as(Colour)
    assert terminal.cells[6 * 40 + 1].rune == 0x25c6
    assert terminal.cells[6 * 40 + 3].rune == 'N'.as(u32)
    marker := no
    for cell in terminal.cells[6 * 40..7 * 40] {
        on cell.rune == 0x25cf => marker = yes
    }
    assert marker
    view.state = Interaction.Insert
    terminal.paint(40, 8)
    assert terminal.cells[3].paper == 0xf07178.as(Colour)
    assert terminal.cells[3].ink == 0x171d27.as(Colour)
    assert terminal.cells[6 * 40].paper == 0xf07178.as(Colour)
    assert terminal.cells[6 * 40 + 39].paper == 0x602d35.as(Colour)
    assert terminal.cells[6 * 40 + 1].rune == 0x270e
    assert terminal.cells[6 * 40 + 3].rune == 'I'.as(u32)
    for width in [1.as(usize), 2, 7, 10, 20] {
        terminal.paint(width^, 2)
        assert terminal.cells.count == width^ * 2
    }
    terminal.editor.workspace.checkpoint_failed = yes
    terminal.paint(8, 2)
    assert terminal.cells[1].rune == 'I'.as(u32)
    assert terminal.cells[4].rune == '!'.as(u32)
    assert terminal.cells[5].rune == 'C'.as(u32)
    terminal.editor.prompt_open(':'.as(u32), initial = "e a")
    terminal.editor.completion.items.push("a\n\t.txt")
    terminal.editor.completion.items.push("another.txt")
    terminal.editor.completion.active = yes
    terminal.paint(40, 8)
    assert terminal.cells[5 * 40].paper == 0x386a91.as(Colour)
    assert terminal.cells[5 * 40].rune == 0x203a
    assert terminal.cells[5 * 40 + 3].rune == 0xfffd
    assert terminal.cells[7 * 40].rune == ':'.as(u32)
    terminal.editor.completion.selected = 1
    terminal.paint(40, 8)
    assert terminal.cells[6 * 40].paper == 0x386a91.as(Colour)
    assert terminal.cells[7 * 40].rune == ':'.as(u32)
    terminal.editor.completion.items.clear()
    terminal.paint(40, 8)
    assert terminal.cells[6 * 40].rune == 'N'.as(u32)
    assert terminal.cells[7 * 40].rune == ':'.as(u32)
    terminal.paint(1, 1)
    assert terminal.cells.count == 1
    terminal.paint(0, 0)
}
