use src.buffer
use src.codec
use src.document
use src.native
use src.search

roundtrip :: fn () -> void\string {
    doc : Document
    defer doc.release()
    on doc.load("BOM: ﻿\r\nwithout final newline") {
        _success => {
        }

        _error! => return "load"!
    }
    on doc.edit({ start: 0 end: 0 }, "a") {
        _change => {
        }

        _error! => return "edit"!
    }
    on doc.edit({ start: 1 end: 1 }, "b") {
        _change => {
        }

        _error! => return "edit"!
    }
    on doc.undo_edit() {
        _change => {
        }

        else => {
            assert no
        }
    }
    encoded : Encoder
    defer encoded.bytes.free()
    encoded.document(^doc)
    decoded : Document
    defer decoded.release()
    reader := Decoder { bytes: bytes_text(encoded.bytes) ... }
    reader.document(^decoded)?
    assert decoded.text() == doc.text()
    assert decoded.applied == 1 && decoded.history.count == 2
    on decoded.redo_edit() {
        _change => {
        }

        else => {
            assert no
        }
    }
    assert decoded.text()[..2] == "ab"
    assert reader.offset == reader.bytes.count
    corrupt := Decoder { bytes: "truncated" ... }
    on corrupt.document(^decoded) {
        _success => {
            assert no
        }

        _error! => {
        }
    }
}

test "continuation codec round-trips bytes, branched history, undo position and redo" {
    on roundtrip() {
        _success => {
        }

        error! => {
            assert no, error
        }
    }
}

test "literal search wraps and skips the active occurrence" {
    on find_literal("one two one", "one", 0, no) {
        position => {
            assert position == 0
        }

        else => {
            assert no
        }
    }
    on find_literal("one two one", "one", 0, no, skip_origin = yes) {
        position => {
            assert position == 8
        }

        else => {
            assert no
        }
    }
    on find_literal("one two one", "one", 0, yes, skip_origin = yes) {
        position => {
            assert position == 8
        }

        else => {
            assert no
        }
    }
    on find_literal("abc", "", 0, no) {
        _position => {
            assert no
        }

        else => {
        }
    }
    on find_literal("abc", "long", 0, no) {
        _position => {
            assert no
        }

        else => {
        }
    }
}
