use src.buffer
use src.codec
use src.document
use src.editor
use src.native
use src.replacement
use src.view
use src.workspace

parser_plans :: fn () -> void\string {
    scratch : arena
    defer scratch.done()
    command := parse_replace(^scratch, "/one/two")?
    assert command.needle == "one" && command.replacement == "two" && !command.confirm
    on plan_replacement(^scratch, "before one middle one after", command) {
        plan => {
            assert plan.range.start == 7 && plan.range.end == 21
            assert plan.text == "two middle two" && plan.count == 2
        }

        else => {
            assert no
        }
    }
    escaped := parse_replace(^scratch, "/a\\/b/c\\\\d/c")?
    assert escaped.needle == "a/b" && escaped.replacement == "c\\d" && escaped.confirm
    literal := parse_replace(^scratch, "/one/\\n/")?
    assert literal.replacement == "\\n"
    deletion := parse_replace(^scratch, "/a/")?
    on plan_replacement(^scratch, "a a", deletion) {
        plan => {
            assert plan.text == " " && plan.count == 2
        }

        else => {
            assert no
        }
    }
    assert slash_separator("src\\/old") == nil
    assert slash_separator("src\\/old/new") == 8
    for invalid in ["//new", "/old", "/old/new/g", "/old/new/c/x"] {
        on parse_replace(^scratch, invalid^) {
            _valid => {
                assert no
            }

            _invalid! => {
            }
        }
    }
}

origin_prefixes :: fn () -> void\string {
    scratch : arena
    defer scratch.done()
    editor : Editor
    editor.workspace.lock_fd = -1
    defer editor.release()
    editor.workspace.add_empty()
    doc := ^editor.workspace.active_document().text
    on doc.load("term term") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    editor.workspace.active_view().interaction.place(doc, 5, no)
    editor.prompt_open('/'.as(u32), initial = "term")
    assert editor.active_match == 5
    editor.execute(^scratch, Command.Escape)?
    assert editor.workspace.active_view().interaction.selection.active == 5
    editor.prompt_open('/'.as(u32), initial = "/term")
    assert editor.search_query() == "term" && editor.active_match == 0
    editor.finish_slash(^scratch)?
    assert doc.text() == "term term" && doc.history.count == 0
    assert editor.workspace.active_view().interaction.selection.active == 0
    editor.workspace.active_view().interaction.place(doc, 5, no)
    editor.prompt_open('/'.as(u32), initial = "/")
    assert editor.active_match == 0
    -- Empty origin query reuses the remembered search.
    editor.execute(^scratch, Command.Escape)?
    assert editor.workspace.active_view().interaction.selection.active == 5
    editor.prompt_open('?'.as(u32), initial = "?term")
    assert editor.active_match == 5
    editor.finish_slash(^scratch)?
    editor.prompt_open('/'.as(u32), initial = "/term/X")
    editor.finish_slash(^scratch)?
    assert doc.text() == "X X" && doc.history.count == 1
    editor.execute(^scratch, Command.Undo)?
    assert doc.text() == "term term"
    editor.prompt_open('/'.as(u32), initial = "/term/Y/c")
    editor.finish_slash(^scratch)?
    assert editor.confirmation.active && editor.active_match == 0
    editor.confirm_replace(^scratch, 'n'.as(u32))?
    editor.confirm_replace(^scratch, 'a'.as(u32))?
    assert doc.text() == "term Y" && doc.history.count == 1
    editor.execute(^scratch, Command.Undo)?
    assert doc.text() == "term term"
    on doc.load("src/old src/old") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    editor.workspace.active_view().interaction.place(doc, 8, no)
    editor.prompt_open('/'.as(u32), initial = "/src\\/old")
    assert editor.search_query() == "src/old" && editor.active_match == 0
    editor.execute(^scratch, Command.Escape)?
    assert editor.workspace.active_view().interaction.selection.active == 8
    assert doc.history.count == 0
    editor.prompt_open('/'.as(u32), initial = "//new")
    on editor.finish_slash(^scratch) {
        _success => {
            assert no
        }

        _error! => {
        }
    }
    assert doc.text() == "src/old src/old" && doc.history.count == 0
}

test "leading double-slash search origins coexist with later replacement separators and escaped slashes" {
    on origin_prefixes() {
        _success => {
        }

        error! => {
            assert no, error
        }
    }
}

test "second-slash replacement parsing defaults to literal replace-all and supports only optional confirmation" {
    on parser_plans() {
        _success => {
        }

        error! => {
            assert no, error
        }
    }
}

confirmation_history :: fn () -> void\string {
    scratch : arena
    defer scratch.done()
    editor : Editor
    editor.workspace.lock_fd = -1
    defer editor.release()
    editor.workspace.add_empty()
    original := "one one one one"
    doc      := ^editor.workspace.active_document().text

    on doc.load(original) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    editor.workspace.active_view().interaction.place(doc, original.count, no)
    editor.prompt_open('/'.as(u32), initial = "one/two")
    assert doc.text() == original
    editor.execute(^scratch, Command.Escape)?
    assert editor.workspace.active_view().interaction.selection.active == original.count
    editor.prompt_open('/'.as(u32), initial = "one/two")
    editor.execute(^scratch, Command.InsertText("\n"))?
    assert doc.text() == "two two two two" && doc.history.count == 1
    editor.execute(^scratch, Command.Undo)?
    assert doc.text() == original
    assert editor.workspace.active_view().interaction.selection.active == original.count
    editor.workspace.active_view().interaction.place(doc, 0, no)
    editor.prompt_open('/'.as(u32), initial = "one/X/c")
    editor.execute(^scratch, Command.InsertText("\n"))?
    assert editor.confirmation.active && doc.text() == original
    editor.execute(^scratch, Command.Save)?  -- Other editing commands cannot interrupt grouping.
    editor.confirm_replace(^scratch, 'n'.as(u32))?
    editor.confirm_replace(^scratch, 'y'.as(u32))?
    assert doc.text() == "one X one one"
    editor.confirm_replace(^scratch, 'y'.as(u32))?
    assert doc.text() == "one X X one" && doc.applied == 1 && doc.history.count == 1
    encoded : Encoder
    defer encoded.bytes.free()
    encoded.document(doc)
    restored : Document
    defer restored.release()
    reader := Decoder { bytes: bytes_text(encoded.bytes) ... }
    reader.document(^restored)?
    assert restored.text() == doc.text()
    on restored.undo_edit() {
        _change => {
        }

        else => {
            assert no
        }
    }
    assert restored.text() == original
    on restored.redo_edit() {
        _change => {
        }

        else => {
            assert no
        }
    }
    assert restored.text() == "one X X one"
    editor.execute(^scratch, Command.Escape)?
    assert !editor.confirmation.active && doc.text() == "one X X one"
    editor.execute(^scratch, Command.Undo)?
    assert doc.text() == original && editor.workspace.active_view().interaction.selection.active == 0
    editor.execute(^scratch, Command.Redo)?
    assert doc.text() == "one X X one"
    on doc.load("a a") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    editor.workspace.active_view().interaction.place(doc, 0, no)
    editor.prompt_open('/'.as(u32), initial = "a/a/c")
    editor.finish_slash(^scratch)?
    editor.confirm_replace(^scratch, 'a'.as(u32))?
    assert !editor.confirmation.active && doc.history.count == 0
    editor.prompt_open('/'.as(u32), initial = "a/b/c")
    editor.finish_slash(^scratch)?
    editor.confirm_replace(^scratch, 'n'.as(u32))?
    editor.confirm_replace(^scratch, 'n'.as(u32))?
    assert !editor.confirmation.active && doc.text() == "a a" && doc.history.count == 0
}

test "confirmation keeps approved edits as one undo unit, including partial checkpoints, skips, stopping and no-ops" {
    on confirmation_history() {
        _success => {
        }

        error! => {
            assert no, error
        }
    }
}

shared_and_search :: fn () -> void\string {
    scratch : arena
    defer scratch.done()
    editor : Editor
    editor.workspace.lock_fd = -1
    defer editor.release()
    editor.workspace.add_empty()
    doc := ^editor.workspace.active_document().text
    on doc.load("a a a") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    other : TextView
    other.document_id = 0
    other.interaction.place(doc, 5, no)
    editor.workspace.views.push(other)
    editor.prompt_open('/'.as(u32), initial = "a/XX/c")
    editor.finish_slash(^scratch)?
    editor.confirm_replace(^scratch, 'y'.as(u32))?
    assert editor.workspace.views[1].interaction.selection.active == 6
    editor.confirm_replace(^scratch, 'n'.as(u32))?
    editor.confirm_replace(^scratch, 'a'.as(u32))?
    assert doc.text() == "XX a XX" && doc.history.count == 1
    assert editor.workspace.views[1].interaction.selection.active == 7
    editor.execute(^scratch, Command.Undo)?
    assert doc.text() == "a a a" && editor.workspace.views[1].interaction.selection.active == 5
    editor.prompt_open('/'.as(u32), initial = "a/z/c")
    editor.finish_slash(^scratch)?
    on doc.edit({ start: doc.text().count end: doc.text().count }, "!") {
        _change => {
        }

        _error! => {
            assert no
        }
    }
    editor.confirm_replace(^scratch, 'y'.as(u32))?
    assert !editor.confirmation.active && doc.text() == "a a a!"
    on doc.load("src/old other src/old") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    editor.workspace.active_view().interaction.place(doc, 0, no)
    editor.prompt_open('/'.as(u32), initial = "src\\/old")
    assert editor.search_query() == "src/old"
    editor.finish_slash(^scratch)?
    assert doc.history.count == 0 && doc.text() == "src/old other src/old"
    editor.prompt_open('/'.as(u32), initial = "src\\/old/new")
    editor.finish_slash(^scratch)?
    assert doc.text() == "new other new" && doc.history.count == 1
    on doc.load("﻿one\r\none\t") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    editor.workspace.active_view().interaction.place(doc, doc.line_start(0), no)
    editor.prompt_open('/'.as(u32), initial = "one/long/c")
    editor.finish_slash(^scratch)?
    editor.confirm_replace(^scratch, 'Y'.as(u32))?
    editor.confirm_replace(^scratch, 'A'.as(u32))?
    assert doc.text() == "﻿long\r\nlong\t"
    editor.execute(^scratch, Command.Undo)?
    assert doc.text() == "﻿one\r\none\t"
    for replacement in ["", "aa"] {
        on doc.load("aaa") {
            _success => {
            }

            _error! => {
                assert no
            }
        }
        editor.workspace.active_view().interaction.place(doc, 0, no)
        editor.prompt_open('/'.as(u32),
                           initial = scratch.pr($"a/{replacement^}/c"))
        editor.finish_slash(^scratch)?
        editor.confirm_replace(^scratch, 'y'.as(u32))?
        editor.confirm_replace(^scratch, 'y'.as(u32))?
        editor.confirm_replace(^scratch, 'a'.as(u32))?
        expected := on replacement.count == 0 {
            yes   => ""
            else  => "aaaaaa"
        }
        assert doc.text() == expected && doc.history.count == 1
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == "aaa"
    }
}

test "confirmation adjusts shared views, stops on unexpected changes, preserves BOM/endings and leaves escaped-slash searches literal" {
    on shared_and_search() {
        _success => {
        }

        error! => {
            assert no, error
        }
    }
}
