use src.characters
use src.view

test "reverse traversal agrees with forward grapheme boundaries across lines and scripts" {
    text             := "a\r\né👩‍💻🇬🇧क्ष\nlast"
    position : usize = 0

    for position < text.count {
        next := next_character(text, position)
        assert next > position
        assert previous_character(text, next) == position
        position = next
    }
    assert previous_character(text, 0) == 0
}

test "view widths handle emoji presentation, flags, tabs and isolated combining characters" {
    assert character_width("é", 0, 0) == 1
    assert character_width("👩‍💻", 0, 0) == 2
    assert character_width("🇬🇧", 0, 0) == 2
    assert character_width("1️⃣", 0, 0) == 2
    assert character_width("❤️", 0, 0) == 2
    assert character_width("́", 0, 0) == 1
    assert character_width("\t", 0, 1) == 3
    assert character_width("\t", 0, 4) == 4
    assert character_width("\n", 0, 0) == 0
    assert display_column("éx", 0, 1) == 0
    assert display_column("éx", 0, 3) == 1
    assert word_kind("é", 0) == 1
    assert word_kind("字", 0) == 1
    assert word_kind("١", 0) == 1
    assert word_kind("—", 0) == 2
    assert word_kind("👩", 0) == 2
    assert word_kind(" ", 0) == 0
}
