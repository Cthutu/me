use native
use os.linux
use std.text

-- Linux ABI flags and linux_dirent64 layout absent from the high-level API.
O_DIRECTORY  :: 0x10000
DT_UNKNOWN   :: 0
DT_DIRECTORY :: 4
DT_REGULAR   :: 8
DT_SYMLINK   :: 10

-- Paths are literal bytes after the first separating space, not shell words.
-- This also preserves leading/trailing whitespace in names chosen from a list.
pub PathCommand :: plex {
    verb           string
    argument_start usize
}

-- Keep this sorted and aligned with Editor.command_line's supported verbs.
COMMAND_NAMES :: [
    "buffer",
    "buffers",
    "e",
    "keys",
    "kill",
    "kill!",
    "q",
    "q!",
    "w",
    "w!",
    "wq",
    "ww",
]

pub command_start :: fn (text: string) -> usize {
    start : usize = 0
    for start < text.count && text[start] == ' ' {
        start += 1
    }
    return start
}

pub path_command :: fn (text: string) -> ?PathCommand {
    start := command_start(text)
    end   := start

    for end < text.count && text[end] != ' ' {
        end += 1
    }
    verb := text[start..end]
    on verb != "e" && verb != "w" && verb != "w!" && verb != "ww" => return nil
    return PathCommand { verb argument_start: on end < text.count { yes => end + 1 else => end } }
}

path_root :: fn (path: string) -> usize {
    root : usize = 0
    for index, byte in path {
        on byte^ == '/' => root = index + 1
    }
    return root
}

before :: fn (left: string, right: string) -> bool {
    limit := on left.count < right.count {
        yes   => left.count
        else  => right.count
    }
    for i in [0.as(usize) .. limit] {
        on left[i] != right[i] => return left[i] < right[i]
    }
    return left.count < right.count
}

pub PromptCompletion :: plex {
    storage           arena
    items             [..]string
    all_files         [..]string
    cached_folder     string
    cached_prefix     string
    cache_valid       bool
    selected          usize
    replacement_start usize
    command_mode      bool
    active            bool
}

impl PromptCompletion {

    pub reset :: fn (self: ^Self) {
        self.active = no
        self.selected = 0
        self.items.clear()
        self.all_files.clear()
        self.cache_valid = no
        self.storage.reset()
    }

    pub release :: fn (self: ^Self) {
        self.items.free()
        self.all_files.free()
        self.storage.done()
    }

    pub common_prefix :: fn (self: ^Self) -> string {
        on self.items.count == 0 => return ""
        first := self.items[0]
        count := first.count

        for item in self.items {
            on item.count < count => count = item.count
            i : usize = 0
            for i < count && first[i] == item^[i] {
                i += 1
            }
            count = i
        }
        -- Do not introduce a partial UTF-8 character into an otherwise valid
        -- filename. Invalid-byte Linux filenames remain byte strings.
        on first.utf8_validate() {
            _valid => {
                for count > 0 &&
                    count < first.count &&
                    (first[count] & 0xc0) == 0x80 {
                    count -= 1
                }
            }

            _invalid! => {
            }
        }
        return first[..count]
    }

    pub commands :: fn (self: ^Self, prefix: string) {
        self.reset()
        self.command_mode = yes
        for name in COMMAND_NAMES {
            on name.count >= prefix.count &&
                name^[..prefix.count] == prefix => self.items.push(name^)
        }
    }

    pub filter_files :: fn (self   : ^Self,
                            folder : string,
                            path   : string) -> void\string {
        root := path_root(path)

        on self.cache_valid &&
            self.cached_folder == folder &&
            self.cached_prefix == path[..root] => {
            self.filter_leaf(path[root..])?
            return
        }
        self.scan(folder, path)?
    }

    filter_leaf :: fn (self: ^Self, leaf: string) -> void\string {
        self.active = no
        self.selected = 0
        self.items.clear()
        self.command_mode = no
        for item in self.all_files {
            name := item^[self.cached_prefix.count..]
            on self.cached_prefix.count == 0 &&
                name.count >= 2 &&
                name[..2] == "./" => name = name[2..]
            on name[0] == '.' && (leaf.count == 0 || leaf[0] != '.') => again
            on name.count < leaf.count || name[..leaf.count] != leaf => again
            on self.items.count >= 4096 => {
                self.items.clear()
                return "Too many completion matches; type a longer prefix"!
            }
            self.items.push(item^)
        }
        self.sort_items()
    }

    sort_items :: fn (self: ^Self) {
        -- Only the bounded match set is sorted, not the full directory snapshot.
        for i in [1.as(usize) .. self.items.count] {
            item := self.items[i]
            j    := i

            for j > 0 && before(item, self.items[j - 1]) {
                self.items[j] = self.items[j - 1]
                j -= 1
            }
            self.items[j] = item
        }
    }

    pub scan :: fn (self: ^Self, folder: string, path: string) -> void\string {
        self.reset()
        self.command_mode = no
        completed := no
        defer on !completed => self.reset()
        for byte in path {
            on byte^ == 0 => return "A path cannot contain NUL"!
        }
        query  := on path == "~" { yes => "~/" else => path }
        root   := path_root(query)
        prefix := query[..root]

        self.cached_prefix = self.storage.pr(prefix)
        self.cached_folder = self.storage.pr(folder)
        leaf := query[root..]
        base := on folder.count > 0 { yes => folder else => "." }

        expanded := expand_home_path(^self.storage, prefix)?
        directory := on expanded.count > 0 && expanded[0] == '/' {
            yes   => expanded
            else  => self.storage.pr($"{base}/{expanded}")
        }
        zero := self.storage.pr($"{directory}\0")
        fd   := sys_open(zero.data.as(^i8), O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0)

        on fd < 0 => return "Cannot read completion directory"!
        defer {
            _ := sys_close(fd)
        }
        -- A bare home component completes like a directory name: add the
        -- slash first, even if its directory contains only hidden files.
        on path == "~" => {
            self.items.push("~/")
            completed = yes
            return
        }
        buffer  : [32768]u8
        visited : usize     = 0

        for {
            count := syscall(SYS_GETDENTS64,
                             fd.as(u64),
                             buffer[..].data.as(usize).as(u64),
                             buffer.count.as(u64),
                             0,
                             0,
                             0)
            on count < 0 => {
                on last_error() == EINTR => again
                return "Cannot enumerate completion directory"!
            }
            on count == 0 => break
            offset : usize = 0
            for offset < count.as(usize) {
                on count.as(usize) - offset < 20 => return "Invalid directory "
                    +"entry"!
                -- d_reclen is a little-endian u16 at 16, d_type at 18,
                -- followed by a NUL-terminated byte name at 19 (Linux x86-64).
                length := buffer[offset + 16].as(usize) | (buffer[offset + 17].as(usize) << 8)
                on length < 20 ||
                    length > count.as(usize) - offset => return "Invalid "
                    +"directory entry"!
                end := offset + 19
                for end < offset + length && buffer[end] != 0 {
                    end += 1
                }
                on end == offset + length => return "Invalid directory name"!
                name := buffer[offset + 19..end].as(string)
                kind := buffer[offset + 18]

                offset  += length
                visited += 1
                on visited > 65536 => return "Directory too large for "
                    +"synchronous completion; type the path directly"!
                on name.count == 0 || name == "." || name == ".." => again
                is_directory := kind == DT_DIRECTORY
                on kind != DT_DIRECTORY &&
                    kind != DT_REGULAR => {
                    on kind != DT_UNKNOWN && kind != DT_SYMLINK => again
                    on metadata(^self.storage, self.storage.pr($"{directory}/{name}")) {
                        info => {
                            mode := info.mode & 0xf000
                            on mode != 0x4000 && mode != 0x8000 => again
                            is_directory = mode == 0x4000
                        }

                        else => again
                    }
                }
                suffix := on is_directory {
                    yes   => "/"
                    else  => ""
                }
                literal := on prefix.count == 0 && name == "~" {
                    yes   => "./"
                    else  => ""
                }
                self.all_files.push(self.storage.pr($"{literal}{prefix}{name}{suffix}"))
            }
        }
        self.cache_valid = yes
        completed = yes
        self.filter_leaf(leaf)?
    }

}

test {

    exercise_literal_tilde_completion :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        folder := scratch.pr($"_tmp/tilde-completion-{syscall(SYS_GETPID, 0, 0, 0, 0, 0, 0)}")
        assert make_directory(^scratch, "_tmp")
        assert make_directory(^scratch, folder)
        directory := scratch.pr($"{folder}/~")
        assert make_directory(^scratch, directory)
        file := scratch.pr($"{directory}/inside")
        atomic_write(^scratch, file, "literal", no)?
        defer {
            _ := syscall(SYS_UNLINK,
                         file.c_string().as(usize).as(u64),
                         0,
                         0,
                         0,
                         0,
                         0)
            _ := syscall(SYS_RMDIR,
                         directory.c_string().as(usize).as(u64),
                         0,
                         0,
                         0,
                         0,
                         0)
            _ := syscall(SYS_RMDIR,
                         folder.c_string().as(usize).as(u64),
                         0,
                         0,
                         0,
                         0,
                         0)
        }
        state : PromptCompletion
        defer state.release()
        state.scan(folder, "")?
        assert state.items.count == 1
        assert state.items[0] == "./~/"
        state.filter_files(folder, "")?
        assert state.items.count == 1
        assert state.items[0] == "./~/"
        state.scan(folder, "./~/")?
        assert state.items.count == 1
        assert state.items[0] == "./~/inside"
    }

}

test "completion escapes literal leading tilde entries without hiding them" {
    on exercise_literal_tilde_completion() {
        _success => {
        }

        error! => {
            assert no, error
        }
    }
}

test "literal path command parsing and common prefixes preserve bytes and UTF-8 boundaries" {
    raw := "  e  leading and trailing \t\n "
    on path_command(raw) {
        parsed => {
            assert raw[parsed.argument_start..] == " leading and trailing \t\n "
        }

        else => {
            assert no
        }
    }
    assert path_command("replace /a/b/") == nil
    state : PromptCompletion
    defer state.release()
    state.items.push("é.txt")
    state.items.push("è.txt")
    assert state.common_prefix() == ""
    state.reset()
    state.items.push("alpha.txt")
    state.items.push("alpine.txt")
    assert state.common_prefix() == "alp"
    state.reset()
    left  : [2]u8 = [0xff, 'a']
    right : [2]u8 = [0xff, 'b']

    state.items.push(left[..].as(string))
    state.items.push(right[..].as(string))
    assert state.common_prefix().count == 1
    assert state.common_prefix()[0] == 0xff
}
