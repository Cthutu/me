use syntax

space :: fn (byte: u8) => byte == ' ' || byte == '\t' || byte == '\r'

word_byte :: fn (byte: u8) => byte >= 128 || (byte >= 'a' && byte <= 'z') || (byte >= 'A' && byte <= 'Z') || (byte >= '0' && byte <= '9') || byte == '_'

run_end :: fn (text: string, start: usize, end: usize) -> usize {
    offset := start
    for offset < end && text[offset] == text[start] {
        offset += 1
    }
    return offset
}

-- An entire line of a repeated marker, allowing spaces between markers.
marker_line :: fn (text    : string,
                   start   : usize,
                   end     : usize,
                   marker  : u8,
                   minimum : usize) -> bool {
    count : usize = 0
    for byte in text[start..end] {
        on byte^ == marker {
            yes => count += 1

            else => {
                on !space(byte^) => return no
            }
        }
    }
    return count >= minimum
}

underline_line :: fn (text: string, start: usize, end: usize) -> bool {
    on start == end || (text[start] != '=' && text[start] != '-') => return no
    after := run_end(text, start, end)
    for byte in text[after..end] {
        on !space(byte^) => return no
    }
    return yes
}

-- Typed line metadata is allocated only by buffers requesting Markdown
-- analysis.
pub MarkdownState :: plex {
    fence        u8
    fence_size   usize
    fence_quotes usize
    paragraph    bool
}

pub MarkdownLine :: plex {
    input  MarkdownState
    output MarkdownState
    setext bool
    length usize
    spans  [..]SyntaxSpan
}

impl MarkdownLine {

    pub release :: fn (self: ^Self) {
        self.spans.free()
    }

    add :: fn (self: ^Self, start: usize, end: usize, style: SyntaxStyle) {
        on end > start => self.spans.push(SyntaxSpan { start end style })
    }

    inline :: fn (self: ^Self, text: string, start: usize, end: usize) {
        position := start
        budget   := (end - start) * 4 + 64

        for position < end {
            byte := text[position]
            on byte == '\\' &&
                position + 1 < end &&
                text[position + 1] < 128 => {
                position += 2
                again
            }
            on byte == '`' ||
                byte == '*' ||
                byte == '_' => {
                after := run_end(text, position, end)
                size  := after - position

                on byte != '`' &&
                    (size > 3 || after == end || space(text[after]) || (byte == '_' && position > start && word_byte(text[position - 1]))) => {
                    position = after
                    again
                }
                closing := after
                found   := no

                for closing < end {
                    on budget == 0 => return
                    budget -= 1
                    on byte != '`' &&
                        text[closing] == '\\' &&
                        closing + 1 < end => {
                        closing += 2
                        again
                    }
                    on text[closing] == byte {
                        yes => {
                            finish := run_end(text, closing, end)
                            on finish - closing == size &&
                                closing > after &&
                                (byte == '`' || (!space(text[closing - 1]) && (byte != '_' || finish == end || !word_byte(text[finish])))) => {
                                style := on byte == '`' {
                                    yes => SyntaxStyle.Code

                                    else => on size >= 2 {
                                        yes   => SyntaxStyle.Strong
                                        else  => SyntaxStyle.Emphasis
                                    }
                                }
                                self.add(position, finish, style)
                                position = finish
                                found    = yes
                                break
                            }
                            closing = finish
                        }

                        else => closing += 1
                    }
                }
                on !found => {
                    -- Nothing else can close this run on the line. Avoid
                    -- repeatedly rescanning unmatched delimiter runs.
                    position = after
                }
                again
            }
            on byte == '[' ||
                (byte == '!' && position + 1 < end && text[position + 1] == '[') => {
                bracket := position
                on byte == '!' => bracket += 1
                closing := bracket + 1
                for closing < end && text[closing] != ']' {
                    on budget == 0 => return
                    budget -= 1
                    on text[closing] == '\\' &&
                        closing + 1 < end => closing += 1
                    closing += 1
                }
                on closing + 1 < end &&
                    (text[closing + 1] == '(' || text[closing + 1] == '[') => {
                    opener         := text[closing + 1]
                    closer         := on opener == '(' { yes => ')'.as(u8) else => ']'.as(u8) }
                    finish         := closing + 2
                    depth  : usize = 1

                    for finish < end && depth > 0 {
                        on budget == 0 => return
                        budget -= 1
                        on text[finish] == '\\' && finish + 1 < end {
                            yes => finish += 2

                            else => {
                                on text[finish] == opener => depth += 1
                                on text[finish] == closer => depth -= 1
                                finish += 1
                            }
                        }
                    }
                    on depth == 0 => {
                        self.add(position, finish, SyntaxStyle.Link)
                        position = finish
                        again
                    }
                }
            }
            position += 1
        }
    }

}

-- Analyse a physical line independently, retaining the state needed to resume.
lex_line :: fn (text: string, input: MarkdownState) -> MarkdownLine {
    line : MarkdownLine
    line.input = input
    line.output = input
    end := text.count
    on end > 0 && text[end - 1] == '\r' => end -= 1
    line.length = end
    for {
        cursor : usize = 0
        indent : usize = 0

        for cursor < end &&
            (text[cursor] == ' ' ||
                text[cursor] == '\t') {
            indent += on text[cursor] == '\t' { yes => 4 - indent % 4 else => 1 }
            cursor += 1
        }
        on line.output.fence != 0 => {
            quotes : usize = 0
            for cursor < end && text[cursor] == '>' {
                quotes += 1
                cursor += 1
                for cursor < end && space(text[cursor]) {
                    cursor += 1
                }
            }
            on quotes < line.output.fence_quotes => {
                line.output = MarkdownState { ... }
                again
            }
            line.add(0, end, SyntaxStyle.Code)
            on indent <= 3 &&
                quotes == line.output.fence_quotes &&
                cursor < end &&
                text[cursor] == line.output.fence => {
                after := run_end(text, cursor, end)
                clean := yes

                for byte in text[after..end] {
                    on !space(byte^) => clean = no
                }
                on after - cursor >= line.output.fence_size &&
                    clean => line.output = MarkdownState { ... }
            }
            line.output.paragraph = no
            return line
        }
        on indent > 3 => {
            line.add(0, end, SyntaxStyle.Code)
            line.output = MarkdownState { ... }
            return line
        }
        quote_depth : usize = 0
        for cursor < end && text[cursor] == '>' {
            line.add(cursor, cursor + 1, SyntaxStyle.Marker)
            quote_depth += 1
            cursor      += 1
            for cursor < end && space(text[cursor]) {
                cursor += 1
            }
        }
        on cursor < end &&
            (text[cursor] == '`' || text[cursor] == '~') => {
            after := run_end(text, cursor, end)
            valid := after - cursor >= 3

            on text[cursor] == '`' => {
                for byte in text[after..end] {
                    on byte^ == '`' => valid = no
                }
            }
            on valid => {
                line.output = MarkdownState { fence: text[cursor] fence_size: after - cursor fence_quotes: quote_depth ... }
                line.add(cursor, end, SyntaxStyle.Code)
                return line
            }
        }
        heading_end := cursor
        for heading_end < end && text[heading_end] == '#' {
            heading_end += 1
        }
        heading   := heading_end > cursor && heading_end - cursor <= 6 && (heading_end == end || space(text[heading_end]))
        underline := line.output.paragraph && underline_line(text, cursor, end)
        rule      := marker_line(text, cursor, end, '*'.as(u8), 3) || marker_line(text, cursor, end, '-'.as(u8), 3) || marker_line(text, cursor, end, '_'.as(u8), 3)

        on {
            heading => line.add(cursor, end, SyntaxStyle.Heading)
            underline => {
                -- The next line controls setext presentation of this line.
                -- Keep base spans intact so removing an underline restores them.
                line.setext = yes
                line.add(cursor, end, SyntaxStyle.Marker)
            }
            rule => line.add(cursor, end, SyntaxStyle.Rule)
            else => {
                marker_end := cursor
                on cursor < end && (text[cursor] == '-' || text[cursor] == '+' || text[cursor] == '*') {
                    yes => marker_end = cursor + 1

                    else => {
                        for marker_end < end &&
                            text[marker_end] >= '0' &&
                            text[marker_end] <= '9' {
                            marker_end += 1
                        }
                        on marker_end > cursor && marker_end - cursor <= 9 && marker_end < end && (text[marker_end] == '.' || text[marker_end] == ')') {
                            yes   => marker_end += 1
                            else  => marker_end = cursor
                        }
                    }
                }
                on marker_end > cursor &&
                    (marker_end == end || space(text[marker_end])) => {
                    line.add(cursor, marker_end, SyntaxStyle.Marker)
                    cursor = marker_end
                }
                line.inline(text, cursor, end)
            }
        }
        line.output.paragraph = cursor < end && !heading && !underline && !rule
        return line
    }
}

pub MarkdownSyntax :: plex {
    ready    bool
    revision u64
    lines    [..]MarkdownLine
}

impl MarkdownSyntax {

    pub release :: fn (self: ^Self) {
        for line in self.lines {
            line.release()
        }
        self.lines.free()
    }

    -- Prefix/suffix are known unchanged by edit notifications, never hashes.
    -- Reuse suffix rows as soon as their entering lexer state matches again.
    -- Return the number of lines actually analysed (zero on a cached repaint).
    pub update :: fn (self     : ^Self,
                      text     : string,
                      starts   : []usize,
                      revision : u64,
                      prefix   : usize,
                      suffix   : usize) -> usize {
        on self.ready && self.revision == revision => return 0
        first := on self.ready {
            yes   => prefix
            else  => 0.as(usize)
        }
        on first > self.lines.count => first = self.lines.count
        on first > starts.count => first = starts.count
        -- A line can acquire setext presentation from its following line.
        on first > 0 => first -= 1
        retained := on self.ready {
            yes   => suffix
            else  => 0.as(usize)
        }
        on retained > self.lines.count - first => retained = self.lines.count - first
        on retained > starts.count - first => retained = starts.count - first
        on starts.count == self.lines.count {
            yes => {
                -- Ordinary character edits retain the line table allocation.
                for index in [first .. self.lines.count - retained] {
                    self.lines[index].release()
                    self.lines[index] = MarkdownLine { ... }
                }
            }

            else => {
                next : [..]MarkdownLine
                next.resize_to(starts.count)
                for index in [0.as(usize) .. first] {
                    next[index] = self.lines[index]
                }
                for index in [0.as(usize) .. retained] {
                    next[starts.count - retained + index] = self.lines[self.lines.count - retained + index]
                }
                for index in [first .. self.lines.count - retained] {
                    self.lines[index].release()
                }
                self.lines.free()
                self.lines = next
            }
        }
        state : MarkdownState
        on first > 0 => state = self.lines[first - 1].output
        analysed : usize = 0
        for index in [first .. starts.count] {
            on index >= starts.count - retained &&
                self.lines[index].input == state => break
            self.lines[index].release()
            end := on index + 1 < starts.count {
                yes   => starts[index + 1] - 1
                else  => text.count
            }
            self.lines[index] = lex_line(text[starts[index]..end], state)
            state    = self.lines[index].output
            analysed += 1
        }
        self.ready = yes
        self.revision = revision
        return analysed
    }

    pub line_style :: fn (self     : ^Self,
                          line     : usize,
                          position : usize) -> SyntaxStyle {
        on line >= self.lines.count ||
            position >= self.lines[line].length => return SyntaxStyle.Text
        on line + 1 < self.lines.count &&
            self.lines[line + 1].setext => return SyntaxStyle.Heading
        spans         := self.lines[line].spans[..]
        lower : usize = 0
        upper         := spans.count

        for lower < upper {
            middle := lower + (upper - lower) / 2
            on spans[middle].end <= position {
                yes   => lower = middle + 1
                else  => upper = middle
            }
        }
        on lower < spans.count &&
            spans[lower].start <= position => return spans[lower].style
        return SyntaxStyle.Text
    }

}

test {

    syntax_position :: fn (text: string, needle: string) -> usize {
        for position in [0.as(usize) .. text.count] {
            on position + needle.count <= text.count &&
                text[position..position + needle.count] == needle => return position
        }
        abort("Missing syntax test sample")
    }

    sample_lines :: fn (text: string) -> [..]usize {
        starts   : [..]usize
        preamble : usize     = 0

        on text.count >= 3 &&
            text[0] == 0xef &&
            text[1] == 0xbb &&
            text[2] == 0xbf => preamble = 3
        starts.push(preamble)
        for index, byte in text {
            on byte^ == '\n' => starts.push(index + 1)
        }
        return starts
    }

    analyse :: fn (cache: ^MarkdownSyntax, text: string, revision: u64) {
        starts := sample_lines(text)
        defer starts.free()
        _ := cache.update(text, starts[..], revision, 0, 0)
    }

    sample_style :: fn (cache    : ^MarkdownSyntax,
                        text     : string,
                        position : usize) -> SyntaxStyle {
        starts := sample_lines(text)
        defer starts.free()
        on position < starts[0] => return SyntaxStyle.Text
        line : usize = 0
        for line + 1 < starts.count && starts[line + 1] <= position {
            line += 1
        }
        return cache.line_style(line, position - starts[line])
    }

    span_count :: fn (cache: ^MarkdownSyntax) -> usize {
        count : usize = 0
        for line in cache.lines {
            count += line.spans.count
        }
        return count
    }

    assert_syntax_ranges :: fn (cache: ^MarkdownSyntax, text: string) {
        starts := sample_lines(text)
        defer starts.free()
        assert cache.lines.count == starts.count
        for index, line in cache.lines {
            end : usize = 0
            for span in line.spans {
                assert span.start >= end && span.end > span.start && span.end <= line.length
                start  := starts[index] + span.start
                finish := starts[index] + span.end

                assert text[start] < 128 || text[start] >= 192
                assert finish == text.count || text[finish] < 128 || text[finish] >= 192
                end = span.end
            }
        }
    }

}

test "Markdown source ranges cover block and inline syntax without changing Unicode or CRLF" {
    text                    := "﻿# Héading\r\nplain *émphasis* **strong** `界` [link](a(b)) ![image][ref]\r\n> - quote\r\n12. item\r\n\r\n---\r\n    indented\r\n"
    syntax : MarkdownSyntax

    defer syntax.release()
    analyse(^syntax, text, 1)
    assert sample_style(^syntax, text, 0) == SyntaxStyle.Text
    assert sample_style(^syntax, text, 3) == SyntaxStyle.Heading
    assert sample_style(^syntax, text, syntax_position(text, "plain")) == SyntaxStyle.Text
    assert sample_style(^syntax, text, syntax_position(text, "émphasis")) == SyntaxStyle.Emphasis
    assert sample_style(^syntax, text, syntax_position(text, "strong")) == SyntaxStyle.Strong
    assert sample_style(^syntax, text, syntax_position(text, "界")) == SyntaxStyle.Code
    assert sample_style(^syntax, text, syntax_position(text, "link")) == SyntaxStyle.Link
    assert sample_style(^syntax, text, syntax_position(text, "image")) == SyntaxStyle.Link
    assert sample_style(^syntax, text, syntax_position(text, ">")) == SyntaxStyle.Marker
    assert sample_style(^syntax, text, syntax_position(text, "- quote")) == SyntaxStyle.Marker
    assert sample_style(^syntax, text, syntax_position(text, "12.")) == SyntaxStyle.Marker
    assert sample_style(^syntax, text, syntax_position(text, "---")) == SyntaxStyle.Rule
    assert sample_style(^syntax, text, syntax_position(text, "indented")) == SyntaxStyle.Code
    assert sample_style(^syntax, text, text.count) == SyntaxStyle.Text
    assert_syntax_ranges(^syntax, text)
    analyse(^syntax, "\t# code\n  \tcode\n # heading", 2)
    assert syntax.line_style(0, 1) == SyntaxStyle.Code
    assert syntax.line_style(1, 2) == SyntaxStyle.Code
    assert syntax.line_style(2, 1) == SyntaxStyle.Heading
}

test "Markdown fence state crosses lines, respects delimiter size and quote boundaries, and refreshes on revision" {
    text :=
        """
        ````nerd
        # inside
        ```
        *still code*
        ````
        # outside
        > ~~~
        > code
        # after quote
        """
    syntax : MarkdownSyntax
    defer syntax.release()
    analyse(^syntax, text, 7)
    assert sample_style(^syntax, text, syntax_position(text, "# inside")) == SyntaxStyle.Code
    assert sample_style(^syntax, text, syntax_position(text, "*still")) == SyntaxStyle.Code
    assert sample_style(^syntax, text, syntax_position(text, "# outside")) == SyntaxStyle.Heading
    assert sample_style(^syntax, text, syntax_position(text, "> code")) == SyntaxStyle.Code
    assert sample_style(^syntax, text, syntax_position(text, "# after")) == SyntaxStyle.Heading
    assert_syntax_ranges(^syntax, text)
    spans := span_count(^syntax)
    analyse(^syntax, text, 7)
    assert syntax.revision == 7 && span_count(^syntax) == spans
    analyse(^syntax, """
        # now heading
        """, 8)
    assert sample_style(^syntax, text, 0) == SyntaxStyle.Heading && span_count(^syntax) == 1
    analyse(^syntax, text, 9)
    assert sample_style(^syntax, text, syntax_position(text, "# inside")) == SyntaxStyle.Code
}

test "Markdown setext headings and escaping leave malformed and intraword delimiters readable" {
    text                    := "Title *here*\r\n===\r\n\r\n\\*escaped* snake_case_word [broken](target `unclosed ``valid``\r\n####### nope\r\n"
    syntax : MarkdownSyntax

    defer syntax.release()
    analyse(^syntax, text, 1)
    assert sample_style(^syntax, text, 0) == SyntaxStyle.Heading
    assert sample_style(^syntax, text, syntax_position(text, "===")) == SyntaxStyle.Marker
    assert sample_style(^syntax, text, syntax_position(text, "escaped")) == SyntaxStyle.Text
    assert sample_style(^syntax, text, syntax_position(text, "case")) == SyntaxStyle.Text
    assert sample_style(^syntax, text, syntax_position(text, "broken")) == SyntaxStyle.Text
    assert sample_style(^syntax, text, syntax_position(text, "valid")) == SyntaxStyle.Code
    assert sample_style(^syntax, text, syntax_position(text, "#######")) == SyntaxStyle.Text
    assert_syntax_ranges(^syntax, text)
    -- Repeated unmatched links must stay bounded and never produce bad ranges.
    adversarial : [..]u8
    defer adversarial.free()
    for _index in [0 .. 4096] {
        adversarial.push('['.as(u8))
    }
    analyse(^syntax, adversarial[..].as(string), 2)
    assert span_count(^syntax) == 0
    analyse(^syntax, "", 3)
    assert span_count(^syntax) == 0 && sample_style(^syntax, text, 0) == SyntaxStyle.Text
}
