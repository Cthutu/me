test {

    exercise_panes :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        state : Workspace
        state.lock_fd = -1
        defer state.release()
        state.add_empty()
        on state.active_document().text.load("alpha\nbeta") {
            _success => {
            }

            _error! => return "Fixture load failed"!
        }
        state.active_view().interaction.selection.collapse(2)
        state.split_pane(SplitAxis.Columns)?
        right := state.surface.view_id
        assert right != 0 && state.active_view().document_id == 0
        state.active_view().interaction.selection.collapse(7)
        state.active_view().interaction.horizontal = 1
        state.focus_pane(Direction.Left)
        assert state.surface.view_id == 0 && state.active_view().interaction.selection.active == 2
        state.focus_pane(Direction.Right)
        assert state.surface.view_id == right && state.active_view().interaction.selection.active == 7
        assert make_directory(^scratch, "_tmp")
        path := scratch.pr($"_tmp/pane-test-{syscall(SYS_GETPID, 0, 0, 0, 0, 0, 0)}")
        own(^state.folder, "/pane-fixture")
        own(^state.session_path, path)
        state.persistent = yes
        defer {
            _ := syscall(SYS_UNLINK,
                         path.c_string().as(usize).as(u64),
                         0,
                         0,
                         0,
                         0,
                         0)
        }
        state.checkpoint(^scratch)?
        restored : Workspace
        restored.lock_fd = -1
        defer restored.release()
        own(^restored.folder, "/pane-fixture")
        own(^restored.session_path, path)
        restored.restore(^scratch)?
        assert restored.panes.nodes.count == 3 && restored.panes.nodes[0].vertical
        assert restored.surface.view_id == right && restored.active_view().interaction.selection.active == 7
        assert restored.active_view().interaction.horizontal == 1 && restored.active_view().previous_caret_line == 1
        -- A valid checksum must not allow two panes to mount the same view.
        damaged : [..]u8
        defer damaged.free()
        own(^damaged, read_file(^scratch, path)?)
        for byte in [0.as(usize) .. 8] {
            damaged[damaged.count - 16 + byte] = damaged[damaged.count - 32 + byte]
        }
        checksum : Encoder
        defer checksum.bytes.free()
        checksum.number(fingerprint(damaged[..damaged.count - 8].as(string)))
        damaged[damaged.count - 8..] = checksum.bytes[..]
        atomic_write(^scratch, path, bytes_text(damaged), yes)?
        invalid : Workspace
        invalid.lock_fd = -1
        defer invalid.release()
        own(^invalid.folder, "/pane-fixture")
        own(^invalid.session_path, path)
        on invalid.restore(^scratch) {
            _success => {
                assert no, "Duplicate pane view accepted"
            }

            _error! => {
            }
        }
        restored.close_pane()
        assert restored.documents.count == 1 && restored.active_document().modified()
        assert restored.active_view().interaction.selection.active == 2
        restored.split_pane(SplitAxis.Rows)?
        restored.add_empty()
        -- Buffer replacement affects only the mounted pane. Killing a shared
        -- buffer rebinds all its panes without collapsing the layout.
        assert restored.documents.count == 2
        restored.focus_pane(Direction.Up)
        restored.split_pane(SplitAxis.Columns)?
        restored.kill_document(0, yes)?
        assert restored.documents.count == 1
        mounted : usize = 0
        for node in restored.panes.nodes {
            on node.used &&
                !node.split => {
                assert node.view_id < restored.views.count
                assert restored.views[node.view_id].document_id == 0
                mounted += 1
                for other in restored.panes.nodes {
                    on other.used &&
                        !other.split &&
                        other != node => {
                        assert other.view_id != node.view_id
                    }
                }
            }
        }
        assert mounted == 3
    }

}

