use buffer
use codec
use document
use keyboard
use line_metadata
use markdown
use modes
use native
use nerd_syntax
use os.linux
use panes
use positions
use std.text
use syntax
use view

pub SaveTarget :: plex {
    path      string
    existing  ?Stat
    same_path bool
}

pub DocumentEntry :: plex {
    text              Document
    path              [..]u8
    disk              [..]u8
    disk_exists       bool
    missing           bool
    conflict          bool
    stamp             ?Stat
    candidate         ?Stat
    syntax            ?MarkdownSyntax
    nerd_syntax       ?NerdSyntax
    language_identity u64  -- Runtime-only provider identity; never persisted.
}

impl DocumentEntry {

    pub release :: fn (self: ^Self) {
        self.language_identity = 0
        self.text.release()
        self.release_syntax()
        self.path.free()
        self.disk.free()
    }

    pub release_syntax :: fn (self: ^Self) {
        on self.syntax {
            cache => cache.release()

            else => {
            }
        }
        on self.nerd_syntax {
            cache => cache.release()

            else => {
            }
        }
        self.syntax = nil
        self.nerd_syntax = nil
        self.text.line_changes = nil
    }

    -- This optional typed store is attached on demand. Plain Text never needs
    -- line rows; leaving a highlighted mode releases its metadata and observer.
    pub update_syntax :: fn (self: ^Self) -> usize {
        on self.file_mode() == FileMode.Nerd => {
            on self.syntax != nil => self.release_syntax()
            cache            := on self.nerd_syntax { current => current else => NerdSyntax { ... } }
            observed         := on self.text.line_changes { current => current else => LineChanges { ... } }
            prefix   : usize = 0
            suffix   : usize = 0

            on self.nerd_syntax != nil &&
                observed.base_revision == cache.revision &&
                observed.observed_revision == self.text.storage.revision() => {
                prefix = observed.prefix
                suffix = observed.suffix
            }
            analysed := cache.update(self.text.text(),
                                     self.text.lines[..],
                                     self.text.storage.revision(),
                                     prefix,
                                     suffix)
            observed.reset(self.text.storage.revision(), self.text.lines.count)
            self.text.line_changes = observed
            self.nerd_syntax = cache
            return analysed
        }
        on self.file_mode() != FileMode.Markdown => {
            self.release_syntax()
            return 0
        }
        on self.nerd_syntax != nil => self.release_syntax()
        cache            := on self.syntax { current => current else => MarkdownSyntax { ... } }
        observed         := on self.text.line_changes { current => current else => LineChanges { ... } }
        prefix   : usize = 0
        suffix   : usize = 0

        on self.syntax != nil &&
            observed.base_revision == cache.revision &&
            observed.observed_revision == self.text.storage.revision() => {
            prefix = observed.prefix
            suffix = observed.suffix
        }
        analysed := cache.update(self.text.text(),
                                 self.text.lines[..],
                                 self.text.storage.revision(),
                                 prefix,
                                 suffix)
        observed.reset(self.text.storage.revision(), self.text.lines.count)
        self.text.line_changes = observed
        self.syntax = cache
        return analysed
    }

    pub syntax_style :: fn (self   : ^Self,
                            line   : usize,
                            offset : usize) -> SyntaxStyle {
        on self.nerd_syntax {
            cache => return cache.line_style(line, offset)

            else => {
            }
        }
        return on self.syntax {
            cache  => cache.line_style(line, offset)
            else   => SyntaxStyle.Text
        }
    }

    pub file_mode :: fn (self: ^Self) -> FileMode {
        return recognise_mode(bytes_text(self.path))
    }

    pub modified :: fn (self: ^Self) -> bool {
        on self.path.count == 0 => return self.text.text().count > 0
        return !self.disk_exists || self.missing || self.text.text() != bytes_text(self.disk)
    }

    pub line_ending :: fn (self: ^Self, line: usize) -> string {
        doc := ^self.text
        -- Prefer an existing local ending, otherwise the file's majority.
        on line + 1 < doc.lines.count => {
            end := doc.line_start(line + 1) - 1
            return on end > 0 && doc.content[end - 1] == '\r' {
                yes   => "\r\n"
                else  => "\n"
            }
        }
        return on doc.crlf_count > doc.lf_count { yes => "\r\n" else => "\n" }
    }

}

-- Numeric IDs keep buffer and view ownership independent. Each pane mounts a
-- distinct view; surface tracks the focused view for command dispatch.
pub TextView :: plex {
    document_id         usize
    interaction         View
    keyboard            Keyboard
    previous_caret_line usize
}

pub Surface :: plex {
    view_id usize
}

pub Workspace :: plex {
    documents         [..]DocumentEntry
    views             [..]TextView
    access_order      [..]usize
    surface           Surface
    panes             PaneLayout
    folder            [..]u8
    session_path      [..]u8
    lock_fd           i32
    persistent        bool
    checkpoint_failed bool
}

same_stamp :: fn (left: Stat, right: Stat) -> bool {
    return same_file_state(left, right)
}

pub absolute_path :: fn (scratch : ^arena,
                         folder  : string,
                         path    : string) -> string {
    -- Lexically collapsing ".." can select the wrong file when a preceding
    -- component is a symlink (or does not exist). Leave resolution to Linux.
    return on path.count > 0 && path[0] == '/' {
        yes   => path
        else  => scratch.pr($"{folder}/{path}")
    }
}

impl Workspace {

    pub release_documents :: fn (self: ^Self) {
        for document in self.documents {
            document.release()
        }
        self.documents.free()
        self.views.free()
        self.access_order.free()
        self.panes.nodes.free()
        self.panes.focused = 0
        self.panes.compact = no
    }

    pub release :: fn (self: ^Self) {
        self.release_documents()
        self.folder.free()
        self.session_path.free()
        on self.lock_fd >= 0 => {
            _ := sys_close(self.lock_fd)
        }
        self.lock_fd = -1
    }

    pub record_access :: fn (self: ^Self) {
        on self.access_order.count + 1 == self.documents.count {
            yes => self.access_order.push(self.documents.count - 1)

            else => on self.access_order.count != self.documents.count => {
                for id in [0 .. self.documents.count] {
                    found := no
                    for known in self.access_order {
                        on known^ == id => found = yes
                    }
                    on !found => self.access_order.push(id)
                }
            }
        }
        on self.views.count == 0 => return
        id            := self.active_view().document_id
        index : usize = 0

        for index < self.access_order.count &&
            self.access_order[index] != id {
            index += 1
        }
        on index == self.access_order.count => return
        for index > 0 {
            self.access_order[index] = self.access_order[index - 1]
            index -= 1
        }
        self.access_order[0] = id
    }

    copy_view :: fn (self: ^Self, original: TextView) -> usize {
        copy := original
        copy.keyboard = Keyboard { ... }
        for id, existing in self.views {
            on id != self.surface.view_id &&
                existing.document_id == copy.document_id &&
                !self.panes.mounted(id) => {
                existing^ = copy
                return id
            }
        }
        self.views.push(copy)
        return self.views.count - 1
    }

    pub focus_view :: fn (self: ^Self, id: usize) {
        selected := id
        on self.panes.nodes.count > 0 => {
            on self.panes.nodes[self.panes.focused].view_id != id &&
                self.panes.mounted(id) => {
                copy := self.views[id]

                selected = self.copy_view(copy)
            }
            self.panes.nodes[self.panes.focused].view_id = selected
        }
        self.surface.view_id = selected
        self.record_access()
    }

    pub focus_document :: fn (self: ^Self, id: usize) -> bool {
        on self.surface.view_id < self.views.count &&
            self.active_view().document_id == id => {
            self.record_access()
            return yes
        }
        for index, text_view in self.views {
            on text_view.document_id == id &&
                !self.panes.mounted(index) => {
                self.focus_view(index)
                return yes
            }
        }
        for index, text_view in self.views {
            on text_view.document_id == id => {
                self.focus_view(index)
                return yes
            }
        }
        return no
    }

    pub split_pane :: fn (self: ^Self, axis: SplitAxis) -> void\string {
        self.split_view(axis, self.surface.view_id)?
    }

    pub split_view :: fn (self    : ^Self,
                          axis    : SplitAxis,
                          view_id : usize) -> void\string {
        self.panes.ensure(self.surface.view_id)
        on !self.panes.can_split(axis) => return "Not enough room to split "
            +"this pane"!
        id := view_id
        on self.panes.mounted(id) => id = self.copy_view(self.views[id])
        self.panes.divide(axis, id)
        self.surface.view_id = id
        self.record_access()
    }

    pub close_pane :: fn (self: ^Self) {
        self.panes.ensure(self.surface.view_id)
        on self.panes.close() => {
            self.surface.view_id = self.panes.nodes[self.panes.focused].view_id
            self.record_access()
        }
    }

    pub focus_pane :: fn (self: ^Self, direction: Direction) {
        self.panes.ensure(self.surface.view_id)
        self.panes.focused = self.panes.neighbour(direction)
        self.surface.view_id = self.panes.nodes[self.panes.focused].view_id
        self.record_access()
    }

    pub active_view :: fn (self: ^Self) => ^self.views[self.surface.view_id]

    pub active_document :: fn (self: ^Self) => ^self.documents[self.active_view().document_id]

    pub add_empty :: fn (self: ^Self) {
        entry : DocumentEntry
        on entry.text.load("") {
            _success => {
            }

            _error! => abort("Internal error: empty document")
        }
        self.documents.push(entry)
        text_view : TextView
        text_view.document_id = self.documents.count - 1
        text_view.interaction.state = Interaction.Insert
        text_view.interaction.reveal = yes
        self.views.push(text_view)
        self.focus_view(self.views.count - 1)
    }

    pub open_file :: fn (self    : ^Self,
                         scratch : ^arena,
                         path    : string) -> void\string {
        absolute   := absolute_path(scratch, bytes_text(self.folder), expand_home_path(scratch, path)?)
        info       := metadata(scratch, absolute)
        info_error := last_error()

        for index, entry in self.documents {
            same_file := bytes_text(entry.path) == absolute
            on info => [current] {
                previous := entry.stamp
                on previous == nil &&
                    entry.path.count > 0 => previous = metadata(scratch,
                                                                bytes_text(entry.path))
                on previous => [known] {
                    on current.dev == known.dev &&
                        current.ino == known.ino => same_file = yes
                }
            }
            on same_file && self.focus_document(index) => return
        }
        entry       : DocumentEntry
        transferred                 := no

        defer on !transferred => entry.release()
        own(^entry.path, absolute)
        text := ""
        on info {
            current => {
                on (current.mode & 0xf000) != 0x8000 => return "Cannot open a "
                    +"non-regular file"!
                text = read_file(scratch, absolute)?
                entry.disk_exists = yes
                entry.stamp = current
                own(^entry.disk, text)
            }

            else => {
                on info_error != ENOENT => return "Cannot inspect requested "
                    +"file"!
            }
        }
        on entry.text.load(text) {
            _success => {
            }

            _error! => return "File is not valid UTF-8"!
        }
        self.documents.push(entry)
        transferred = yes
        text_view : TextView
        text_view.document_id = self.documents.count - 1
        text_view.interaction.selection.collapse(entry.text.line_start(0))
        text_view.interaction.state = on text.count == entry.text.line_start(0) {
            yes   => Interaction.Insert
            else  => Interaction.Normal
        }
        text_view.interaction.reveal = yes
        self.views.push(text_view)
        self.focus_view(self.views.count - 1)
    }

    pub initialise :: fn (self    : ^Self,
                          scratch : ^arena,
                          reset   : bool) -> void\string {
        self.lock_fd = -1
        own(^self.folder, cwd(scratch)?)
        home := environment(scratch, "HOME")
        on home.count == 0 => {
            self.checkpoint_failed = yes
            return "HOME is unset; continuation disabled"!
        }
        config  := scratch.pr($"{home}/.config")
        root    := scratch.pr($"{config}/me")
        session := scratch.pr($"{root}/{fingerprint(bytes_text(self.folder))}")

        on !make_directory(scratch, config) ||
            !make_directory(scratch, root) ||
            !make_directory(scratch, session) => {
            self.checkpoint_failed = yes
            return "Cannot create private continuation folder"!
        }
        lock_path := scratch.pr($"{session}/lock")
        fd        := sys_open(lock_path.c_string(), O_RDWR | O_CREAT, 0x180)

        on fd < 0 => {
            self.checkpoint_failed = yes
            return "Cannot open continuation lock"!
        }
        on syscall(SYS_FLOCK, fd.as(u64), 6, 0, 0, 0, 0).as(i64) < 0 => {
            _ := sys_close(fd)
            return "Another ME owns this folder's continuation. This session "
                +"starts fresh and will not read or write snapshots. Save files "
                +"before :q, or use :q! to discard unsaved buffers."!
        }
        self.lock_fd = fd
        self.persistent = yes
        own(^self.session_path, scratch.pr($"{session}/snapshot"))
        on reset => {
            removed := syscall(SYS_UNLINK, scratch.pr($"{bytes_text(self.session_path)}\0").data.as(usize).as(u64), 0, 0, 0, 0, 0).as(i64)
            on removed < 0 &&
                last_error() != ENOENT => {
                self.persistent = no
                self.checkpoint_failed = yes
                return "Cannot erase the previous continuation snapshot"!
            }
        }
        on !reset &&
            metadata(scratch, bytes_text(self.session_path)) != nil => {
            on self.restore(scratch) {
                _success => {
                }

                error! => {
                    self.release_documents()
                    self.persistent = no
                    self.checkpoint_failed = yes
                    return error!
                }
            }
        }
    }

    pub checkpoint :: fn (self: ^Self, scratch: ^arena) -> void\string {
        on !self.persistent => return "Continuation is unavailable"!
        encoded : Encoder
        defer encoded.bytes.free()
        self.record_access()
        encoded.text("ME/MS1/4")
        encoded.text(bytes_text(self.folder))
        encoded.number(self.documents.count.as(u64))
        for entry in self.documents {
            encoded.text(bytes_text(entry.path))
            encoded.text(bytes_text(entry.disk))
            encoded.number(on entry.disk_exists {
                yes   => 1
                else  => 0
            })
            encoded.number(on entry.missing {
                yes   => 1
                else  => 0
            })
            encoded.document(^entry.text)
        }
        encoded.number(self.views.count.as(u64))
        for text_view in self.views {
            view := ^text_view.interaction
            encoded.number(text_view.document_id.as(u64))
            encoded.number(view.selection.anchor.as(u64))
            encoded.number(view.selection.active.as(u64))
            encoded.number(view.preferred.as(u64))
            doc := ^self.documents[text_view.document_id].text
            top := on view.top < doc.lines.count {
                yes   => view.top
                else  => doc.lines.count - 1
            }

            encoded.number(top.as(u64))
            encoded.number(view.horizontal.as(u64))
            encoded.number(on view.state == Interaction.Insert {
                yes   => 1
                else  => 0
            })
            encoded.number(on view.linewise {
                yes   => 1
                else  => 0
            })
        }
        encoded.number(self.surface.view_id.as(u64))
        encoded.number(self.access_order.count.as(u64))
        for id in self.access_order {
            encoded.number(id^.as(u64))
        }
        self.panes.ensure(self.surface.view_id)
        self.encode_pane(^encoded, 0)
        encoded.number(fingerprint(bytes_text(encoded.bytes)))
        on atomic_write(scratch, bytes_text(self.session_path), bytes_text(encoded.bytes), yes) {
            _success => {
                self.checkpoint_failed = no
            }

            error! => {
                self.checkpoint_failed = yes
                return error!
            }
        }
    }

    encode_pane :: fn (self: ^Self, encoded: ^Encoder, id: usize) {
        node := self.panes.nodes[id]
        encoded.number(on node.split {
            yes => on node.vertical { yes => 2 else => 1 }

            else => 0
        })
        on node.split {
            yes => {
                self.encode_pane(encoded, node.first)
                self.encode_pane(encoded, node.second)
            }

            else => encoded.number(node.view_id.as(u64))
        }
    }

    decode_pane :: fn (self   : ^Self,
                       reader : ^Decoder,
                       parent : usize,
                       depth  : usize) -> usize\string {
        on depth > 15 ||
            self.panes.nodes.count >= 31 => return "Invalid continuation pane "
            +"tree"!
        kind := reader.number()?
        on kind > 2 => return "Invalid continuation pane kind"!
        id := self.panes.nodes.count
        self.panes.nodes.push(PaneNode { used: yes parent split: kind != 0 vertical: kind == 2 ... })
        on kind == 0 {
            yes => {
                view_id := reader.number()?.as(usize)
                on view_id >= self.views.count => return "Invalid continuation "
                    +"pane view"!
                for index in [0 .. id] {
                    node := self.panes.nodes[index]
                    on !node.split &&
                        node.view_id == view_id => return "Duplicate "
                        +"continuation pane view"!
                }
                self.panes.nodes[id].view_id = view_id
                on view_id == self.surface.view_id => self.panes.focused = id
            }

            else => {
                first  := self.decode_pane(reader, id, depth + 1)?
                second := self.decode_pane(reader, id, depth + 1)?

                self.panes.nodes[id].first = first
                self.panes.nodes[id].second = second
            }
        }
        return id
    }

    pub restore :: fn (self: ^Self, scratch: ^arena) -> void\string {
        bytes := read_file(scratch, bytes_text(self.session_path))?
        on bytes.count < 8 => return "Truncated continuation; original "
            +"snapshot retained"!
        check := Decoder { bytes offset: bytes.count - 8 }
        on check.number()? != fingerprint(bytes[..bytes.count - 8]) => return "Continuation checksum failed; original snapshot retained"!
        reader  := Decoder { bytes: bytes[..bytes.count - 8] offset: 0 }
        version := reader.text()?

        on (version != "ME/MS1/1" && version != "ME/MS1/2" && version != "ME/MS"
            +"1/3" && version != "ME/MS1/4") ||
            reader.text()? != bytes_text(self.folder) => return "Continuation "
            +"version or folder mismatch"!
        documents := reader.number()?
        on documents > ((reader.bytes.count - reader.offset) / 56).as(u64) => return "Invalid continuation document count"!
        for _ in [0 .. documents] {
            entry       : DocumentEntry
            transferred                 := no

            defer on !transferred => entry.release()
            own(^entry.path, reader.text()?)
            own(^entry.disk, reader.text()?)
            entry.disk_exists = reader.number()? != 0
            entry.missing = reader.number()? != 0
            reader.document(^entry.text, legacy = version == "ME/MS1/1")?
            -- Force content verification after restart: the disk may have
            -- changed while ME was not running.
            entry.stamp = nil
            self.documents.push(entry)
            transferred = yes
        }
        views := reader.number()?
        on views > ((reader.bytes.count - reader.offset) / 64).as(u64) => return "Invalid continuation view count"!
        for _ in [0 .. views] {
            text_view : TextView
            text_view.document_id = reader.number()?.as(usize)
            on text_view.document_id >= self.documents.count => return "Invalid"
                +" continuation view document"!
            doc  := ^self.documents[text_view.document_id].text
            view := ^text_view.interaction

            view.selection.anchor = reader.number()?.as(usize)
            view.selection.active = reader.number()?.as(usize)
            view.preferred = reader.number()?.as(usize)
            view.top = reader.number()?.as(usize)
            view.horizontal = reader.number()?.as(usize)
            view.state = on reader.number()? != 0 {
                yes   => Interaction.Insert
                else  => Interaction.Normal
            }
            view.linewise = reader.number()? != 0
            on view.selection.anchor > doc.text().count ||
                view.selection.active > doc.text().count ||
                view.top >= doc.lines.count => return "Invalid continuation "
                +"view positions"!
            on (view.selection.anchor < doc.text().count && (doc.content[view.selection.anchor] & 0xc0) == 0x80) ||
                (view.selection.active < doc.text().count && (doc.content[view.selection.active] & 0xc0) == 0x80) => return "Invalid continuation character boundary"!
            on view.selection.anchor < doc.line_start(0) ||
                view.selection.active < doc.line_start(0) => view.repair(doc)
            -- Retain positions/scroll, not a stale typing state: the startup
            -- rule is Insert only for empty content, Normal otherwise.
            view.state = on doc.text().count == doc.line_start(0) {
                yes   => Interaction.Insert
                else  => Interaction.Normal
            }
            -- Restored horizontal scrolling must not look like a fresh line
            -- change on the first paint of each independently mounted view.
            text_view.previous_caret_line = doc.line_at(view.selection.active)
            self.views.push(text_view)
        }
        self.surface.view_id = reader.number()?.as(usize)
        on self.surface.view_id >= self.views.count => return "Invalid "
            +"continuation layout"!
        on version == "ME/MS1/3" || version == "ME/MS1/4" {
            yes => {
                count := reader.number()?.as(usize)
                on count != self.documents.count => return "Invalid "
                    +"continuation access order"!
                seen := scratch.alloc_bytes(count)
                for byte in seen {
                    byte^ = 0
                }
                for _ in [0 .. count] {
                    id := reader.number()?.as(usize)
                    on id >= count ||
                        seen[id] != 0 => return "Invalid "
                        +"continuation access "
                        +"order"!
                    seen[id] = 1
                    self.access_order.push(id)
                }
                on self.access_order[0] != self.active_view().document_id => return "Invalid continuation active access"!
            }

            else => self.record_access()
        }
        on version == "ME/MS1/4" {
            yes => {
                _ := self.decode_pane(^reader, 0, 0)?
                on self.panes.nodes[self.panes.focused].split ||
                    self.panes.nodes[self.panes.focused].view_id != self.surface.view_id => return "Invalid continuation focused pane"!
                self.panes.arrange(80, 23)
            }

            else => self.panes.ensure(self.surface.view_id)
        }
        on reader.offset != reader.bytes.count => return "Invalid continuation "
            +"layout"!
    }

    pub save_target :: fn (self        : ^Self,
                           scratch     : ^arena,
                           document_id : usize,
                           filename    : string) -> SaveTarget\string {
        entry := ^self.documents[document_id]
        path := on filename.count > 0 {
            yes   => absolute_path(scratch, bytes_text(self.folder), expand_home_path(scratch, filename)?)
            else  => bytes_text(entry.path)
        }
        on path.count == 0 => return "A filename is required"!
        existing  := metadata(scratch, path)
        same_path := path == bytes_text(entry.path)

        on existing => [current] {
            on !same_path &&
                entry.path.count > 0 => {
                on metadata(scratch, bytes_text(entry.path)) => [backing] {
                    same_path = backing.dev == current.dev && backing.ino == current.ino
                }
            }
        }
        return SaveTarget { path existing same_path }
    }

    pub save :: fn (self           : ^Self,
                    scratch        : ^arena,
                    document_id    : usize,
                    filename       : string,
                    force_write    : bool,
                    force_conflict : bool,
                    approved_state : ?Stat = nil,
                    approved_text  : ?string = nil) -> void\string {
        entry       := ^self.documents[document_id]
        target      := self.save_target(scratch, document_id, filename)?
        path        := target.path
        existing    := target.existing
        same_path   := target.same_path
        reassociate := filename.count > 0

        on existing != nil => {
            on !same_path &&
                !force_conflict => return "Different target "
                +"exists; use :w! "
                +"filename"!
            on !force_conflict &&
                same_path => {
                current := read_file(scratch, path)?
                on current != bytes_text(entry.disk) ||
                    !entry.disk_exists => {
                    entry.conflict = yes
                    return "File changed externally; use :w! to overwrite"!
                }
            }
        }
        on !reassociate &&
            !force_write &&
            !entry.modified() &&
            existing != nil => return
        expected : ?string = nil
        on same_path &&
            existing != nil &&
            !force_conflict => expected = bytes_text(entry.disk)
        on approved_text => [text] {
            expected = text
        }
        atomic_write(scratch, path, entry.text.text(), existing != nil && (same_path || force_conflict), expected_text = expected, expected_state = approved_state)?
        -- Path and baseline only advance after a successful durable write.
        on reassociate => {
            own(^entry.path, path)
            on entry.file_mode() == FileMode.PlainText => entry.release_syntax()
        }
        own(^entry.disk, entry.text.text())
        entry.disk_exists = yes
        entry.missing = no
        entry.conflict = no
        entry.stamp = metadata(scratch, bytes_text(entry.path))
    }

    pub poll_files :: fn (self: ^Self, scratch: ^arena) -> void\string {
        for id, entry in self.documents {
            on entry.path.count == 0 => again
            current := metadata(scratch, bytes_text(entry.path))
            on current {
                info => {
                    changed := entry.missing
                    on entry.stamp {
                        previous => {
                            on !same_stamp(previous, info) => changed = yes
                        }

                        else => changed = yes
                    }
                    on !changed => again
                    -- Two matching samples avoid most partial-write reloads.
                    stable := no
                    on entry.candidate {
                        previous => stable = same_stamp(previous, info)

                        else => {
                        }
                    }
                    entry.candidate = info
                    on !stable => again
                    bytes := read_file(scratch, bytes_text(entry.path))?
                    on bytes == bytes_text(entry.disk) &&
                        entry.disk_exists => {
                        entry.missing = no
                        entry.conflict = no
                        entry.stamp = info
                        again
                    }
                    on entry.text.text() != bytes_text(entry.disk) => {
                        entry.conflict = yes
                        entry.stamp = info
                        again
                    }
                    on entry.text.edit({ start: 0 end: entry.text.text().count }, bytes) {
                        change => {
                            for text_view in self.views {
                                on text_view.document_id == id => {
                                    text_view.interaction.selection.adjust(change)
                                    text_view.interaction.repair(^entry.text)
                                }
                            }
                        }

                        _error! => return "External file is no longer valid "
                            +"UTF-8; content retained"!
                    }
                    own(^entry.disk, bytes)
                    entry.disk_exists = yes
                    entry.missing = no
                    entry.conflict = no
                    entry.stamp = info
                }

                else => {
                    on last_error() == ENOENT {
                        yes => entry.missing = yes

                        else => return "Cannot inspect backing file; content "
                            +"retained"!
                    }
                }
            }
        }
    }

    -- Kill is a workspace operation, never a text undo operation.
    pub kill_document :: fn (self        : ^Self,
                             document_id : usize,
                             force       : bool) -> void\string {
        on document_id >= self.documents.count => return "No such buffer"!
        on !force &&
            self.documents[document_id].modified() => return "Buffer "
            +"has "
            +"unsaved work; use :kill! to discard it"!
        self.record_access()
        fallback : ?usize = nil
        on self.active_view().document_id == document_id => {
            for id in self.access_order {
                on id^ != document_id && fallback == nil => fallback = id^
            }
        }
        kept : usize = 0
        for id in self.access_order {
            on id^ != document_id => {
                self.access_order[kept] = on id^ > document_id {
                    yes   => id^ - 1
                    else  => id^
                }
                kept += 1
            }
        }
        self.access_order.resize_undefined_to(kept)
        active         := self.surface.view_id
        index  : usize = 0

        for index < self.views.count {
            on self.views[index].document_id != document_id {
                yes => index += 1

                else => {
                    for next in [index + 1 .. self.views.count] {
                        self.views[next - 1] = self.views[next]
                    }
                    _ := self.views.pop()
                    for node in self.panes.nodes {
                        on node.used &&
                            !node.split => {
                            on node.view_id == index {
                                yes => node.view_id = 0xffffffffffffffff.as(usize)

                                else => on node.view_id > index &&
                                    node.view_id != 0xffffffffffffffff.as(usize) => node.view_id -= 1
                            }
                        }
                    }
                    on index < active => active -= 1
                }
            }
        }
        self.documents[document_id].release()
        for next in [document_id + 1 .. self.documents.count] {
            self.documents[next - 1] = self.documents[next]
        }
        _ := self.documents.pop()
        for text_view in self.views {
            on text_view.document_id > document_id => text_view.document_id -= 1
        }
        on self.views.count == 0 => self.add_empty()
        -- Every pane showing a killed buffer receives its own surviving view.
        for node in self.panes.nodes {
            on node.used &&
                !node.split &&
                node.view_id >= self.views.count => {
                copy := self.views[0]
                self.views.push(copy)
                node.view_id = self.views.count - 1
            }
        }
        on self.panes.nodes.count > 0 => self.surface.view_id = self.panes.nodes[self.panes.focused].view_id
        on fallback => [id] {
            adjusted := on id > document_id {
                yes   => id - 1
                else  => id
            }
            on self.focus_document(adjusted) => return
        }
        self.focus_view(on active < self.views.count {
            yes   => active
            else  => self.views.count - 1
        })
    }

    pub abandon :: fn (self: ^Self) -> void\string {
        index : usize = 0
        for index < self.documents.count {
            on self.documents[index].modified() {
                yes   => self.kill_document(index, yes)?
                else  => index += 1
            }
        }
    }

}

test {

    exercise_access_order :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        state : Workspace
        state.lock_fd = -1
        defer state.release()
        for path in ["/A", "/B", "/C"] {
            state.add_empty()
            own(^state.active_document().path, path^)
            state.active_document().disk_exists = yes
        }
        assert state.focus_document(0)
        assert state.focus_document(1)
        assert state.access_order[0] == 1 && state.access_order[1] == 0 && state.access_order[2] == 2
        assert make_directory(^scratch, "_tmp")
        snapshot := scratch.pr($"_tmp/mru-test-{syscall(SYS_GETPID, 0, 0, 0, 0, 0, 0)}")
        own(^state.folder, "/mru-fixture")
        own(^state.session_path, snapshot)
        state.persistent = yes
        state.checkpoint(^scratch)?
        defer {
            _ := syscall(SYS_UNLINK,
                         snapshot.c_string().as(usize).as(u64),
                         0,
                         0,
                         0,
                         0,
                         0)
        }
        restored : Workspace
        restored.lock_fd = -1
        defer restored.release()
        own(^restored.folder, "/mru-fixture")
        own(^restored.session_path, snapshot)
        restored.restore(^scratch)?
        assert restored.active_view().document_id == 1
        assert restored.access_order[0] == 1 && restored.access_order[1] == 0 && restored.access_order[2] == 2
        assert restored.focus_document(2)
        restored.kill_document(2, no)?
        assert bytes_text(restored.active_document().path) == "/B"
        assert restored.access_order.count == 2 && restored.access_order[0] == 1
        restored.kill_document(0, no)?
        assert bytes_text(restored.active_document().path) == "/B" && restored.access_order[0] == 0

        damaged : [..]u8
        defer damaged.free()
        own(^damaged, read_file(^scratch, snapshot)?)
        ids := damaged.count - 8 - 16 - 3 * 8
        for i in [0.as(usize) .. 8] {
            damaged[ids + 8 + i] = damaged[ids + i]
        }
        checksum : Encoder
        defer checksum.bytes.free()
        checksum.number(fingerprint(damaged[..damaged.count - 8].as(string)))
        damaged[damaged.count - 8..] = checksum.bytes[..]
        atomic_write(^scratch, snapshot, bytes_text(damaged), yes)?
        invalid : Workspace
        invalid.lock_fd = -1
        defer invalid.release()
        own(^invalid.folder, "/mru-fixture")
        own(^invalid.session_path, snapshot)
        on invalid.restore(^scratch) {
            _success => {
                assert no, "Duplicate access IDs accepted"
            }

            _error! => {
            }
        }
    }

    exercise_kill :: fn () -> void\string {
        workspace : Workspace
        workspace.lock_fd = -1
        defer workspace.release()
        workspace.add_empty()
        own(^workspace.documents[0].path, "/saved-a")
        workspace.documents[0].disk_exists = yes
        workspace.add_empty()
        on workspace.active_document().text.edit({ start: 0 end: 0 }, "discard") {
            _change => {
            }

            _error! => return "Fixture failed"!
        }
        workspace.add_empty()
        own(^workspace.documents[2].path, "/saved-c")
        workspace.documents[2].disk_exists = yes
        other : TextView
        other.document_id = 1
        workspace.views.push(other)
        on workspace.kill_document(1, no) {
            _success => {
                assert no
            }

            _refused! => {
            }
        }
        assert workspace.documents.count == 3 && workspace.views.count == 4
        workspace.kill_document(1, yes)?
        assert workspace.documents.count == 2 && workspace.views.count == 2
        assert bytes_text(workspace.documents[0].path) == "/saved-a"
        assert bytes_text(workspace.documents[1].path) == "/saved-c"
        assert workspace.surface.view_id == 1
        assert workspace.active_view().document_id == 1
        workspace.kill_document(0, no)?
        assert workspace.surface.view_id == 0
        assert bytes_text(workspace.active_document().path) == "/saved-c"
        workspace.kill_document(0, no)?
        assert workspace.documents.count == 1 && workspace.views.count == 1
        assert workspace.active_document().path.count == 0
        assert workspace.active_document().text.history.count == 0
        assert !workspace.active_document().modified()
    }

    exercise_workspace :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        folder := scratch.pr($"_tmp/workspace-test-{syscall(SYS_GETPID, 0, 0, 0, 0, 0, 0)}")
        assert make_directory(^scratch, "_tmp")
        assert make_directory(^scratch, folder)
        path                 := scratch.pr($"{folder}/snapshot")
        original : Workspace

        original.lock_fd = -1
        defer original.release()
        own(^original.folder, "/test-folder")
        own(^original.session_path, path)
        original.persistent = yes
        original.add_empty()
        entry := original.active_document()
        on entry.text.edit({ start: 0 end: 0 }, "recovered\r\ntext") {
            _change => {
            }

            _error! => return "edit"!
        }
        original.active_view().interaction.place(^entry.text, 3, no)
        -- A checkpoint may run before presentation has clamped a viewport after
        -- deletion. Serialise a valid top line without discarding the document.
        original.active_view().interaction.top = 10000
        original.checkpoint(^scratch)?
        recovered : Workspace
        recovered.lock_fd = -1
        defer recovered.release()
        own(^recovered.folder, "/test-folder")
        own(^recovered.session_path, path)
        recovered.restore(^scratch)?
        assert recovered.active_document().text.text() == "recovered\r\ntext"
        assert recovered.active_view().interaction.selection.active == 3
        assert recovered.active_view().interaction.top == 1
        assert recovered.active_view().interaction.state == Interaction.Normal
        assert recovered.active_document().text.history.count == 1
        on recovered.active_document().text.edit({ start: 0 end: 0 }, "later ") {
            _change => {
            }

            _error! => return "edit"!
        }
        recovered.add_empty()
        on recovered.active_document().text.edit({ start: 0 end: 0 }, "new "
    +"never "
    +"saved") {
            _change => {
            }

            _error! => return "edit"!
        }
        recovered.abandon()?
        assert recovered.documents.count == 1 && recovered.views.count == 1
        assert recovered.active_document().text.text() == ""
        assert recovered.active_document().text.history.count == 0
        assert !recovered.active_document().modified()
        _ := syscall(SYS_UNLINK, path.c_string().as(usize).as(u64), 0, 0, 0, 0, 0)
        _ := syscall(SYS_RMDIR, folder.c_string().as(usize).as(u64), 0, 0, 0, 0, 0)
    }

}

