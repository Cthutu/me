        _success => {
        }

        error! => {
            assert no, error
        }
    }
}

test {

    assert_incremental_analysis :: fn (entry: ^DocumentEntry) -> usize {
        analysed                   := entry.update_syntax()
        reference : MarkdownSyntax

        defer reference.release()
        _ := reference.update(entry.text.text(),
                              entry.text.lines[..],
                              entry.text.storage.revision(),
                              0,
                              0)
        on entry.syntax {
            cache => {
                assert cache.lines.count == reference.lines.count
                for index, actual in cache.lines {
                    expected := ^reference.lines[index]
                    assert actual.input == expected.input && actual.output == expected.output
                    assert actual.setext == expected.setext && actual.length == expected.length
                    assert actual.spans.count == expected.spans.count
                    for span_index, span in actual.spans {
                        assert span^ == expected.spans[span_index]
                    }
                    for offset in [0.as(usize) .. actual.length + 1] {
                        assert cache.line_style(index, offset) == reference.line_style(index, offset)
                    }
                }
            }

            else => {
                assert no
            }
        }
        return analysed
    }

    exercise_incremental_analysis :: fn () -> void\EditError {
        entry : DocumentEntry
        defer entry.release()
        entry.text.load("""
            plain
            """)?
        assert entry.syntax == nil && entry.text.line_changes == nil
        assert entry.update_syntax() == 0
        assert entry.syntax == nil && entry.text.line_changes == nil
        own(^entry.path, "/notes.md")
        entry.text.load("Title\n===\n\nend")?
        _ := assert_incremental_analysis(^entry)
        assert entry.syntax_style(0, 0) == SyntaxStyle.Heading
        _ := entry.text.edit({ start: 6 end: 9 }, "")?
        _ := assert_incremental_analysis(^entry)

        assert entry.syntax_style(0, 0) == SyntaxStyle.Text
        _ := entry.text.undo_edit()
        _ := assert_incremental_analysis(^entry)

        assert entry.syntax_style(0, 0) == SyntaxStyle.Heading
        source : [..]u8
        defer source.free()
        for _line in [0 .. 200] {
            for byte in """
    ordinary *text*
    """ {
                source.push(byte^)
            }
        }
        entry.text.load(source[..].as(string))?
        assert assert_incremental_analysis(^entry) == 201
        assert entry.update_syntax() == 0
        gap      := entry.text.storage.gap_start
        revision := entry.text.storage.revision()

        assert entry.update_syntax() == 0
        assert entry.text.storage.gap_start == gap && entry.text.storage.revision() == revision
        middle := entry.text.line_start(100)
        _      := entry.text.edit({ start: middle end: middle + 1 }, "O")?

        assert assert_incremental_analysis(^entry) == 2
        -- A fence changes the state of the whole remaining suffix.
        _ := entry.text.edit({ start: middle end: middle }, """
            ```
            """)?
        assert assert_incremental_analysis(^entry) > 50
        _ := entry.text.undo_edit()
        assert assert_incremental_analysis(^entry) > 50
        _ := entry.text.redo_edit()
        _ := assert_incremental_analysis(^entry)
        -- Whole replacements invalidate safely, even while metadata is attached.
        entry.text.load("﻿Title *é*\r\n===\r\n\r\n> ```\n> code\nplain\n")?
        _ := assert_incremental_analysis(^entry)
        -- Deterministic edits, batched between analyses, include line splits,
        -- joins, fences, BOM boundaries, CRLF, Unicode, undo and redo.
        seed : usize = 7
        for step in [0 .. 240] {
            seed = (seed * 251 + 17) % 65521
            minimum := entry.text.line_start(0)
            start   := minimum + seed % (entry.text.text().count - minimum + 1)

            for start > minimum &&
                start < entry.text.text().count &&
                (entry.text.content[start] & 0xc0) == 0x80 {
                start -= 1
            }
            end := start + seed % 7
            on end > entry.text.text().count => end = entry.text.text().count
            for end > start &&
                end < entry.text.text().count &&
                (entry.text.content[end] & 0xc0) == 0x80 {
                end -= 1
            }
            replacements := [
                "x",
                "",
                "\n",
                "\r\n",
                """
                    ```
                    """,
                """
                    > ~~~
                    """,
                "*é*",
                """
                    ===
                    """,
                """
                    # title
                    """,
                "\t",
            ]
            replacement := replacements[seed % 10]
            _           := entry.text.edit({ start end }, replacement)?

            on step % 5 == 4 => {
                _ := assert_incremental_analysis(^entry)
            }
            on step % 11 == 10 => {
                _ := entry.text.undo_edit()
            }
            on step % 17 == 16 => {
                _ := entry.text.redo_edit()
            }
        }
        _ := assert_incremental_analysis(^entry)
        own(^entry.path, "/notes.txt")
        assert entry.update_syntax() == 0
        assert entry.syntax == nil && entry.text.line_changes == nil
        _ := entry.text.edit({
            start : entry.text.text().count
            end   : entry.text.text().count
        }, "tail")?
        assert entry.text.line_changes == nil
        own(^entry.path, "/notes.markdown")
        _ := assert_incremental_analysis(^entry)
    }

}

test "optional Markdown metadata reuses stable lines and agrees with full analysis after batched edits and history" {
    on exercise_incremental_analysis() {
        _success => {
        }

        error! => {
            assert no, error.show()
        }
    }
}

test {

    assert_nerd_analysis :: fn (entry: ^DocumentEntry) -> usize {
        analysed               := entry.update_syntax()
        reference : NerdSyntax

        defer reference.release()
        _ := reference.update(entry.text.text(),
                              entry.text.lines[..],
                              entry.text.storage.revision(),
                              0,
                              0)
        on entry.nerd_syntax {
            cache => {
                assert cache.lines.count == reference.lines.count
                for index, actual in cache.lines {
                    expected := ^reference.lines[index]
                    assert actual.input == expected.input && actual.output == expected.output
                    assert actual.length == expected.length
                    assert actual.spans.count == expected.spans.count
                    for span_index, span in actual.spans {
                        assert span^ == expected.spans[span_index]
                    }
                    for offset in [0.as(usize) .. actual.length + 1] {
                        assert cache.line_style(index, offset) == reference.line_style(index, offset)
                    }
                }
            }

            else => {
                assert no
            }
        }
        return analysed
    }

    exercise_nerd_analysis :: fn () -> void\EditError {
        entry : DocumentEntry
        defer entry.release()
        own(^entry.path, "/main.n")
        source : [..]u8
        defer source.free()
        for _line in [0 .. 200] {
            for byte in """
    value := 12 -- comment
    """ {
                source.push(byte^)
            }
        }
        entry.text.load(bytes_text(source))?
        assert assert_nerd_analysis(^entry) == 201
        assert entry.syntax == nil && entry.nerd_syntax != nil && entry.text.line_changes != nil
        gap := entry.text.storage.gap_start
        assert entry.update_syntax() == 0 && entry.text.storage.gap_start == gap
        middle := entry.text.line_start(100)
        _      := entry.text.edit({ start: middle end: middle + 1 }, "V")?

        assert assert_nerd_analysis(^entry) == 1
        _ := entry.text.edit({ start: middle end: middle }, "\"\"\"")?
        assert assert_nerd_analysis(^entry) > 50
        _            := entry.text.undo_edit()
        _            := assert_nerd_analysis(^entry)
        seed : usize = 19

        for step in [0 .. 200] {
            seed = (seed * 251 + 17) % 65521
            start := seed % (entry.text.text().count + 1)
            end   := start + seed % 4

            on end > entry.text.text().count => end = entry.text.text().count
            replacements := ["x", "", "\n", "\r\n", "\"\"\"", "$\"{", "}", "--", "\\", "\""]
            _            := entry.text.edit({ start end }, replacements[seed % 10])?

            on step % 5 == 4 => {
                _ := assert_nerd_analysis(^entry)
            }
            on step % 11 == 10 => {
                _ := entry.text.undo_edit()
            }
            on step % 17 == 16 => {
                _ := entry.text.redo_edit()
            }
        }
        _ := assert_nerd_analysis(^entry)
        own(^entry.path, "/notes.md")
        _ := entry.update_syntax()
        assert entry.nerd_syntax == nil && entry.syntax != nil
        own(^entry.path, "/notes.txt")
        _ := entry.update_syntax()
        assert entry.nerd_syntax == nil && entry.syntax == nil && entry.text.line_changes == nil
    }

}

test "optional Nerd metadata converges and matches full lexing through edits and history" {
    on exercise_nerd_analysis() {
        _success => {
        }

        error! => {
            assert no, error.show()
        }
    }
}
