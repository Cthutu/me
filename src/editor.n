test {

    exercise_repeat_guards :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        editor : Editor
        editor.workspace.lock_fd = -1
        defer editor.release()
        editor.workspace.add_empty()
        editor.workspace.active_view().interaction.state = Interaction.Normal
        editor.execute(^scratch, Command.RecordStart)?
        editor.execute(^scratch, Command.EnterInsert('i'.as(u32)))?
        for _ in [0 .. 4094] {
            editor.execute(^scratch, Command.Move { direction: Right count: 1 extend: no })?
        }
        on editor.execute(^scratch, Command.InsertText("blocked")) {
            _success => {
                assert no
            }

            _error! => {
            }
        }
        -- The cap must never trap the user in Insert with no way to finish.
        editor.execute(^scratch, Command.Escape)?
        on editor.workspace.active_view().interaction.state == Interaction.Insert => editor.execute(^scratch, Command.Escape)?
        assert editor.workspace.active_view().interaction.state == Interaction.Normal
        editor.execute(^scratch, Command.RecordStop)?
        assert editor.recording.saved.count == 4096
        editor.execute(^scratch, Command.Replay)?
        assert editor.workspace.active_document().text.history.count == 0
        editor.execute(^scratch, Command.RecordStart)?
        on editor.workspace.active_document().text.edit({ start: 0 end: 0 }, "e"
    +"xternal") {
            _change => {
            }

            _error! => {
                assert no
            }
        }
        on editor.execute(^scratch, Command.RecordStop) {
            _success => {
                assert no
            }

            _error! => {
            }
        }
        assert !editor.recording.active && editor.recording.saved.count == 4096
    }

    exercise_repeat_edit_recipes :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        for keys in [
    "[iAB\x1bl\x1aiC\x1b]",
    "[iAB\x1bh\x1a\x12]",
    "[iA\x1bhciB\x1b\x1a\x1a"
        +"\x12\x12]",
] {
            editor : Editor
            editor.workspace.lock_fd = -1
            defer editor.release()
            editor.workspace.add_empty()
            editor.workspace.active_view().interaction.state = Interaction.Normal
            repeat_keys(^editor, ^scratch, keys^)
            assert !editor.recording.active && editor.recording.saved.count > 0
            expected := scratch.pr(editor.workspace.active_document().text.text())
            position := editor.workspace.active_view().interaction.selection.active

            editor.workspace.add_empty()
            editor.workspace.active_view().interaction.state = Interaction.Normal
            editor.execute(^scratch, Command.Replay)?
            assert editor.workspace.active_document().text.text() == expected
            assert editor.workspace.active_view().interaction.selection.active == position
        }
    }

}

