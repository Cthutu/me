use buffer
use characters
use completion
use document
use file_picker
use key_diagnostics
use keyboard
use leader_menu
use modes
use native
use nerd_lsp
use os.linux
use panes
use picker
use positions
use repeat
use replacement
use search
use std.term
use std.text
use std.time
use view
use workspace

document_match :: fn (doc         : ^Document,
                      query       : string,
                      origin      : usize,
                      backwards   : bool,
                      skip_origin : bool = no) -> ?usize {
    start    := doc.line_start(0)
    relative := on origin >= start { yes => origin - start else => 0 }

    on find_literal(doc.text()[start..], query, relative, backwards, skip_origin = skip_origin) {
        position  => return position + start
        else      => return nil
    }
}

pub SaveConfirmation :: plex {
    active      bool
    document_id usize
    revision    u64
    path        [..]u8
    disk        [..]u8
    stamp       Stat
    pending     bool
    force_write bool
}

impl SaveConfirmation {

    reset :: fn (self: ^Self) {
        self.active = no
        self.path.clear()
        self.disk.clear()
    }

    release :: fn (self: ^Self) {
        self.path.free()
        self.disk.free()
    }

}

pub Editor :: plex {
    language           NerdLsp
    workspace          Workspace
    completion         PromptCompletion
    overwrite          SaveConfirmation
    confirmation       ReplaceConfirmation
    diagnostics        KeyDiagnostics
    recording          RepeatRecording
    picker             FuzzyPicker
    files              FileDiscovery
    leader             bool
    leader_shown       bool
    leader_started     Instant
    leader_revealed    Instant
    leader_prefix      string
    picking_files      bool
    splitting_file     bool
    split_origin       usize
    suppress_character bool
    search_decoded     [..]u8
    clipboard          Clipboard
    prompt             [..]u8
    prompt_kind        u32
    prompt_caret       usize
    search_saved       View
    last_search        [..]u8
    highlights         bool
    active_match       ?usize
    message            [..]u8
    message_scroll     usize
    dirty              bool
    changed_at         Instant
    checkpoint_at      Instant
    quit               bool
    save_all_pending   bool
}

impl Editor {
    pub release :: fn (self: ^Self) {
        self.language.release()
        self.workspace.release()
        self.completion.release()
        self.confirmation.release()
        self.overwrite.release()
        self.diagnostics.release()
        self.recording.release()
        self.files.release()
        self.picker.release()
        self.search_decoded.free()
        self.clipboard.bytes.free()
        self.prompt.free()
        self.last_search.free()
        self.message.free()
    }
    pub notify_others :: fn (self: ^Self, document_id: usize, invoking_view: usize, change: TextChange) {
        doc := ^self.workspace.documents[document_id].text
        for id, other in self.workspace.views {
            on id != invoking_view && other.document_id == document_id => {
                other.interaction.selection.adjust(change)
                other.interaction.repair(doc)
            }
        }
    }
    pub tell :: fn (self: ^Self, message: string) {
        own(^self.message, message)
        self.message_scroll = 0
    }
    pub changed :: fn (self: ^Self) {
        self.dirty = yes
        self.changed_at = now()
        self.highlights = no
        self.active_match = nil
        self.message.clear()
    }
    pub collect_completion :: fn (self: ^Self) -> bool\string {
        raw := bytes_text(self.prompt)
        start := command_start(raw)
        end := start
        for end < raw.count && raw[end] != ' ' {
            end += 1
        }
        self.completion.command_mode = end == raw.count
        on self.completion.command_mode => {
            self.completion.commands(raw[start ..])
            self.completion.replacement_start = start
            return yes
        }
        parsed := on path_command(raw) {
            value => value
            else => {
                self.completion.reset()
                return no
            }
        }
        self.completion.filter_files(bytes_text(self.workspace.folder), raw[parsed.argument_start ..])?
        self.completion.replacement_start = parsed.argument_start
        return yes
    }
    pub refilter_completion :: fn (self: ^Self) {
        on self.collect_completion() {
            supported => {
                self.completion.active = supported
                self.message.clear()
            }
            error! => {
                self.completion.active = yes
                self.tell(error)
            }
        }
    }
    pub complete_prompt :: fn (self: ^Self, scratch: ^arena) -> void\string {
        on self.completion.active => {
            on self.completion.items.count > 0 => self.completion.selected = (self.completion.selected + 1) % self.completion.items.count
            return
        }
        raw := bytes_text(self.prompt)
        on self.prompt_caret != raw.count => return "Move to the end of the "
            +"prompt before completing"!
        self.completion.reset()
        on !self.collect_completion()? => return "Completion supports command "
            +"names and :e/:w/:w!/:ww paths"!
        on self.completion.items.count == 0 => {
            self.tell(on self.completion.command_mode {
                yes => "No command match" else => "No filename match"
            })
            return
        }
        prefix := scratch.pr(raw[.. self.completion.replacement_start])
        query := raw[self.completion.replacement_start ..]
        common := self.completion.common_prefix()
        on common.count < query.count => common = query
        own(^self.prompt, scratch.pr($"{prefix}{common}"))
        self.prompt_caret = self.prompt.count
        self.completion.active = self.completion.items.count > 1
        on !self.completion.active => self.completion.reset()
        self.message.clear()
        self.message_scroll = 0
    }
    pub accept_completion :: fn (self: ^Self, scratch: ^arena) {
        on self.completion.items.count == 0 => return
        prefix := bytes_text(self.prompt)[.. self.completion.replacement_start]
        item := self.completion.items[self.completion.selected]
        own(^self.prompt, scratch.pr($"{prefix}{item}"))
        self.prompt_caret = self.prompt.count
        self.completion.reset()
        self.message.clear()
    }
    pub prompt_open :: fn (self: ^Self, kind: u32, initial: string = "") {
        self.completion.reset()
        self.message.clear()
        self.prompt_kind = kind
        own(^self.prompt, initial)
        self.prompt_caret = initial.count
        self.workspace.active_view().keyboard.count = 0
        self.workspace.active_view().interaction.state = Interaction.Normal
        self.search_saved = self.workspace.active_view().interaction
        on kind != ':'.as(u32) => self.preview_search()
    }
    pub search_query :: fn (self: ^Self) -> string {
        query := bytes_text(self.prompt)
        on self.prompt_kind == '/'.as(u32) => {
            query = forward_body(query)
            replacing := slash_separator(query)
            on replacing => [end] {
                query = query[.. end]
            }
            on query.count == 0 => return on replacing != nil {
                yes => "" else => bytes_text(self.last_search)
            }
            self.search_decoded.resize_undefined_to(query.count)
            used := decode_slashes(query, self.search_decoded[..])
            self.search_decoded.resize_undefined_to(used)
            return bytes_text(self.search_decoded)
        }
        on query.count > 0 && query[0].as(u32) == self.prompt_kind => query = query[1 ..]
        else on query.count > 1 && query[0] == '\\' && query[1].as(u32) == self.prompt_kind => query = query[1 ..]
        return on query.count > 0 {
            yes => query else => bytes_text(self.last_search)
        }
    }
    pub preview_search :: fn (self: ^Self) {
        query := self.search_query()
        view := ^self.workspace.active_view().interaction
        doc := ^self.workspace.active_document().text
        view^ = self.search_saved
        view.selection.collapse(view.selection.active)
        self.message.clear()
        origin := view.selection.active
        origin_prefix := self.prompt.count > 0 && self.prompt[0].as(u32) == self.prompt_kind
        on self.prompt_kind == '/'.as(u32) => {
            body := forward_body(bytes_text(self.prompt))
            on origin_prefix || slash_separator(body) != nil => origin = doc.line_start(0)
        }
        on self.prompt_kind == '?'.as(u32) && origin_prefix => origin = doc.text().count
        self.highlights = query.count > 0
        self.active_match = document_match(doc, query, origin, self.prompt_kind == '?'.as(u32))
        on self.active_match {
            position => {
                view.place(doc, position, no)
                self.message.clear()
            }
            else => {
                on query.count > 0 => self.tell("No match")
            }
        }
    }
    pub prompt_cancel :: fn (self: ^Self) {
        self.completion.reset()
        on self.prompt_kind != ':'.as(u32) && self.prompt_kind != 0 => {
            query := self.search_query()
            on query.count > 0 && query != bytes_text(self.last_search) => own(^self.last_search, query)
            view := ^self.workspace.active_view().interaction
            view^ = self.search_saved
            view.selection.collapse(view.selection.active)
            view.reveal = no
        }
        self.prompt_kind = 0
        self.prompt.clear()
        self.highlights = no
        self.active_match = nil
        self.save_all_pending = no
    }
    pub prompt_insert :: fn (self: ^Self, text: string) {
        filtering := self.completion.active
        on self.prompt_kind == ':'.as(u32) => self.message.clear()
        old_count := self.prompt.count
        self.prompt.resize_undefined_to(old_count + text.count)
        index := old_count
        for index > self.prompt_caret {
            index -= 1
            self.prompt[index + text.count] = self.prompt[index]
        }
        self.prompt[self.prompt_caret .. self.prompt_caret + text.count] = text.as([]u8)
        self.prompt_caret += text.count
        on filtering => self.refilter_completion()
        on self.prompt_kind != ':'.as(u32) => self.preview_search()
    }
    pub prompt_delete :: fn (self: ^Self, backwards: bool, word: bool = no) {
        filtering := self.completion.active
        on self.prompt_kind == ':'.as(u32) => self.message.clear()
        start := on backwards {
            yes => on word {
                yes => word_start_before(bytes_text(self.prompt), self.prompt_caret)
                else => previous_character(bytes_text(self.prompt), self.prompt_caret)
            }
            else => self.prompt_caret
        }
        end := on backwards {
            yes => self.prompt_caret else => next_character(bytes_text(self.prompt), self.prompt_caret)
        }
        for index in [end .. self.prompt.count] {
            self.prompt[index - (end - start)] = self.prompt[index]
        }
        self.prompt.resize_undefined_to(self.prompt.count - (end - start))
        self.prompt_caret = start
        on filtering => self.refilter_completion()
        on self.prompt_kind != ':'.as(u32) => self.preview_search()
    }
    pub finish_slash :: fn (self: ^Self, scratch: ^arena) -> void\string {
        body := forward_body(bytes_text(self.prompt))
        on self.prompt_kind != '/'.as(u32) || slash_separator(body) == nil => {
            self.finish_search()?
            return
        }
        parsed := parse_replace(scratch, scratch.pr($"/{body}"))?
        doc := ^self.workspace.active_document().text
        view := ^self.workspace.active_view().interaction
        view^ = self.search_saved
        view.repair(doc)
        view.selection.collapse(view.selection.active)
        before := view.selection.active
        self.prompt_kind = 0
        self.prompt.clear()
        self.highlights = no
        self.active_match = nil
        own(^self.last_search, parsed.needle)
        on parsed.needle == parsed.replacement => {
            self.tell("No change")
            return
        }
        on parsed.confirm => {
            self.confirmation.reset()
            own(^self.confirmation.needle, parsed.needle)
            own(^self.confirmation.replacement, parsed.replacement)
            replacement_matches(^self.confirmation.matches, doc.text(), parsed.needle, minimum = doc.line_start(0))
            on self.confirmation.matches.count == 0 => {
                self.tell("No match")
                return
            }
            self.confirmation.document_id = self.workspace.active_view().document_id
            self.confirmation.invoking_view = self.workspace.surface.view_id
            self.confirmation.history_base = doc.applied
            self.confirmation.expected_revision = doc.storage.revision()
            self.confirmation.caret_before = before
            self.confirmation.active = yes
            self.workspace.active_view().keyboard.suppress_text = no
            self.show_confirmation(scratch)
            return
        }
        on plan_replacement(scratch, doc.text(), parsed, minimum = doc.line_start(0)) {
            plan => {
                applied := doc.applied
                on doc.edit(plan.range, plan.text) {
                    change => {
                        on change.before_revision != change.after_revision => self.notify_others(self.workspace.active_view().document_id, self.workspace.surface.view_id, change)
                    }
                    _error! => return "Replacement is not valid UTF-8"!
                }
                view.place(doc, plan.range.start + plan.text.count, no)
                on doc.applied > applied => {
                    doc.history[doc.applied - 1].caret_before = before
                    doc.history[doc.applied - 1].caret_after = view.selection.active
                }
                self.changed()
                self.tell(scratch.pr($"Replaced {plan.count} match(es)"))
            }
            else => self.tell("No match")
        }
    }
    pub show_confirmation :: fn (self: ^Self, scratch: ^arena) {
        position := self.confirmation.position()
        doc := ^self.workspace.active_document().text
        view := ^self.workspace.active_view().interaction
        view.place(doc, position, no)
        view.selection.anchor = position + self.confirmation.needle.count
        self.highlights = yes
        self.active_match = position
        self.tell(scratch.pr($"Replace {self.confirmation.index + 1}/{self.confirmation.matches.count}? Y replace · N skip · A rest · Esc stop"))
    }
    pub finish_confirmation :: fn (self: ^Self, scratch: ^arena, reason: string) {
        count := self.confirmation.approved
        on self.workspace.surface.view_id == self.confirmation.invoking_view && self.workspace.active_view().document_id == self.confirmation.document_id => {
            doc := ^self.workspace.active_document().text
            view := ^self.workspace.active_view().interaction
            view.repair(doc)
            view.selection.collapse(view.selection.active)
            on self.confirmation.grouped && doc.applied == self.confirmation.history_base + 1 && doc.storage.revision() == self.confirmation.expected_revision => doc.history[doc.applied - 1].caret_after = view.selection.active
        }
        self.confirmation.reset()
        self.highlights = no
        self.active_match = nil
        self.workspace.active_view().keyboard.suppress_text = no
        self.tell(scratch.pr($"{reason} {count} match(es)"))
    }
    pub confirm_replace :: fn (self: ^Self, scratch: ^arena, answer: u32) -> void\string {
        on !self.confirmation.active => return
        on answer == 27 => {
            self.finish_confirmation(scratch, "Stopped after")
            return
        }
        on answer != 'y'.as(u32) && answer != 'Y'.as(u32) && answer != 'n'.as(u32) && answer != 'N'.as(u32) && answer != 'a'.as(u32) && answer != 'A'.as(u32) => return
        on self.workspace.surface.view_id != self.confirmation.invoking_view || self.workspace.active_view().document_id != self.confirmation.document_id || self.workspace.active_document().text.storage.revision() != self.confirmation.expected_revision => {
            self.finish_confirmation(scratch, "Document changed; stopped after")
            return
        }
        all := answer == 'a'.as(u32) || answer == 'A'.as(u32)
        skip := answer == 'n'.as(u32) || answer == 'N'.as(u32)
        on all => {
            doc := ^self.workspace.active_document().text
            parsed := ReplaceCommand {
                needle: bytes_text(self.confirmation.needle) replacement: bytes_text(self.confirmation.replacement) confirm: no
            }
            on plan_replacement(scratch, doc.text(), parsed, minimum = self.confirmation.position()) => [plan] {
                change := on self.confirmation.grouped {
                    yes => doc.extend_forward_edit(plan.range, plan.text)
                    else => doc.edit(plan.range, plan.text)
                }
                on change {
                    edited => {
                        on edited.before_revision != edited.after_revision => {
                            self.notify_others(self.confirmation.document_id, self.confirmation.invoking_view, edited)
                            self.confirmation.grouped = yes
                            doc.history[doc.applied - 1].caret_before = self.confirmation.caret_before
                            doc.history[doc.applied - 1].caret_after = plan.range.start + plan.text.count
                        }
                    }
                    _error! => {
                        self.finish_confirmation(scratch, "Replacement failed "
                            +"after")
                        return "Replacement failed"!
                    }
                }
                self.confirmation.approved += plan.count
                self.workspace.active_view().interaction.place(doc, plan.range.start + plan.text.count, no)
                self.confirmation.expected_revision = doc.storage.revision()
                self.changed()
            }
            self.finish_confirmation(scratch, "Replaced")
            return
        }
        for self.confirmation.index < self.confirmation.matches.count {
            position := self.confirmation.position()
            doc := ^self.workspace.active_document().text
            view := ^self.workspace.active_view().interaction
            on !skip => {
                range := TextRange {
                    start: position end: position + self.confirmation.needle.count
                }
                change := on self.confirmation.grouped {
                    yes => doc.extend_forward_edit(range, bytes_text(self.confirmation.replacement))
                    else => doc.edit(range, bytes_text(self.confirmation.replacement))
                }
                on change {
                    edited => {
                        on edited.before_revision != edited.after_revision => {
                            self.notify_others(self.confirmation.document_id, self.confirmation.invoking_view, edited)
                            self.confirmation.grouped = yes
                            doc.history[doc.applied - 1].caret_before = self.confirmation.caret_before
                            doc.history[doc.applied - 1].caret_after = position + self.confirmation.replacement.count
                        }
                    }
                    _error! => {
                        self.finish_confirmation(scratch, "Replacement failed "
                            +"after")
                        return "Replacement failed"!
                    }
                }
                self.confirmation.approved += 1
                self.confirmation.removed_total += self.confirmation.needle.count
                self.confirmation.added_total += self.confirmation.replacement.count
                view.place(doc, position + self.confirmation.replacement.count, no)
                self.confirmation.expected_revision = doc.storage.revision()
                self.changed()
            }
            self.confirmation.index += 1
            on !all => break
        }
        on self.confirmation.index == self.confirmation.matches.count {
            yes => self.finish_confirmation(scratch, "Replaced")
            else => self.show_confirmation(scratch)
        }
    }
    pub finish_search :: fn (self: ^Self) -> void\string {
        query := self.search_query()
        on query.count == 0 => {
            self.prompt_cancel()
            return "No previous search"!
        }
        on query != bytes_text(self.last_search) => own(^self.last_search, query)
        matched := self.active_match != nil
        self.prompt_kind = 0
        self.prompt.clear()
        self.highlights = no
        self.active_match = nil
        view := ^self.workspace.active_view().interaction
        view.selection.collapse(view.selection.active)
        self.dirty = yes
        on !matched => return "No match"!
    }
    pub find_next :: fn (self: ^Self, backwards: bool) -> void\string {
        query := bytes_text(self.last_search)
        on query.count == 0 => return "No previous search"!
        view := ^self.workspace.active_view().interaction
        doc := ^self.workspace.active_document().text
        on document_match(doc, query, view.selection.active, backwards, skip_origin = yes) {
            position => {
                view.place(doc, position, no)
                view.selection.anchor = position + query.count
                view.selection.active = position
                self.highlights = yes
                self.active_match = position
                self.dirty = yes
            }
            else => return "No other match"!
        }
    }
    pub open_buffer_picker :: fn (self: ^Self, scratch: ^arena) {
        self.files.cancel()
        self.picking_files = no
        self.splitting_file = no
        self.workspace.record_access()
        self.picker.start("Buffers")
        active := self.workspace.active_view().document_id
        folder := bytes_text(self.workspace.folder)
        for id in self.workspace.access_order {
            entry := ^self.workspace.documents[id^]
            path := on entry.path.count == 0 {
                yes => "[unnamed]" else => bytes_text(entry.path)
            }
            on folder.count > 0 && path.count > folder.count && path[.. folder.count] == folder && path[folder.count] == '/' => path = path[folder.count + 1 ..]
            current := on id^ == active {
                yes => ">" else => " "
            }
            modified := on entry.modified() {
                yes => "*" else => " "
            }
            self.picker.add(id^, path, annotation = scratch.pr($"{id^ + 1}{current}{modified}"))
        }
        self.picker.filter()
        self.picker.selected = on self.picker.matches.count > 1 {
            yes => 1 else => 0
        }
    }
    pub open_file_picker :: fn (self: ^Self) -> void\string {
        self.files.cancel()
        self.splitting_file = no
        self.picking_files = yes
        self.picker.start("Files · scanning")
        self.picker.incremental = yes
        self.message.clear()
        on self.files.start(bytes_text(self.workspace.folder)) {
            _success => {
            }
            error! => {
                self.files.failed = yes
                self.picker.title = "Files · discovery failed"
                return error!
            }
        }
    }
    pub poll_file_picker :: fn (self: ^Self) {
        self.files.reap()
        on !self.picking_files => return
        on !self.picker.active => {
            self.files.cancel()
            self.picking_files = no
            return
        }
        on self.files.poll(^self.picker) {
            _success => {
            }
            error! => self.tell(error)
        }
        self.picker.filter_step(512)
        self.picker.title = on {
            self.files.failed => "Files · incomplete"
            self.files.running => "Files · scanning"
            self.picker.scanned < self.picker.entries.count => "Files · "
                +"filtering"
            else => "Files"
        }
    }
    pub accept_picked_file :: fn (self: ^Self, scratch: ^arena, id: usize) -> void\string {
        on id >= self.files.paths.count => return "No such file candidate"!
        path := scratch.pr($"{bytes_text(self.workspace.folder)}/{self.files.paths[id]}")
        on metadata(scratch, path) {
            info => {
                on (info.mode & S_IFMT) != S_IFREG => return "Selected file is "
                    +"no longer a regular file"!
            }
            else => return "Selected file no longer exists"!
        }
        -- Preflight before opening: the synchronous open cannot change geometry.
        -- Only successful opens mount a file, so failures leave the origin intact.
        origin_view := self.workspace.surface.view_id
        on self.splitting_file => {
            self.workspace.panes.focused = self.split_origin
            on !self.workspace.panes.can_split(SplitAxis.Automatic) => return "Not enough room to split this pane"!
        }
        self.workspace.open_file(scratch, path)?
        on self.splitting_file => {
            chosen := self.workspace.surface.view_id
            self.workspace.focus_view(origin_view)
            self.workspace.split_view(SplitAxis.Automatic, chosen)?
        }
        self.splitting_file = no
        self.workspace.active_view().interaction.state = Interaction.Normal
        self.files.cancel()
        self.picker.active = no
        self.picking_files = no
        self.highlights = no
        self.active_match = nil
        self.changed()
        self.message.clear()
    }
    pub close_buffer :: fn (self: ^Self, scratch: ^arena, force: bool = no, normalise: bool = no, document_id: ?usize = nil) -> void\string {
        suppressed := self.workspace.active_view().keyboard.suppress_text
        self.workspace.active_view().keyboard.suppress_text = no
        self.suppress_character = self.suppress_character || suppressed
        on self.prompt_kind != 0 => self.prompt_cancel()
        self.picker.active = no
        on normalise => self.workspace.active_view().interaction.state = Interaction.Normal
        target := on document_id {
            id => id else => self.workspace.active_view().document_id
        }
        self.workspace.kill_document(target, force)?
        on normalise => self.workspace.active_view().interaction.state = Interaction.Normal
        self.highlights = no
        self.active_match = nil
        self.changed()
        on self.workspace.persistent => {
            self.workspace.checkpoint(scratch)?
            self.dirty = no
        }
        self.tell("Buffer killed")
    }
    pub close_picked_buffer :: fn (self: ^Self, scratch: ^arena) {
        on self.picker.chosen() => [id] {
            query := scratch.pr(bytes_text(self.picker.query))
            caret := self.picker.caret
            selected := self.picker.selected
            top := self.picker.top
            rows := self.picker.rows
            on self.close_buffer(scratch, force = no, normalise = yes, document_id = id) {
                _success => {
                }
                error! => self.tell(error)
            }
            -- Document IDs shift on removal, so rebuild candidates and preview
            -- targets from the workspace rather than retaining stale entries.
            self.open_buffer_picker(scratch)
            self.picker.insert(query)
            self.picker.caret = caret
            self.picker.selected = on selected < self.picker.matches.count {
                yes => selected
                else => on self.picker.matches.count > 0 {
                    yes => self.picker.matches.count - 1 else => 0
                }
            }
            self.picker.top = top
            self.picker.rows = rows
        }
    }
    pub picker_key :: fn (self: ^Self, scratch: ^arena, key: TermKeyEvent) {
        handled := yes
        on navigation_scan_code(key) {
            ArrowUp => self.picker.move_selection(yes)
            ArrowDown => self.picker.move_selection(no)
            PageUp => self.picker.move_selection(yes, count = self.picker.rows)
            PageDown => self.picker.move_selection(no, count = self.picker.rows)
            ArrowLeft => self.picker.caret = previous_character(bytes_text(self.picker.query), self.picker.caret)
            ArrowRight => self.picker.caret = next_character(bytes_text(self.picker.query), self.picker.caret)
            Home => self.picker.caret = 0
            End => self.picker.caret = self.picker.query.count
            Backspace => self.picker.erase(yes)
            -- Legacy DEL is Backspace, matching the text keyboard's policy.
            Delete => self.picker.erase(key.character == 127.as(u32))
            Escape => {
                self.picker.active = no
                self.files.cancel()
                self.picking_files = no
                self.splitting_file = no
            }
            Enter => on self.picker.chosen() => [id] {
                on self.picking_files {
                    yes => on self.accept_picked_file(scratch, id) {
                        _success => {
                        }
                        error! => self.tell(error)
                    }
                    else => on self.workspace.focus_document(id) => {
                        self.workspace.active_view().interaction.state = Interaction.Normal
                        self.highlights = no
                        self.active_match = nil
                        self.changed()
                        self.message.clear()
                        self.picker.active = no
                    }
                }
            }
            W => on (key.modifiers & TERM_MOD_CONTROL) != 0 {
                yes => {
                    on !self.picking_files => self.close_picked_buffer(scratch)
                }
                else => handled = no
            }
            else => handled = no
        }
        on handled && key.character != nil => self.suppress_character = yes
    }
    pub save_all :: fn (self: ^Self, scratch: ^arena) -> void\string {
        for id, entry in self.workspace.documents {
            on !entry.modified() => again
            on entry.path.count == 0 => {
                _ := self.workspace.focus_document(id)
                self.prompt_open(':'.as(u32), initial = "w ")
                self.save_all_pending = yes
                return
            }
            on self.workspace.save(scratch, id, "", no, no) {
                _success => self.dirty = yes
                error! => {
                    _ := self.workspace.focus_document(id)
                    return scratch.pr($"Cannot save {bytes_text(entry.path)}: {error}")!
                }
            }
        }
        self.quit_safely(scratch)?
    }
    pub quit_safely :: fn (self: ^Self, scratch: ^arena) -> void\string {
        self.cancel_recording()
        on self.workspace.persistent {
            yes => self.workspace.checkpoint(scratch)?
            else => {
                for entry in self.workspace.documents {
                    on entry.modified() => return "Cannot quit safely without "
                        +"continuation. Save files or use :q! to discard unsaved buffers."!
                }
            }
        }
        self.quit = yes
    }
    pub command_line :: fn (self: ^Self, scratch: ^arena) -> void\string {
        raw := scratch.pr(bytes_text(self.prompt))
        command := raw.trim()
        self.completion.reset()
        pending := self.save_all_pending
        self.prompt_kind = 0
        self.prompt.clear()
        self.save_all_pending = no
        on self.recording.active && command != "q" && command != "q!" && command != "wq" => return "Command unavailable while recording; use ] to finish or Ctrl+G to cancel"!
        on command == "diagnostics" => {
            self.tell(self.language.report(scratch, ^self.workspace))
            return
        }
        on command == "lsp-restart" => {
            self.language.restart()
            self.tell("Nerd LSP restarting")
            return
        }
        on command == "keys" => {
            self.diagnostics.start()
            self.workspace.active_view().keyboard.suppress_text = no
            self.tell(self.diagnostics.message(scratch))
            return
        }
        on command == "q" => {
            self.quit_safely(scratch)?
            return
        }
        on command == "q!" => {
            self.cancel_recording()
            self.workspace.abandon()?
            self.changed()
            on self.workspace.persistent => self.workspace.checkpoint(scratch)?
            self.quit = yes
            return
        }
        on command == "kill" || command == "kill!" => {
            self.close_buffer(scratch, force = command == "kill!")?
            return
        }
        on command == "wq" => {
            self.cancel_recording()
            self.save_all(scratch)?
            return
        }
        number: usize = 0
        numeric := command.count > 0
        maximum := self.workspace.active_document().text.lines.count
        for byte in command {
            on byte^ < '0' || byte^ > '9' {
                yes => numeric = no
                else => {
                    on number > maximum / 10 {
                        yes => number = maximum
                        else => number = number * 10 + (byte^ - '0').as(usize)
                    }
                    on number > maximum => number = maximum
                }
            }
        }
        on numeric => {
            doc := ^self.workspace.active_document().text
            line := on number == 0 {
                yes => 0 else => number - 1
            }
            on line >= doc.lines.count => line = doc.lines.count - 1
            self.workspace.active_view().interaction.place(doc, doc.first_text(line), no)
            self.highlights = no
            self.dirty = yes
            return
        }
        split: usize = 0
        for split < command.count &&
            command[split] != ' ' {
            split += 1
        }
        verb := command[.. split]
        filename := command[split ..].trim()
        on path_command(raw) => [parsed] {
            filename = raw[parsed.argument_start ..]
        }
        on verb == "e" => {
            on filename.count == 0 => return "Expected :e and a path"!
            self.workspace.open_file(scratch, filename)?
            self.highlights = no
            self.active_match = nil
            self.changed()
            self.message.clear()
            return
        }
        on verb == "files" => {
            self.open_file_picker()?
            return
        }
        on verb == "buffers" => {
            listing := ""
            active := self.workspace.active_view().document_id
            for id, entry in self.workspace.documents {
                marker := on id == active {
                    yes => ">" else => " "
                }
                modified := on entry.modified() {
                    yes => "*" else => " "
                }
                path := on entry.path.count == 0 {
                    yes => "[unnamed]" else => bytes_text(entry.path)
                }
                listing = scratch.pr($"{listing}{marker}{id + 1}{modified} {path}\n")
            }
            self.tell(listing)
            return
        }
        on verb == "buffer" => {
            number: usize = 0
            for byte in filename {
                on byte^ < '0' || byte^ > '9' || number > 10000 => return "Expe"
                    +"cted :buffer and a number from :buffers"!
                number = number * 10 + (byte^ - '0').as(usize)
            }
            on number == 0 || number > self.workspace.documents.count => return "No such buffer; use :buffers"!
            on self.workspace.focus_document(number - 1) => {
                self.workspace.active_view().interaction.state = Interaction.Normal
                self.highlights = no
                self.dirty = yes
                self.message.clear()
                return
            }
            return "No view for that buffer"!
        }
        on verb != "w" && verb != "ww" && verb != "w!" => return "Unknown "
            +"command"!
        id := self.workspace.active_view().document_id
        on filename.count == 0 && self.workspace.documents[id].path.count == 0 => {
            self.prompt_open(':'.as(u32), initial = "w ")
            self.save_all_pending = pending
            return
        }
        on filename.count > 0 && verb != "w!" => {
            target := self.workspace.save_target(scratch, id, filename)?
            on target.existing => [stamp] {
                on !target.same_path => {
                    on (stamp.mode & 0xf000) != 0x8000 => return "Target is "
                        +"not a regular file"!
                    disk := read_file(scratch, target.path)?
                    on metadata(scratch, target.path) {
                        current => {
                            on !same_file_state(stamp, current) => return "Save"
                                +" target changed; retry after reviewing"!
                        }
                        else => return "Save target disappeared; retry after "
                            +"reviewing"!
                    }
                    own(^self.overwrite.path, target.path)
                    own(^self.overwrite.disk, disk)
                    self.overwrite.document_id = id
                    self.overwrite.revision = self.workspace.documents[id].text.storage.revision()
                    self.overwrite.stamp = stamp
                    self.overwrite.pending = pending
                    self.overwrite.force_write = verb != "w"
                    self.overwrite.active = yes
                    self.show_save_confirmation(scratch)
                    return
                }
            }
        }
        self.workspace.save(scratch, id, filename, verb != "w", verb == "w!")?
        self.dirty = yes
        self.tell("Saved")
        on pending => self.save_all(scratch)?
    }
    show_save_confirmation :: fn (self: ^Self, scratch: ^arena) {
        label := display_text(scratch, bytes_text(self.overwrite.path), single_line = yes)
        self.tell(scratch.pr($"File {label} exists - save? (Y/N)"))
    }
    pub confirm_save :: fn (self: ^Self, scratch: ^arena, rune: u32) -> void\string {
        on !self.overwrite.active => return
        on rune == 27 || rune == 'n'.as(u32) || rune == 'N'.as(u32) => {
            self.overwrite.reset()
            self.tell("Save cancelled")
            return
        }
        on rune != 'y'.as(u32) && rune != 'Y'.as(u32) => return
        self.overwrite.active = no
        defer self.overwrite.reset()
        id := self.overwrite.document_id
        on id >= self.workspace.documents.count || self.workspace.documents[id].text.storage.revision() != self.overwrite.revision => return "Buffer changed since confirmation; retry after reviewing"!
        self.workspace.save(scratch, id, bytes_text(self.overwrite.path), self.overwrite.force_write, yes,
        approved_state = self.overwrite.stamp, approved_text = bytes_text(self.overwrite.disk))?
        self.dirty = yes
        self.tell("Saved")
        on self.overwrite.pending => self.save_all(scratch)?
    }
    pub indent_width :: fn (self: ^Self) -> usize {
        doc := ^self.workspace.active_document().text
        width: usize = 0
        samples: usize = 0
        for line in [0.as(usize) .. doc.lines.count] {
            start := doc.line_start(line)
            first := doc.first_text(line)
            on first == start || first == doc.line_end(line) => again
            spaces := first - start
            on doc.content[start] != ' ' || spaces > 8 => again
            on width == 0 {
                yes => width = spaces else => {
                    remainder := spaces
                    for remainder != 0 {
                        next := width % remainder
                        width = remainder
                        remainder = next
                    }
                }
            }
            samples += 1
        }
        return on samples >= 2 && width >= 2 && width <= 8 {
            yes => width else => default_indent(self.workspace.active_document().file_mode())
        }
    }
    pub duplicate :: fn (self: ^Self, scratch: ^arena) -> void\EditError {
        entry := self.workspace.active_document()
        doc := ^entry.text
        view := ^self.workspace.active_view().interaction
        selected := view.linewise && !view.selection.empty()
        reversed := view.selection.active < view.selection.anchor
        line := doc.line_at(view.selection.active)
        last := line
        column := display_column(doc.text(), doc.line_start(line), view.selection.active)
        on selected => {
            line = doc.line_at(view.selection.start())
            last = doc.line_at(view.selection.end())
            -- A line selection ending at the next line's start excludes that
            -- line, including the virtual empty line after a final newline.
            on last > line && view.selection.end() == doc.line_start(last) => last -= 1
        }
        start := doc.line_start(line)
        end := on last + 1 < doc.lines.count {
            yes => doc.line_start(last + 1) else => doc.text().count
        }
        payload := scratch.pr(doc.text()[start .. end])
        insertion := end
        copy_start := insertion
        on last + 1 == doc.lines.count => {
            ending := entry.line_ending(last)
            payload = scratch.pr($"{ending}{payload}")
            copy_start += ending.count
        }
        _ := doc.edit({
            start: insertion end: insertion
        }
        , payload)?
        on selected {
            yes => {
                copy_end := insertion + payload.count
                view.place(doc, copy_start, no)
                view.selection.anchor = on reversed {
                    yes => copy_end else => copy_start
                }
                view.selection.active = on reversed {
                    yes => copy_start else => copy_end
                }
                view.linewise = yes
                view.reset_column(doc)
            }
            else => {
                view.preferred = column
                view.place(doc, view.position_column(doc, line + 1), no, retain_column = yes)
            }
        }
    }
    pub cancel_recording :: fn (self: ^Self) {
        on !self.recording.active => return
        self.recording.clear_draft()
        self.recording.active = no
        self.workspace.active_view().keyboard.count = 0
        self.workspace.active_view().keyboard.delete_count = 0
        self.tell("Recording cancelled")
    }
    pub start_recording :: fn (self: ^Self) -> void\string {
        on self.recording.active => return "Already recording; use ] to finish"!
        on self.workspace.active_view().interaction.state != Interaction.Normal => return "Start recording in Normal"!
        self.recording.clear_draft()
        self.recording.document_id = self.workspace.active_view().document_id
        self.recording.view_id = self.workspace.surface.view_id
        self.recording.revision = self.workspace.active_document().text.storage.revision()
        self.recording.history_base = self.workspace.active_document().text.applied
        self.recording.active = yes
        self.tell("Recording; ] in Normal finishes")
    }
    pub replay :: fn (self: ^Self, scratch: ^arena) -> void\string {
        on self.recording.active => return "Finish recording with ] before "
            +"replay"!
        on self.recording.playing => return "Nested replay is unavailable"!
        on self.recording.saved.count == 0 => return "No recorded sequence"!
        doc := ^self.workspace.active_document().text
        base := doc.applied
        before := scratch.pr(doc.text())
        caret := self.workspace.active_view().interaction.selection.active
        self.recording.playing = yes
        self.message.clear()
        defer {
            doc.group_history(base, before, caret, self.workspace.active_view().interaction.selection.active)
            self.recording.playing = no
        }
        step: usize = 0
        for action in self.recording.saved {
            on !action.enabled => again
            step += 1
            command := action.invocation()
            -- Recorded Escape represents an editing transition, not dismissal
            -- of a transient status message left by an earlier invocation.
            on command {
                Escape => self.message.clear() else => {
                }
            }
            on self.execute_inner(scratch, command) {
                _success => {
                }
                error! => return scratch.pr($"Replay stopped at step {step}: {error}")!
            }
        }
    }
    pub execute :: fn (self: ^Self, scratch: ^arena, command: Command) -> void\string {
        on self.overwrite.active => {
            on command {
                Escape => self.confirm_save(scratch, 27)?
                InsertText(text) => {
                    on text.count == 1 => self.confirm_save(scratch, text[0].as(u32))?
                }
                else => {
                }
            }
            return
        }
        on command {
            RecordStart => {
                self.start_recording()?
                return
            }
            RecordStop => {
                on !self.recording.active => return "No recording is active"!
                on self.workspace.surface.view_id != self.recording.view_id || self.workspace.active_view().document_id != self.recording.document_id || self.workspace.active_document().text.storage.revision() != self.recording.revision => {
                    self.recording.active = no
                    return "Recording cancelled: buffer or view changed "
                        +"externally"!
                }
                self.recording.finish()
                on self.recording.saved.count == 0 {
                    yes => self.tell("Recording cleared")
                    else => self.tell("Recording ready; . replays")
                }
                return
            }
            Replay => {
                self.replay(scratch)?
                return
            }
            else => {
            }
        }
        on !self.recording.active => {
            self.execute_inner(scratch, command)?
            return
        }
        -- Prompt editing is UI input, not part of the editing recipe. Quitting
        -- cancels the draft in command_line; other commands remain guarded there.
        on self.prompt_kind == ':'.as(u32) => {
            on command {
                InsertText(_), Move {
                    direction: _, count: _, extend: _
                }
                ,
                Escape, Backspace, DeleteWordBack, Delete, Tab => self.execute_inner(scratch, command)?
                else => return "Command unavailable while recording; use ] to "
                    +"finish or Ctrl+G to cancel"!
            }
            return
        }
        on command {
            Prompt(kind) => {
                on kind == ':'.as(u32) => {
                    self.execute_inner(scratch, command)?
                    return
                }
            }
            else => {
            }
        }
        doc := ^self.workspace.active_document().text
        on self.workspace.surface.view_id != self.recording.view_id || self.workspace.active_view().document_id != self.recording.document_id || doc.storage.revision() != self.recording.revision => {
            self.recording.active = no
            return "Recording cancelled: buffer or view changed externally"!
        }
        on command {
            Error(_) => {
                self.execute_inner(scratch, command)?
                return
            } else => {
            }
        }
        correcting := no
        redoing := no
        on command {
            Undo => {
                on doc.applied <= self.recording.history_base => return "Undo "
                    +"cannot cross the start of recording"!
                correcting = yes
            }
            Redo => {
                on !self.recording.can_redo(doc.applied) => return "No "
                    +"recorded edit to redo"!
                correcting = yes
                redoing = yes
            }
            else => on !recordable(command) => return "Command unavailable "
                +"while recording; use ] to finish"!
        }
        on !self.recording.room(command) => return "Recording limit reached; "
            +"use ] to finish"!
        before := doc.applied
        state := self.workspace.active_view().interaction.state
        selection := self.workspace.active_view().interaction.selection
        self.execute_inner(scratch, command)?
        self.recording.revision = doc.storage.revision()
        on correcting {
            yes => {
                index := on redoing {
                    yes => before else => doc.applied
                }
                _ := self.recording.correction(index, redoing)
                -- Undo/redo corrections are removed/restored edits, never
                -- executable undo commands. Preserve their Normal transition.
                self.recording.append(Command.Escape, doc.applied, doc.applied)
            }
            else => {
                on command {
                    Escape => {
                        current := ^self.workspace.active_view().interaction
                        on current.state == state && current.selection.anchor == selection.anchor && current.selection.active == selection.active => return
                    }
                    else => {
                    }
                }
                self.recording.append(command, before, doc.applied)
            }
        }
    }
    execute_inner :: fn (self: ^Self, scratch: ^arena, command: Command) -> void\string {
        on self.confirmation.active => {
            on command {
                Escape => self.confirm_replace(scratch, 27)?
                InsertText(text) => {
                    on text.count == 1 => self.confirm_replace(scratch, text[0].as(u32))?
                }
                else => {
                }
            }
            return
        }
        on command {
            NewBuffer => {
                on self.prompt_kind != 0 => self.prompt_cancel()
                self.workspace.add_empty()
                self.changed()
                return
            }
            BufferPicker => {
                self.open_buffer_picker(scratch)
                return
            }
            FilePicker => {
                on self.prompt_kind == 0 => self.open_file_picker()?
                return
            }
            ClosePane => {
                on self.prompt_kind != 0 => self.prompt_cancel()
                self.workspace.active_view().interaction.state = Interaction.Normal
                self.pane_operation(LeaderOperation.ClosePane)?
                self.workspace.active_view().interaction.state = Interaction.Normal
                return
            }
            else => {
            }
        }
        text_view := self.workspace.active_view()
        view := ^text_view.interaction
        entry := self.workspace.active_document()
        doc := ^entry.text
        -- These are state-changing command kinds, not a blanket Ctrl rule.
        on command {
            Save, Undo, Redo, Duplicate => view.state = Interaction.Normal else => {
            }
        }
        on self.prompt_kind != 0 => {
            on self.completion.active => {
                on command {
                    Escape => {
                        self.completion.reset()
                        return
                    }
                    Tab => {
                        self.complete_prompt(scratch)?
                        return
                    }
                    InsertText(text) => {
                        on text == "\n" => {
                            self.accept_completion(scratch)
                            return
                        }
                    }
                    Move {
                        direction, count: _, extend: _
                    }
                    => {
                        on direction == Direction.Up || direction == Direction.Down => {
                            on self.completion.items.count == 0 => return
                            selected := self.completion.selected
                            self.completion.selected = on direction == Direction.Down {
                                yes => (selected + 1) % self.completion.items.count
                                else => on selected > 0 {
                                    yes => selected - 1 else => self.completion.items.count - 1
                                }
                            }
                            return
                        }
                    }
                    else => {
                    }
                }
                on command {
                    InsertText(text) => {
                        on text == "\n" => self.completion.reset()
                    }
                    Backspace, DeleteWordBack, Delete => {
                    }
                    else => self.completion.reset()
                }
            }
            on command {
                Tab => {
                    on self.prompt_kind == ':'.as(u32) => self.complete_prompt(scratch)?
                    return
                }
                Escape => {
                    self.prompt_cancel()
                    return
                }
                InsertText(text) => {
                    on text == "\n" {
                        yes => {
                            on self.prompt_kind == ':'.as(u32) {
                                yes => self.command_line(scratch)? else => self.finish_slash(scratch)?
                            }
                        }
                        else => self.prompt_insert(text)
                    }
                    return
                }
                Backspace => {
                    self.prompt_delete(yes)
                    return
                }
                DeleteWordBack => {
                    self.prompt_delete(yes, word = yes)
                    return
                }
                Delete => {
                    self.prompt_delete(no)
                    return
                }
                Move {
                    direction, count, extend
                }
                => {
                    on self.prompt_kind == ':'.as(u32) => {
                        on direction {
                            Left => self.prompt_caret = previous_character(bytes_text(self.prompt), self.prompt_caret)
                            Right => self.prompt_caret = next_character(bytes_text(self.prompt), self.prompt_caret)
                            Home, First => self.prompt_caret = 0
                            End, Last => self.prompt_caret = self.prompt.count
                            else => {
                            }
                        }
                        return
                    }
                    self.prompt_cancel()
                    view.move(doc, direction, count, extend)
                    self.dirty = yes
                    return
                }
                Save, Undo, Redo, Duplicate => self.prompt_cancel()
                else => return
            }
        }
        old_revision := doc.storage.revision()
        old_applied := doc.applied
        old_caret := view.selection.active
        invoking_view := self.workspace.surface.view_id
        on command {
            Move {
                direction, count, extend
            }
            => {
                view.move(doc, direction, count, extend)
                self.highlights = no
                self.active_match = nil
                self.dirty = yes
            }
            Escape => {
                on self.message.count > 0 {
                    yes => self.message.clear() else => {
                        on text_view.keyboard.count > 0 {
                            yes => text_view.keyboard.count = 0 else => {
                                on view.state == Interaction.Insert {
                                    yes => view.state = Interaction.Normal else => view.selection.collapse(view.selection.active)
                                }
                                self.highlights = no
                                self.active_match = nil
                            }
                        }
                    }
                }
                self.dirty = yes
            }
            EnterInsert(key) => {
                view.state = Interaction.Insert
                on key != 'i'.as(u32) => {
                    position := view.selection.active
                    line := doc.line_at(position)
                    view.selection.collapse(position)
                    on key {
                        'a'.as(u32) => {
                            on position < doc.line_end(line) => position = next_character(doc.text(), position)
                        }
                        'A'.as(u32) => position = doc.line_end(line)
                        'I'.as(u32) => position = doc.first_text(line)
                        'o'.as(u32) => {
                            position = doc.line_end(line)
                            on doc.edit({
                                start: position end: position
                            }
                            , entry.line_ending(line)) {
                                change => position += change.inserted_bytes _error! => return "Cannot open line"!
                            }
                        }
                        'O'.as(u32) => {
                            position = doc.line_start(line)
                            on doc.edit({
                                start: position end: position
                            }
                            , entry.line_ending(line)) {
                                _change => {
                                }
                                _error! => return "Cannot open line"!
                            }
                        }
                        else => {
                        }
                    }
                    view.place(doc, position, no)
                }
                self.dirty = yes
            }
            InsertText(text) => {
                on view.state != Interaction.Insert => return "Enter Insert "
                    +"before typing text"!
                payload := on text == "\n" {
                    yes => entry.line_ending(doc.line_at(view.selection.active)) else => text
                }
                on view.replace_selection(doc, payload) {
                    _success => {
                    }
                    _error! => return "Cannot insert text"!
                }
            }
            Tab => {
                on view.state != Interaction.Insert => return "Tab is only "
                    +"available in Insert"!
                spaces := "        "
                on view.replace_selection(doc, spaces[.. self.indent_width()]) {
                    _success => {
                    }
                    _error! => return "Cannot insert indentation"!
                }
            }
            DeleteLines(count) => {
                line := doc.line_at(view.selection.active)
                remaining := doc.lines.count - line
                amount := on count < remaining {
                    yes => count else => remaining
                }
                end_line := line + amount
                start := doc.line_start(line)
                end := on end_line < doc.lines.count {
                    yes => doc.line_start(end_line)
                    else => doc.text().count
                }
                -- An unterminated final line (including a trailing empty line)
                -- owns the separator before it when there is no following line.
                on end_line == doc.lines.count && line > 0 => start = doc.line_end(line - 1)
                view.selection = Selection {
                    anchor: start active: end
                }
                on view.replace_selection(doc, "") {
                    _success => {
                    }
                    _error! => return "Cannot delete lines"!
                }
                view.state = Interaction.Normal
            }
            Backspace, Delete, DeleteWordBack => {
                on view.state == Interaction.Normal && view.selection.empty() => {
                    on command {
                        Backspace, DeleteWordBack => return
                        else => {
                        }
                    }
                }
                on view.selection.empty() => {
                    position := view.selection.active
                    on command {
                        Backspace => {
                            start := previous_character(doc.text(), position)
                            on start < doc.line_start(0) => start = doc.line_start(0)
                            line := doc.line_at(position)
                            leading := position <= doc.first_text(line)
                            trailing := position == doc.line_end(line)
                            width := self.indent_width()
                            on (leading || trailing) && position >= width && position - width >= doc.line_start(line) => {
                                spaces := yes
                                for index in [position - width .. position] {
                                    on doc.content[index] != ' ' => spaces = no
                                }
                                on spaces => start = position - width
                            }
                            view.selection.anchor = start
                        }
                        DeleteWordBack => view.move(doc, Direction.WordBack, 1, yes)
                        else => view.selection.anchor = next_character(doc.text(), position)
                    }
                }
                on view.replace_selection(doc, "") {
                    _success => {
                    }
                    _error! => return "Cannot delete text"!
                }
            }
            Undo => {
                on doc.undo_edit() {
                    change => {
                        position := on doc.history[doc.applied].caret_before {
                            caret => caret else => change.range.start
                        }
                        view.place(doc, position, no)
                    }
                    else => self.tell("Nothing to undo")
                }
            }
            Redo => {
                on doc.redo_edit() {
                    change => {
                        position := on doc.history[doc.applied - 1].caret_after {
                            caret => caret else => change.range.start
                        }
                        view.place(doc, position, no)
                    }
                    else => self.tell("Nothing to redo")
                }
            }
            Duplicate => {
                on self.duplicate(scratch) {
                    _success => {
                    }
                    _error! => return "Cannot duplicate line"!
                }
            }
            SelectWord(count) => view.select_word(doc, count)
            SelectLine(count) => view.select_line(doc, count)
            Copy, Cut => {
                on view.selection.empty() => return "No selection"!
                own(^self.clipboard.bytes, doc.text()[view.selection.start() .. view.selection.end()])
                self.clipboard.linewise = view.linewise
                on command {
                    Cut => {
                        on view.replace_selection(doc, "") {
                            _success => {
                            }
                            _error! => return "Cannot cut selection"!
                        }
                    } else => {
                    }
                }
            }
            Paste => {
                on self.clipboard.bytes.count == 0 => return "Clipboard is "
                    +"empty"!
                payload := bytes_text(self.clipboard.bytes)
                on self.clipboard.linewise && view.selection.empty() => {
                    line := doc.line_at(view.selection.active)
                    position := doc.text().count
                    on line + 1 < doc.lines.count {
                        yes => {
                            position = doc.line_start(line + 1)
                            on payload[payload.count - 1] != '\n' => payload = scratch.pr($"{payload}{entry.line_ending(line)}")
                        }
                        else => payload = scratch.pr($"{entry.line_ending(line)}{payload}")
                    }
                    view.selection.collapse(position)
                }
                on view.replace_selection(doc, payload) {
                    _success => {
                    }
                    _error! => return "Cannot paste"!
                }
            }
            Change => {
                on view.replace_selection(doc, "") {
                    _success => {
                    }
                    _error! => return "Cannot change selection"!
                }
                view.state = Interaction.Insert
            }
            Save => {
                on entry.path.count == 0 {
                    yes => self.prompt_open(':'.as(u32), initial = "w ") else => {
                        self.workspace.save(scratch, text_view.document_id, "", no, no)?
                        self.dirty = yes
                        self.tell("Saved")
                    }
                }
            }
            Prompt(kind) => self.prompt_open(kind)
            SearchNext(backwards) => self.find_next(backwards)?
            Error(message) => return message!
        }
        on doc.storage.revision() != old_revision => {
            undone := doc.applied < old_applied
            record_index := on undone {
                yes => doc.applied else => doc.applied - 1
            }
            record := ^doc.history[record_index]
            on command {
                Undo, Redo => {
                }
                else => {
                    record.caret_before = old_caret
                    record.caret_after = view.selection.active
                }
            }
            removed := on undone {
                yes => record.added.count else => record.removed.count
            }
            inserted := on undone {
                yes => record.removed.count else => record.added.count
            }
            change := TextChange {
                range: {
                    start: record.start end: record.start + removed
                }
                inserted_bytes: inserted
                before_revision: old_revision
                after_revision: doc.storage.revision()
            }
            self.notify_others(text_view.document_id, invoking_view, change)
            self.changed()
        }
        -- A replay can change text and then restore it. Its single zero-net
        -- history unit still has an applied/redo state that must be checkpointed.
        on doc.applied != old_applied => self.dirty = yes
    }
    pub cancel_leader :: fn (self: ^Self) {
        self.leader = no
        self.leader_shown = no
        self.leader_prefix = ""
    }
    pub poll_leader :: fn (self: ^Self, current: Instant) {
        on self.leader && !self.leader_shown && elapsed(self.leader_started, current) >= from_ms(1000) => {
            self.leader_shown = yes
            self.leader_revealed = current
        }
    }
    pub pane_operation :: fn (self: ^Self, operation: LeaderOperation) -> void\string {
        on operation {
            SplitHorizontal => self.workspace.split_pane(SplitAxis.Columns)?
            SplitVertical => self.workspace.split_pane(SplitAxis.Rows)?
            SplitAutomatic => self.workspace.split_pane(SplitAxis.Automatic)?
            ClosePane => self.workspace.close_pane()
            SplitPicker => {
                self.workspace.panes.ensure(self.workspace.surface.view_id)
                self.open_file_picker()?
                self.splitting_file = yes
                self.split_origin = self.workspace.panes.focused
            }
            FocusLeft => self.workspace.focus_pane(Direction.Left)
            FocusDown => self.workspace.focus_pane(Direction.Down)
            FocusUp => self.workspace.focus_pane(Direction.Up)
            FocusRight => self.workspace.focus_pane(Direction.Right)
            else => {
            }
        }
        self.changed()
    }

    pub leader_character :: fn (self: ^Self, rune: u32) {
        on leader_choice(LEADER_ENTRIES[..], self.leader_prefix, rune) {
            entry => on entry.operation {
                Group => {
                    self.leader_prefix = entry.sequence
                    on !self.leader_shown => {
                        self.leader_shown = yes
                        self.leader_revealed = now()
                    }
                }
                FilePicker => {
                    self.cancel_leader()
                    on self.open_file_picker() {
                        _success => {
                        }
                        error! => self.tell(error)
                    }
                }
                operation => {
                    self.cancel_leader()
                    on self.pane_operation(operation) {
                        _success => {
                        }
                        error! => self.tell(error)
                    }
                }

            }
            else => {
                self.cancel_leader()
                on rune != 27 => self.tell("Unknown Space sequence")
            }
        }
    }
    -- Invalid continuations cancel the prefix without an intermediate edit.
    pub reject_delete :: fn (self: ^Self) -> void\string {
        count := self.workspace.active_view().keyboard.delete_count
        self.workspace.active_view().keyboard.delete_count = 0
        on count == 0 => return
        return "Expected d to delete lines; Escape cancels"!
    }
    pub key :: fn (self: ^Self, scratch: ^arena, key: TermKeyEvent) {
        on self.diagnostics.active => {
            on (key.modifiers & TERM_MOD_ALT) != 0 && key.action != TermKeyAction.Release => {
                on key.scan_code {
                    PageUp => {
                        on self.message_scroll > 0 => self.message_scroll -= 1
                        return
                    }
                    PageDown => {
                        self.message_scroll += 1
                        return
                    }
                    else => {
                    }
                }
            }
            on key.scan_code == TermScanCode.Escape && key.action != TermKeyAction.Release {
                yes => {
                    self.diagnostics.active = no
                    self.workspace.active_view().keyboard.suppress_text = key.character != nil
                    self.tell("Keyboard diagnostics closed")
                }
                else => {
                    self.diagnostics.record(scratch, TermInputEvent.Key(key))
                    self.tell(self.diagnostics.message(scratch))
                }
            }
            return
        }
        -- Diagnostics must observe releases; ordinary UI/command handlers must not.
        on key.action == TermKeyAction.Release => return
        on self.overwrite.active => {
            on key.scan_code == TermScanCode.Escape => {
                self.suppress_character = key.character != nil
                on self.confirm_save(scratch, 27) {
                    _success => {
                    }
                    error! => self.tell(error)
                }
            }
            on (key.modifiers & (TERM_MOD_CONTROL | TERM_MOD_ALT)) != 0 => self.suppress_character = key.character != nil
            return
        }
        cancel := key.scan_code == TermScanCode.G && (key.modifiers & TERM_MOD_CONTROL) != 0
        on key.character => [rune] {
            cancel = cancel || rune == 7
        }
        on self.recording.active && cancel => {
            self.suppress_character = key.character != nil
            self.cancel_recording()
            return
        }
        on self.workspace.active_view().keyboard.delete_count > 0 => {
            on key.scan_code == TermScanCode.Escape => {
                self.workspace.active_view().keyboard.delete_count = 0
                self.suppress_character = key.character != nil
                return
            }
            printable := no
            on key.character => [rune] {
                printable = rune >= 32 && rune != 127 && (key.modifiers & (TERM_MOD_CONTROL | TERM_MOD_ALT)) == 0
            }
            on !printable => on self.reject_delete() {
                _success => {
                }
                error! => {
                    self.tell(error)
                    self.suppress_character = key.character != nil
                    return
                }
            }
        }
        on key.scan_code == TermScanCode.Space && key.modifiers == 0 && self.prompt_kind == 0 && !self.picker.active && !self.confirmation.active && self.workspace.active_view().interaction.state == Interaction.Normal => {
            on key.action == TermKeyAction.Repeat => {
                on key.character != nil => self.suppress_character = yes
                return
            }
            on key.character == nil => {
                self.character(scratch, 32)
                return
            }
        }
        on self.leader => {
            on key.action == TermKeyAction.Repeat => {
                self.suppress_character = key.character != nil
                return
            }
            on key.modifiers == 0 && self.leader_prefix.count == 0 => {
                direction : ?Direction = on key.scan_code {
                    ArrowLeft => Direction.Left
                    ArrowRight => Direction.Right
                    ArrowUp => Direction.Up
                    ArrowDown => Direction.Down
                    else => nil
                }
                on direction => [towards] {
                    self.cancel_leader()
                    self.workspace.focus_pane(towards)
                    self.changed()
                    self.suppress_character = key.character != nil
                    return
                }
            }
            on key.modifiers == 0 && (key.scan_code == TermScanCode.Backspace || (key.scan_code == TermScanCode.Delete && key.character == 127.as(u32))) => {
                on self.leader_prefix.count > 0 => self.leader_prefix = self.leader_prefix[.. self.leader_prefix.count - 1]
                self.suppress_character = key.character != nil
                return
            }
            on key.modifiers == 0 => {
                on key.character {
                    rune => {
                        -- The paired character event dispatches the sequence.
                        on rune >= 32 && rune != 127 => return
                    }
                    else => on key.label => [rune] {
                        on rune >= 32 && rune != 127 => {
                            self.leader_character(rune)
                            return
                        }
                    }
                }
            }
            self.cancel_leader()
            self.suppress_character = key.character != nil
            return
        }
        on self.picker.active => {
            self.picker_key(scratch, key)
            return
        }
        on self.confirmation.active => {
            on key.scan_code == TermScanCode.Escape => self.finish_confirmation(scratch, "Stopped after")
            return
        }
        on self.message.count > 0 && self.prompt_kind == 0 && (key.modifiers & TERM_MOD_ALT) != 0 => {
            on key.scan_code {
                PageUp => {
                    on self.message_scroll > 0 => self.message_scroll -= 1
                    return
                }
                PageDown => {
                    self.message_scroll += 1
                    return
                } else => {
                }
            }
        }
        on self.workspace.active_view().keyboard.key(key) => [command] {
            -- The command may switch or destroy this view before its paired
            -- text event arrives. Suppression belongs to the input stream.
            on self.workspace.active_view().keyboard.suppress_text => {
                self.workspace.active_view().keyboard.suppress_text = no
                self.suppress_character = yes
            }
            on self.execute(scratch, command) {
                _success => {
                }
                error! => self.tell(error)
            }
        }
    }
    pub character :: fn (self: ^Self, scratch: ^arena, rune: u32) {
        on self.suppress_character => {
            self.suppress_character = no
            return
        }
        on self.overwrite.active => {
            on self.confirm_save(scratch, rune) {
                _success => {
                }
                error! => self.tell(error)
            }
            return
        }
        on self.recording.active && rune == 7 => {
            self.cancel_recording()
            return
        }
        on self.picker.active => {
            on rune == 23 => {
                on !self.picking_files => self.close_picked_buffer(scratch)
                return
            }
            on rune >= 32 && rune != 127 => {
                encoded: [4]u8
                size := rune.as(Rune).utf8_encode(encoded[..])
                self.picker.insert(encoded[.. size].as(string))
            }
            return
        }
        on self.diagnostics.active => {
            self.diagnostics.record(scratch, TermInputEvent.Character(rune))
            self.tell(self.diagnostics.message(scratch))
            return
        }
        on self.confirmation.active => {
            on self.confirm_replace(scratch, rune) {
                _success => {
                }
                error! => self.tell(error)
            }
            return
        }
        on self.leader => {
            self.leader_character(rune)
            return
        }
        on self.workspace.active_view().keyboard.delete_count > 0 && rune != 'd'.as(u32) => {
            on rune == 27 => {
                self.workspace.active_view().keyboard.delete_count = 0
                return
            }
            on self.reject_delete() {
                _success => {
                }
                error! => {
                    self.tell(error) return
                }
            }
        }
        text_view := self.workspace.active_view()
        on rune == ' '.as(u32) && self.prompt_kind == 0 && text_view.interaction.state == Interaction.Normal => {
            on self.recording.active => {
                text_view.keyboard.count = 0
                self.tell("Space commands unavailable while recording; use ] "
                    +"to finish")
                return
            }
            on text_view.keyboard.count != 0 => {
                text_view.keyboard.count = 0
                self.tell("Command does not accept a count")
                return
            }
            self.leader = yes
            self.leader_shown = no
            self.leader_started = now()
            self.leader_prefix = ""
            return
        }
        suppressed := text_view.keyboard.suppress_text
        state := text_view.interaction.state
        on text_view.keyboard.character(rune, on self.prompt_kind != 0 {
            yes => Interaction.Insert else => state
        }
        , selected = self.prompt_kind == 0 && !text_view.interaction.selection.empty()) {
            command => {
                on self.execute(scratch, command) {
                    _success => {
                    }
                    error! => self.tell(error)
                }
                return
            }
            else => {
            }
        }
        on suppressed || rune < 32 || rune == 127 => return
        encoded: [4]u8
        size := rune.as(Rune).utf8_encode(encoded[..])
        text := encoded[.. size].as(string)
        on self.prompt_kind != 0 {
            yes => self.prompt_insert(text) else => {
                on state == Interaction.Insert => {
                    on self.execute(scratch, Command.InsertText(text)) {
                        _success => {
                        }
                        error! => self.tell(error)
                    }
                }
            }
        }
    }
    pub tick :: fn (self: ^Self, scratch: ^arena) {
        before: u64 = 0
        for entry in self.workspace.documents {
            before += entry.text.storage.revision()
        }
        on self.workspace.poll_files(scratch) {
            _success => {
            }
            error! => self.tell(error)
        }
        after: u64 = 0
        for entry in self.workspace.documents {
            after += entry.text.storage.revision()
        }
        on before != after => {
            self.changed()
            on self.recording.active && self.workspace.active_document().text.storage.revision() != self.recording.revision => {
                self.recording.active = no
                self.tell("Recording cancelled: buffer changed externally")
            }
        }
        current := now()
        on self.dirty && self.workspace.persistent && elapsed(self.checkpoint_at, current) >= from_ms(1000) && (elapsed(self.changed_at, current) >= from_ms(400) || elapsed(self.checkpoint_at, current) >= from_ms(2000)) => {
            on self.workspace.checkpoint(scratch) {
                _success => self.dirty = no error! => self.tell(error)
            }
            self.checkpoint_at = current
        }
        -- Monitoring/checkpoint messages must not hide a pending decision.
        on self.overwrite.active => self.show_save_confirmation(scratch)
    }
}

test {
    use codec

    use os.linux

    exercise_completion :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        startup := cwd(^scratch)?
        folder := scratch.pr($"{startup}/_tmp/completion-{syscall(SYS_GETPID, 0, 0, 0, 0, 0, 0)}")

        assert make_directory(^scratch, "_tmp")
        assert make_directory(^scratch, folder)
        names := ["alpha.txt", "alpine.txt", ".hidden", "space name ", "é.txt", "è.txt"]
        defer {
            for name in names {
                path := scratch.pr($"{folder}/{name^}")
                _ := syscall(SYS_UNLINK, path.c_string().as(usize).as(u64), 0, 0, 0, 0, 0)
            }
            _ := syscall(SYS_UNLINK, scratch.pr($"{folder}/linked").c_string().as(usize).as(u64), 0, 0, 0, 0, 0)
            _ := syscall(SYS_RMDIR, scratch.pr($"{folder}/nested").c_string().as(usize).as(u64), 0, 0, 0, 0, 0)
            _ := syscall(SYS_RMDIR, folder.c_string().as(usize).as(u64), 0, 0, 0, 0, 0)
        }
        for name in names {
            atomic_write(^scratch, scratch.pr($"{folder}/{name^}"), "original", no)?
        }
        assert make_directory(^scratch, scratch.pr($"{folder}/nested"))
        assert syscall(SYS_SYMLINK, "nested".c_string().as(usize).as(u64), scratch.pr($"{folder}/linked").c_string().as(usize).as(u64), 0, 0, 0, 0) == 0
        state : PromptCompletion
        defer state.release()
        state.scan(folder, "al")?
        assert state.items.count == 2
        assert state.items[0] == "alpha.txt" && state.items[1] == "alpine.txt"
        assert state.common_prefix() == "alp"
        state.scan(folder, "")?
        assert state.items.count == 7
        state.scan(folder, ".")?
        assert state.items.count == 1 && state.items[0] == ".hidden"
        state.scan(folder, "ne")?
        assert state.items.count == 1 && state.items[0] == "nested/"
        state.scan(folder, "li")?
        assert state.items.count == 1 && state.items[0] == "linked/"
        state.scan(folder, scratch.pr($"{folder}/al"))?
        assert state.common_prefix() == scratch.pr($"{folder}/alp")
        state.scan(folder, "none")?
        assert state.items.count == 0
        on state.scan(folder, "missing/") {
            _success => {
                assert no
            }

            _error! => {
                assert !state.active && state.items.count == 0
            }
        }
        cached := scratch.pr($"{folder}/cached-only.txt")
        atomic_write(^scratch, cached, "cached", no)?
        state.scan(folder, "cached")?
        assert state.items.count == 1
        assert syscall(SYS_UNLINK, cached.c_string().as(usize).as(u64), 0, 0, 0, 0, 0) == 0
        state.filter_files(folder, "cache")?
        assert state.items.count == 1
        -- Filtering uses the directory snapshot, not more I/O.
        state.scan(folder, "cache")?
        assert state.items.count == 0
        editor : Editor
        editor.workspace.lock_fd = - 1
        defer editor.release()
        own(^editor.workspace.folder, folder)
        editor.workspace.open_file(^scratch, "alpha.txt")?
        editor.execute(^scratch, Command.EnterInsert('i'.as(u32)))?
        editor.execute(^scratch, Command.InsertText("dirty"))?
        editor.prompt_open(':'.as(u32), initial = "e al")
        editor.execute(^scratch, Command.Tab)?
        assert bytes_text(editor.prompt) == "e alp"
        assert editor.completion.active
        editor.execute(^scratch, Command.Move {
            direction: Direction.Up count: 1 extend: no
        })?
        assert editor.completion.selected == 1
        editor.execute(^scratch, Command.Move {
            direction: Direction.Up count: 1 extend: no
        })?
        assert editor.completion.selected == 0
        editor.execute(^scratch, Command.Move {
            direction: Direction.Down count: 1 extend: no
        })?
        editor.execute(^scratch, Command.InsertText("\n"))?
        assert bytes_text(editor.prompt) == "e alpine.txt" && !editor.completion.active
        assert editor.workspace.documents.count == 1
        editor.execute(^scratch, Command.InsertText("\n"))?
        assert editor.workspace.documents.count == 2
        editor.prompt_open(':'.as(u32), initial = "e alpha.txt")
        editor.command_line(^scratch)?
        assert editor.workspace.documents.count == 2
        assert editor.workspace.active_document().text.text() == "dirtyoriginal"
        editor.prompt_open(':'.as(u32), initial = "e al")
        editor.execute(^scratch, Command.Tab)?
        editor.execute(^scratch, Command.Escape)?
        assert editor.prompt_kind == ':'.as(u32) && bytes_text(editor.prompt) == "e"
            +" alp"

        editor.prompt_insert("ha.txt")
        editor.command_line(^scratch)?
        assert editor.workspace.documents.count == 2
        editor.prompt_open(':'.as(u32), initial = "e spa")
        editor.execute(^scratch, Command.Tab)?
        assert bytes_text(editor.prompt) == "e space name "
        editor.command_line(^scratch)?
        assert editor.workspace.documents.count == 3
        assert bytes_text(editor.workspace.active_document().path) == scratch.pr($"{folder}/space name ")
        editor.prompt_open(':'.as(u32), initial = "e nested/")
        on editor.command_line(^scratch) {
            _success => {
                assert no
            }

            _error! => {
            }
        }
        assert editor.workspace.documents.count == 3
        editor.prompt_open(':'.as(u32), initial = "e none")
        editor.execute(^scratch, Command.Tab)?
        assert bytes_text(editor.prompt) == "e none"
        assert bytes_text(editor.message) == "No filename match"
        appeared := scratch.pr($"{folder}/none")
        atomic_write(^scratch, appeared, "appeared", no)?
        editor.execute(^scratch, Command.Tab)?
        assert editor.message.count == 0
        -- A fresh Tab after no matches refreshes discovery.
        assert syscall(SYS_UNLINK, appeared.c_string().as(usize).as(u64), 0, 0, 0, 0, 0) == 0
        editor.prompt_open(':'.as(u32), initial = "e al")
        editor.execute(^scratch, Command.Tab)?
        editor.execute(^scratch, Command.Tab)?
        assert editor.completion.selected == 1
        editor.prompt_insert("h")
        assert editor.completion.active && editor.completion.items.count == 1
        assert bytes_text(editor.prompt) == "e alph"
        editor.prompt_insert("z")
        assert editor.completion.active && editor.completion.items.count == 0
        editor.execute(^scratch, Command.Tab)?
        editor.execute(^scratch, Command.Move {
            direction: Direction.Down count: 1 extend: no
        })?
        editor.execute(^scratch, Command.InsertText("\n"))?
        assert editor.prompt_kind == ':'.as(u32) && bytes_text(editor.prompt) == "e"
            +" alphz"

        editor.prompt_delete(yes)
        assert editor.completion.active && editor.completion.items.count == 1
        editor.prompt_delete(yes)
        assert bytes_text(editor.prompt) == "e alp" && editor.completion.items.count == 2
        editor.prompt_delete(yes)
        editor.prompt_delete(yes)
        editor.prompt_delete(yes)
        assert bytes_text(editor.prompt) == "e " && editor.completion.items.count == 7
        editor.prompt_open(':'.as(u32), initial = "w spa")
        editor.execute(^scratch, Command.Tab)?
        assert bytes_text(editor.prompt) == "w space name "
    }

    exercise_commands :: fn () -> void\string {
        editor : Editor
        editor.workspace.lock_fd = - 1
        defer editor.release()
        scratch : arena
        defer scratch.done()
        editor.workspace.add_empty()
        own(^editor.workspace.folder, "/no-such-completion-folder")
        editor.prompt_open(':'.as(u32))
        editor.execute(^scratch, Command.Tab)?
        assert editor.completion.active && editor.completion.items.count == 15
        assert bytes_text(editor.prompt) == ""
        editor.prompt_insert("e")
        assert bytes_text(editor.prompt) == "e"
        assert editor.completion.active && editor.completion.items.count == 1
        editor.prompt_insert("z")
        assert editor.completion.active && editor.completion.items.count == 0
        editor.execute(^scratch, Command.Tab)?
        editor.execute(^scratch, Command.Move {
            direction: Direction.Up count: 1 extend: no
        })?
        editor.execute(^scratch, Command.InsertText("\n"))?
        assert bytes_text(editor.prompt) == "ez" && editor.prompt_kind == ':'.as(u32)
        editor.prompt_delete(yes)
        assert editor.completion.active && editor.completion.items.count == 1
        editor.execute(^scratch, Command.InsertText("\n"))?
        assert bytes_text(editor.prompt) == "e" && editor.prompt_kind == ':'.as(u32)
        editor.prompt_open(':'.as(u32), initial = "  wq")
        editor.execute(^scratch, Command.Tab)?
        assert bytes_text(editor.prompt) == "  wq" && !editor.completion.active
        editor.prompt_open(':'.as(u32), initial = "bu")
        editor.execute(^scratch, Command.Tab)?
        assert bytes_text(editor.prompt) == "buffer" && editor.completion.items.count == 2
        editor.prompt_insert("s")
        assert editor.completion.active && editor.completion.items.count == 1
        editor.execute(^scratch, Command.InsertText("\n"))?
        assert editor.prompt_kind == ':'.as(u32)
        editor.execute(^scratch, Command.InsertText("\n"))?
        assert editor.prompt_kind == 0 && editor.workspace.documents.count == 1
        editor.prompt_open(':'.as(u32), initial = "q")
        editor.execute(^scratch, Command.Tab)?
        editor.execute(^scratch, Command.Move {
            direction: Direction.Down count: 1 extend: no
        })?
        editor.execute(^scratch, Command.InsertText("\n"))?
        assert bytes_text(editor.prompt) == "q!" && !editor.quit
        editor.execute(^scratch, Command.Escape)?
        assert !editor.quit && editor.workspace.documents.count == 1
        editor.prompt_open(':'.as(u32), initial = "e")
        editor.execute(^scratch, Command.Tab)?
        assert bytes_text(editor.prompt) == "e" && !editor.completion.active
        editor.prompt_open(':'.as(u32), initial = "zzz")
        editor.execute(^scratch, Command.Tab)?
        assert bytes_text(editor.message) == "No command match"
        assert bytes_text(editor.prompt) == "zzz"
        editor.prompt_open(':'.as(u32), initial = "bu")
        editor.execute(^scratch, Command.Tab)?
        editor.prompt_insert(" 1")
        assert !editor.completion.active  -- Leave command-name completion for numeric arguments.
        assert editor.workspace.active_document().text.text() == ""
        assert editor.workspace.active_document().text.history.count == 0
    }

    check_duplicate :: fn (text : string,
    anchor : usize,
    active : usize,
    linewise : bool,
    expected : string,
    start : usize,
    end : usize) -> void\string {
        editor : Editor
        editor.workspace.lock_fd = - 1
        defer editor.release()
        scratch : arena
        defer scratch.done()
        editor.workspace.add_empty()
        doc := ^editor.workspace.active_document().text
        on doc.load(text) {
            _success => {
            }

            _error! => return "Duplicate fixture failed"!
        }
        view := ^editor.workspace.active_view().interaction
        view.selection.anchor = anchor
        view.selection.active = active
        view.linewise = linewise
        editor.execute(^scratch, Command.Duplicate)?
        assert doc.text() == expected
        assert doc.history.count == 1 && doc.applied == 1
        assert view.state == Interaction.Normal
        assert view.selection.start() == start && view.selection.end() == end
        assert view.linewise == (linewise && anchor != active)
        on linewise && anchor != active => {
            assert (view.selection.active < view.selection.anchor) == (active < anchor)
        }
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == text
        editor.execute(^scratch, Command.Redo)?
        assert doc.text() == expected
    }

    exercise_duplicate :: fn () -> void\string {
        check_duplicate("a\nb\nc", 0, 4, yes, "a\nb\na\nb\nc", 4, 8)?
        check_duplicate("a\nb\nc", 4, 0, yes, "a\nb\na\nb\nc", 4, 8)?
        check_duplicate("a\nb", 0, 3, yes, "a\nb\na\nb", 4, 7)?
        check_duplicate("""
            a
            b
            """, 0, 4, yes, """
            a
            b
            a
            b
            """, 4, 8)?
        check_duplicate("a\r\nb\nc", 0, 5, yes, "a\r\nb\na\r\nb\nc", 5, 10)?
        check_duplicate("﻿abc\nz", 3, 7, yes, "﻿abc\nabc\nz", 7, 11)?
        check_duplicate("abc\nlong\nz", 0, 6, no, "abc\nlong\nlong\nz", 11, 11)?
        check_duplicate("abc\nlong\nz", 6, 1, no, "abc\nabc\nlong\nz", 5, 5)?
        check_duplicate("", 0, 0, no, "\n", 1, 1)?
        check_duplicate("""
            a
            """, 2, 2, yes, """
            a
            
            """, 3, 3)?
    }

    exercise_bom :: fn () -> void\string {
        editor : Editor
        editor.workspace.lock_fd = - 1
        defer editor.release()
        scratch : arena
        defer scratch.done()
        editor.workspace.add_empty()
        doc := ^editor.workspace.active_document().text
        on doc.load("﻿alpha\r\nbeta") {
            _success => {
            }

            _error! => return "BOM fixture failed"!
        }
        view := ^editor.workspace.active_view().interaction
        view.place(doc, 0, no)
        assert view.selection.active == 3
        assert doc.line_start(0) == 3
        editor.execute(^scratch, Command.Backspace)?
        assert doc.text() == "﻿alpha\r\nbeta"
        editor.execute(^scratch, Command.InsertText("X"))?
        assert doc.text() == "﻿Xalpha\r\nbeta"
        editor.execute(^scratch, Command.Move {
            direction: Direction.First count: 1 extend: no
        })?
        editor.execute(^scratch, Command.SelectLine(1))?
        editor.execute(^scratch, Command.Copy)?
        assert bytes_text(editor.clipboard.bytes) == "Xalpha\r\n"
        editor.execute(^scratch, Command.Move {
            direction: Direction.First count: 1 extend: no
        })?
        editor.execute(^scratch, Command.Duplicate)?
        assert doc.text() == "﻿Xalpha\r\nXalpha\r\nbeta"
        editor.execute(^scratch, Command.Prompt('/'.as(u32)))?
        editor.character(^scratch, 0xfeff)
        assert editor.active_match == nil
    }

    exercise_other_view :: fn () -> void\string {
        editor : Editor
        editor.workspace.lock_fd = - 1
        defer editor.release()
        scratch : arena
        defer scratch.done()
        editor.workspace.add_empty()
        doc := ^editor.workspace.active_document().text
        on doc.load("abc") {
            _success => {
            }

            _error! => return "Shared view fixture failed"!
        }
        other : TextView
        other.document_id = 0
        other.interaction.selection.collapse(3)
        editor.workspace.views.push(other)
        editor.execute(^scratch, Command.InsertText("Z"))?
        assert editor.workspace.views[1].interaction.selection.active == 4
        editor.execute(^scratch, Command.Undo)?
        assert editor.workspace.views[1].interaction.selection.active == 3
        editor.execute(^scratch, Command.Redo)?
        assert editor.workspace.views[1].interaction.selection.active == 4
        editor.workspace.views[1].interaction.selection.collapse(0)
        editor.execute(^scratch, Command.Move {
            direction: Direction.First count: 1 extend: no
        })?
        editor.execute(^scratch, Command.EnterInsert('i'.as(u32)))?
        editor.execute(^scratch, Command.InsertText("X"))?
        assert editor.workspace.views[1].interaction.selection.active == 0
        on doc.load("a\n b\n c") {
            _success => {
            }

            _error! => return "Jump fixture failed"!
        }
        editor.prompt_open(':'.as(u32),
        initial = "999999999999999999999999999999999")
        editor.command_line(^scratch)?
        assert editor.workspace.active_view().interaction.selection.active == 6
    }

    exercise_editor :: fn () -> void\string {
        editor : Editor
        editor.workspace.lock_fd = - 1
        defer editor.release()
        scratch : arena
        defer scratch.done()
        editor.workspace.add_empty()
        editor.character(^scratch, 'a'.as(u32))
        editor.character(^scratch, 'b'.as(u32))
        assert editor.workspace.active_document().text.text() == "ab"
        assert editor.workspace.active_document().text.history.count == 2
        editor.execute(^scratch, Command.Undo)?
        assert editor.workspace.active_document().text.text() == "a"
        assert editor.workspace.active_view().interaction.state == Interaction.Normal
        editor.execute(^scratch, Command.Redo)?
        editor.execute(^scratch, Command.Move {
            direction: Direction.First count: 1 extend: no
        })?
        editor.execute(^scratch, Command.SelectWord(1))?
        editor.execute(^scratch, Command.EnterInsert('i'.as(u32)))?
        editor.character(^scratch, 'x'.as(u32))
        assert editor.workspace.active_document().text.text() == "x"
        editor.execute(^scratch, Command.Escape)?
        editor.execute(^scratch, Command.Duplicate)?
        assert editor.workspace.active_document().text.text() == "x\nx"
        assert editor.workspace.active_view().interaction.selection.active == 3
        editor.execute(^scratch, Command.Undo)?
        assert editor.workspace.active_document().text.text() == "x"
        editor.execute(^scratch, Command.Move {
            direction: Direction.First count: 1 extend: no
        })?
        editor.execute(^scratch, Command.SelectLine(1))?
        editor.execute(^scratch, Command.Copy)?
        editor.execute(^scratch, Command.Move {
            direction: Direction.End count: 1 extend: no
        })?
        editor.execute(^scratch, Command.Paste)?
        assert editor.workspace.active_document().text.text() == "x\nx"
        editor.execute(^scratch, Command.Prompt('/'.as(u32)))?
        editor.character(^scratch, 'x'.as(u32))
        assert editor.highlights
        editor.execute(^scratch, Command.InsertText("\n"))?
        assert !editor.highlights
        assert editor.last_search[..].as(string) == "x"
        editor.execute(^scratch, Command.SearchNext(no))?
        assert !editor.workspace.active_view().interaction.selection.empty()
        editor.execute(^scratch, Command.Move {
            direction: Direction.Right count: 1 extend: no
        })?
        assert editor.workspace.active_view().interaction.selection.empty()
        assert !editor.highlights
        -- Escape with no accompanying character event must not swallow the next
        -- real character (traditional ESC and enhanced-keyboard Delete both do this).
        editor.execute(^scratch, Command.EnterInsert('i'.as(u32)))?
        editor.key(^scratch,
        TermKeyEvent {
            scan_code: TermScanCode.Escape action: TermKeyAction.Press ...
        })
        editor.character(^scratch, 'i'.as(u32))
        assert editor.workspace.active_view().interaction.state == Interaction.Insert
    }

    origin_prefixes :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        editor : Editor
        editor.workspace.lock_fd = - 1
        defer editor.release()
        editor.workspace.add_empty()
        doc := ^editor.workspace.active_document().text
        on doc.load("term term") {
            _success => {
            }

            _error! => {
                assert no
            }
        }
        editor.workspace.active_view().interaction.place(doc, 5, no)
        editor.prompt_open('/'.as(u32), initial = "term")
        assert editor.active_match == 5
        editor.execute(^scratch, Command.Escape)?
        assert editor.workspace.active_view().interaction.selection.active == 5
        editor.prompt_open('/'.as(u32), initial = "/term")
        assert editor.search_query() == "term" && editor.active_match == 0
        editor.finish_slash(^scratch)?
        assert doc.text() == "term term" && doc.history.count == 0
        assert editor.workspace.active_view().interaction.selection.active == 0
        editor.workspace.active_view().interaction.place(doc, 5, no)
        editor.prompt_open('/'.as(u32), initial = "/")
        assert editor.active_match == 0
        -- Empty origin query reuses the remembered search.
        editor.execute(^scratch, Command.Escape)?
        assert editor.workspace.active_view().interaction.selection.active == 5
        editor.prompt_open('?'.as(u32), initial = "?term")
        assert editor.active_match == 5
        editor.finish_slash(^scratch)?
        editor.prompt_open('/'.as(u32), initial = "/term/X")
        editor.finish_slash(^scratch)?
        assert doc.text() == "X X" && doc.history.count == 1
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == "term term"
        editor.prompt_open('/'.as(u32), initial = "/term/Y/c")
        editor.finish_slash(^scratch)?
        assert editor.confirmation.active && editor.active_match == 0
        editor.confirm_replace(^scratch, 'n'.as(u32))?
        editor.confirm_replace(^scratch, 'a'.as(u32))?
        assert doc.text() == "term Y" && doc.history.count == 1
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == "term term"
        on doc.load("src/old src/old") {
            _success => {
            }

            _error! => {
                assert no
            }
        }
        editor.workspace.active_view().interaction.place(doc, 8, no)
        editor.prompt_open('/'.as(u32), initial = "/src\\/old")
        assert editor.search_query() == "src/old" && editor.active_match == 0
        editor.execute(^scratch, Command.Escape)?
        assert editor.workspace.active_view().interaction.selection.active == 8
        assert doc.history.count == 0
        editor.prompt_open('/'.as(u32), initial = "//new")
        on editor.finish_slash(^scratch) {
            _success => {
                assert no
            }

            _error! => {
            }
        }
        assert doc.text() == "src/old src/old" && doc.history.count == 0
    }

    confirmation_history :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        editor : Editor
        editor.workspace.lock_fd = - 1
        defer editor.release()
        editor.workspace.add_empty()
        original := "one one one one"
        doc := ^editor.workspace.active_document().text

        on doc.load(original) {
            _success => {
            }

            _error! => {
                assert no
            }
        }
        editor.workspace.active_view().interaction.place(doc, original.count, no)
        editor.prompt_open('/'.as(u32), initial = "one/two")
        assert doc.text() == original
        editor.execute(^scratch, Command.Escape)?
        assert editor.workspace.active_view().interaction.selection.active == original.count
        editor.prompt_open('/'.as(u32), initial = "one/two")
        editor.execute(^scratch, Command.InsertText("\n"))?
        assert doc.text() == "two two two two" && doc.history.count == 1
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == original
        assert editor.workspace.active_view().interaction.selection.active == original.count
        editor.workspace.active_view().interaction.place(doc, 0, no)
        editor.prompt_open('/'.as(u32), initial = "one/X/c")
        editor.execute(^scratch, Command.InsertText("\n"))?
        assert editor.confirmation.active && doc.text() == original
        editor.execute(^scratch, Command.Save)?  -- Other editing commands cannot interrupt grouping.
        editor.confirm_replace(^scratch, 'n'.as(u32))?
        editor.confirm_replace(^scratch, 'y'.as(u32))?
        assert doc.text() == "one X one one"
        editor.confirm_replace(^scratch, 'y'.as(u32))?
        assert doc.text() == "one X X one" && doc.applied == 1 && doc.history.count == 1
        encoded : Encoder
        defer encoded.bytes.free()
        encoded.document(doc)
        restored : Document
        defer restored.release()
        reader := Decoder {
            bytes: bytes_text(encoded.bytes) ...
        }
        reader.document(^restored)?
        assert restored.text() == doc.text()
        on restored.undo_edit() {
            _change => {
            }

            else => {
                assert no
            }
        }
        assert restored.text() == original
        on restored.redo_edit() {
            _change => {
            }

            else => {
                assert no
            }
        }
        assert restored.text() == "one X X one"
        editor.execute(^scratch, Command.Escape)?
        assert !editor.confirmation.active && doc.text() == "one X X one"
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == original && editor.workspace.active_view().interaction.selection.active == 0
        editor.execute(^scratch, Command.Redo)?
        assert doc.text() == "one X X one"
        on doc.load("a a") {
            _success => {
            }

            _error! => {
                assert no
            }
        }
        editor.workspace.active_view().interaction.place(doc, 0, no)
        editor.prompt_open('/'.as(u32), initial = "a/a/c")
        editor.finish_slash(^scratch)?
        editor.confirm_replace(^scratch, 'a'.as(u32))?
        assert !editor.confirmation.active && doc.history.count == 0
        editor.prompt_open('/'.as(u32), initial = "a/b/c")
        editor.finish_slash(^scratch)?
        editor.confirm_replace(^scratch, 'n'.as(u32))?
        editor.confirm_replace(^scratch, 'n'.as(u32))?
        assert !editor.confirmation.active && doc.text() == "a a" && doc.history.count == 0
    }

    shared_and_search :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        editor : Editor
        editor.workspace.lock_fd = - 1
        defer editor.release()
        editor.workspace.add_empty()
        doc := ^editor.workspace.active_document().text
        on doc.load("a a a") {
            _success => {
            }

            _error! => {
                assert no
            }
        }
        other : TextView
        other.document_id = 0
        other.interaction.place(doc, 5, no)
        editor.workspace.views.push(other)
        editor.prompt_open('/'.as(u32), initial = "a/XX/c")
        editor.finish_slash(^scratch)?
        editor.confirm_replace(^scratch, 'y'.as(u32))?
        assert editor.workspace.views[1].interaction.selection.active == 6
        editor.confirm_replace(^scratch, 'n'.as(u32))?
        editor.confirm_replace(^scratch, 'a'.as(u32))?
        assert doc.text() == "XX a XX" && doc.history.count == 1
        assert editor.workspace.views[1].interaction.selection.active == 7
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == "a a a" && editor.workspace.views[1].interaction.selection.active == 5
        editor.prompt_open('/'.as(u32), initial = "a/z/c")
        editor.finish_slash(^scratch)?
        on doc.edit({
            start: doc.text().count end: doc.text().count
        }
        , "!") {
            _change => {
            }

            _error! => {
                assert no
            }
        }
        editor.confirm_replace(^scratch, 'y'.as(u32))?
        assert !editor.confirmation.active && doc.text() == "a a a!"
        on doc.load("src/old other src/old") {
            _success => {
            }

            _error! => {
                assert no
            }
        }
        editor.workspace.active_view().interaction.place(doc, 0, no)
        editor.prompt_open('/'.as(u32), initial = "src\\/old")
        assert editor.search_query() == "src/old"
        editor.finish_slash(^scratch)?
        assert doc.history.count == 0 && doc.text() == "src/old other src/old"
        editor.prompt_open('/'.as(u32), initial = "src\\/old/new")
        editor.finish_slash(^scratch)?
        assert doc.text() == "new other new" && doc.history.count == 1
        on doc.load("﻿one\r\none\t") {
            _success => {
            }

            _error! => {
                assert no
            }
        }
        editor.workspace.active_view().interaction.place(doc, doc.line_start(0), no)
        editor.prompt_open('/'.as(u32), initial = "one/long/c")
        editor.finish_slash(^scratch)?
        editor.confirm_replace(^scratch, 'Y'.as(u32))?
        editor.confirm_replace(^scratch, 'A'.as(u32))?
        assert doc.text() == "﻿long\r\nlong\t"
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == "﻿one\r\none\t"
        for replacement in ["", "aa"] {
            on doc.load("aaa") {
                _success => {
                }

                _error! => {
                    assert no
                }
            }
            editor.workspace.active_view().interaction.place(doc, 0, no)
            editor.prompt_open('/'.as(u32),
            initial = scratch.pr($"a/{replacement^}/c"))
            editor.finish_slash(^scratch)?
            editor.confirm_replace(^scratch, 'y'.as(u32))?
            editor.confirm_replace(^scratch, 'y'.as(u32))?
            editor.confirm_replace(^scratch, 'a'.as(u32))?
            expected := on replacement.count == 0 {
                yes => ""
                else => "aaaaaa"
            }
            assert doc.text() == expected && doc.history.count == 1
            editor.execute(^scratch, Command.Undo)?
            assert doc.text() == "aaa"
        }
    }

    check_caret :: fn (text : string,
    position : usize,
    command : Command,
    changed : string,
    after : usize,
    anchor : ?usize = nil) -> void\string {
        editor : Editor
        editor.workspace.lock_fd = - 1
        defer editor.release()
        scratch : arena
        defer scratch.done()
        editor.workspace.add_empty()
        doc := ^editor.workspace.active_document().text
        on doc.load(text) {
            _success => {
            }

            _error! => return "Caret fixture failed"!
        }
        view := ^editor.workspace.active_view().interaction
        view.place(doc, position, no)
        on anchor => [value] {
            view.selection.anchor = value
        }
        editor.execute(^scratch, command)?
        assert doc.text() == changed
        assert doc.history.count == 1
        assert view.selection.active == after && view.selection.empty()
        -- Navigation does not rewrite placement hints or add history entries.
        view.place(doc, doc.line_start(0), no)
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == text
        assert view.selection.active == position && view.selection.empty()
        assert view.state == Interaction.Normal
        view.place(doc, doc.text().count, no)
        editor.execute(^scratch, Command.Redo)?
        assert doc.text() == changed
        assert view.selection.active == after && view.selection.empty()
        editor.execute(^scratch, Command.Undo)?
        assert view.selection.active == position
    }

    exercise_carets :: fn () -> void\string {
        check_caret("abcd", 3, Command.Backspace, "abd", 2)?
        check_caret("abcd", 1, Command.Delete, "acd", 1)?
        check_caret("alpha beta", 10, Command.DeleteWordBack, "alpha ", 6)?
        check_caret("a👩‍💻b", 12, Command.Backspace, "ab", 1)?
        check_caret("    x", 4, Command.Backspace, "x", 0)?
        check_caret("ab\r\ncd", 4, Command.Backspace, "abcd", 2)?
        check_caret("﻿abc", 6, Command.Backspace, "﻿ab", 5)?
        check_caret("abcd", 3, Command.Backspace, "ad", 1, anchor = 1)?
        check_caret("abcd", 1, Command.Delete, "ad", 1, anchor = 3)?
        check_caret("abcd", 1, Command.InsertText("X"), "aXbcd", 2)?
        check_caret("abcd", 2, Command.Duplicate, "abcd\nabcd", 7)?
    }

    check_word_delete :: fn (text : string,
    caret : usize,
    expected : string,
    destination : usize,
    anchor : ?usize = nil,
    linewise : bool = no,
    control : bool = yes,
    legacy : bool = no,
    state : Interaction = Interaction.Insert) -> void\string {
        editor : Editor
        editor.workspace.lock_fd = - 1
        defer editor.release()
        scratch : arena
        defer scratch.done()
        editor.workspace.add_empty()
        doc := ^editor.workspace.active_document().text
        on doc.load(text) {
            _success => {
            }

            _error! => return "Word deletion fixture failed"!
        }
        view := ^editor.workspace.active_view().interaction
        view.state = state
        view.place(doc, caret, no)
        on anchor => [position] {
            view.selection.anchor = position
        }
        view.linewise = linewise
        editor.key(^scratch, TermKeyEvent {
            scan_code : TermScanCode.Backspace
            action : TermKeyAction.Press
            modifiers : on control && !legacy {
                yes => TERM_MOD_CONTROL else => 0
            }
            character : on legacy {
                yes => 8.as(u32) else => 127.as(u32)
            }
            ...
        })
        editor.character(^scratch,
        on legacy {
            yes => 8.as(u32) else => 127.as(u32)
        })
        assert doc.text() == expected
        assert view.selection.empty() && !view.linewise
        assert view.selection.active == destination
        assert view.state == state
        assert doc.history.count == (on text == expected {
            yes => 0 else => 1
        })
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == text
        editor.execute(^scratch, Command.Redo)?
        assert doc.text() == expected
    }

    exercise_word_delete :: fn () -> void\string {
        check_word_delete("alpha beta", 10, "alpha ", 6)?
        check_word_delete("alpha beta", 10, "alpha beta", 10, anchor = nil, linewise = no, control = yes, legacy = no, state = Interaction.Normal)?
        check_word_delete("alpha beta", 10, "alpha beta", 10, anchor = nil, linewise = no, control = no, legacy = no, state = Interaction.Normal)?
        check_word_delete("alpha beta", 10, "alpha beta", 10, anchor = nil, linewise = no, control = no, legacy = yes, state = Interaction.Normal)?
        check_word_delete("one two", 7, "one ", 4, anchor = 4, linewise = no, control = no, legacy = yes, state = Interaction.Normal)?
        check_word_delete("alpha beta", 10, "alpha bet", 9, anchor = nil, linewise = no, control = no, legacy = yes)?
        check_word_delete("alpha, ", 7, "alpha", 5)?
        check_word_delete("alpha  \r\n  beta", 11, "beta", 0)?
        check_word_delete("alphabet soup", 5, "bet soup", 0)?
        check_word_delete("a é", 5, "a ", 2)?
        check_word_delete("a 👩‍💻", 13, "a ", 2)?
        check_word_delete("a b", 3, "b", 0)?
        check_word_delete("﻿word", 7, "﻿", 3)?
        check_word_delete("﻿word", 3, "﻿word", 3)?
        check_word_delete("", 0, "", 0)?
        check_word_delete("word", 0, "word", 0)?
        check_word_delete("one two three", 7, "one  three", 4, anchor = 4)?
        check_word_delete("one two three", 4, "one  three", 4, anchor = 7)?
        check_word_delete("one\ntwo\nthree", 8, "three", 0, anchor = 0, linewise = yes)?
        check_word_delete("word", 4, "wor", 3, anchor = nil, linewise = no, control = no)?

        editor : Editor
        editor.workspace.lock_fd = - 1
        defer editor.release()
        scratch : arena
        defer scratch.done()
        editor.workspace.add_empty()
        editor.prompt_open(':'.as(u32), initial = "buffer 123")
        editor.execute(^scratch, Command.DeleteWordBack)?
        assert editor.prompt[..].as(string) == "buffer "
        editor.execute(^scratch, Command.DeleteWordBack)?
        assert editor.prompt.count == 0
        assert editor.workspace.active_document().text.history.count == 0
        editor.prompt_cancel()
        editor.prompt_open('/'.as(u32), initial = "alpha beta")
        editor.execute(^scratch, Command.DeleteWordBack)?
        assert editor.prompt[..].as(string) == "alpha "
        assert editor.workspace.active_document().text.text() == ""
        assert editor.workspace.active_document().text.history.count == 0
    }
}

