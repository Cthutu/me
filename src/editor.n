test "Normal d immediately deletes selections with ordinary history and repeat" {
    scratch : arena
    defer scratch.done()
    editor : Editor
    editor.workspace.lock_fd = -1
    defer editor.release()
    editor.workspace.add_empty()
    doc := ^editor.workspace.active_document().text
    on doc.load("a👩‍💻bc\r\nz") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    own(^editor.clipboard.bytes, "kept")
    view := ^editor.workspace.active_view().interaction
    view.state = Interaction.Normal
    view.selection = Selection { anchor: 1 active: 12 }
    editor.character(^scratch, 'd'.as(u32))

    assert doc.text() == "abc\r\nz" && doc.applied == 1
    assert view.state == Interaction.Normal && bytes_text(editor.clipboard.bytes) == "kept"
    on editor.execute(^scratch, Command.Undo) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    assert doc.text() == "a👩‍💻bc\r\nz"
    on editor.execute(^scratch, Command.Redo) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    view.selection = Selection { anchor: 3 active: 1 }
    editor.character(^scratch, 'd'.as(u32))

    assert doc.text() == "a\r\nz" && view.selection.empty()
    on editor.execute(^scratch, Command.Undo) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    assert doc.text() == "abc\r\nz"
    view.place(doc, doc.text().count, no)
    applied := doc.applied
    editor.character(^scratch, 'd'.as(u32))

    assert doc.text() == "abc\r\nz" && doc.applied == applied
    editor.key(^scratch, TermKeyEvent { scan_code: Escape action: Press ... })
    view.place(doc, 0, no)
    repeat_keys(^editor, ^scratch, "[")
    on editor.execute(^scratch, Command.Move { direction: Right count: 1 extend: yes }) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    repeat_keys(^editor, ^scratch, "d].")
    assert doc.text() == "c\r\nz"
    on editor.execute(^scratch, Command.Undo) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    assert doc.text() == "bc\r\nz"
    repeat_keys(^editor, ^scratch, "id")
    assert doc.text() == "dbc\r\nz"
    on editor.execute(^scratch, Command.Escape) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    editor.prompt_open(':'.as(u32), initial = "s")
    editor.character(^scratch, 'd'.as(u32))

    assert bytes_text(editor.prompt) == "sd" && doc.text() == "dbc\r\nz"
}

test {

    check_line_deletion :: fn (text     : string,
                               caret    : usize,
                               count    : usize,
                               expected : string) -> void\string {
        scratch : arena
        defer scratch.done()
        editor : Editor
        editor.workspace.lock_fd = -1
        defer editor.release()
        editor.workspace.add_empty()
        doc := ^editor.workspace.active_document().text
        on doc.load(text) {
            _success => {
            }

            _error! => return "Line deletion fixture failed"!
        }
        view := ^editor.workspace.active_view().interaction
        view.state = Interaction.Normal
        view.place(doc, caret, no)
        own(^editor.clipboard.bytes, "retained")
        editor.execute(^scratch, Command.DeleteLines(count))?
        assert doc.text() == expected
        assert view.state == Interaction.Normal && view.selection.empty()
        assert bytes_text(editor.clipboard.bytes) == "retained"
        on text != expected => {
            assert doc.applied == 1
            editor.execute(^scratch, Command.Undo)?
            assert doc.text() == text && view.selection.active == caret
            editor.execute(^scratch, Command.Redo)?
            assert doc.text() == expected
        }
    }

}

test "line deletion clamps counts preserves BOM and endings and forms one undo unit" {
    on check_line_deletion("one\ntwo\nthree", 1, 1, "two\nthree") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    on check_line_deletion("one\ntwo\nthree", 5, 2, "one") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    on check_line_deletion("one\ntwo\nthree", 9, 999999, "one\ntwo") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    on check_line_deletion("""
    one
    two
    """, 4, 1, """
    one
    """) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    on check_line_deletion("""
    one
    """, 4, 1, "one") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    on check_line_deletion("﻿é\r\n👩‍💻\r\nz", 7, 1, "﻿é\r\nz") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    on check_line_deletion("﻿one\r\ntwo", 3, 999999, "﻿") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    on check_line_deletion("", 0, 2, "") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
}

test {

    exercise_dd :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        editor : Editor
        editor.workspace.lock_fd = -1
        defer editor.release()
        editor.workspace.add_empty()
        doc := ^editor.workspace.active_document().text
        on doc.load("one\ntwo\nthree\nfour\nfive") {
            _success => {
            }

            _error! => {
                assert no
            }
        }
        editor.workspace.active_view().interaction.state = Interaction.Normal
        editor.character(^scratch, 'd'.as(u32))
        assert doc.applied == 0 && doc.text() == "one\ntwo\nthree\nfour\nfive"
        editor.key(^scratch,
                   TermKeyEvent { scan_code: D action: Release character: 'd'.as(u32) ... })
        assert editor.workspace.active_view().keyboard.delete_count == 1
        editor.key(^scratch,
                   TermKeyEvent { scan_code: Escape action: Press character: 27.as(u32) ... })
        editor.character(^scratch, 27)
        assert editor.workspace.active_view().keyboard.delete_count == 0 && doc.applied == 0
        repeat_keys(^editor, ^scratch, "di")
        assert doc.applied == 0 && editor.workspace.active_view().interaction.state == Interaction.Normal
        assert editor.workspace.active_view().keyboard.delete_count == 0
        editor.character(^scratch, 'd'.as(u32))
        editor.key(^scratch,
                   TermKeyEvent { scan_code: N action: Press modifiers: TERM_MOD_CONTROL character: 14.as(u32) ... })
        editor.character(^scratch, 14)
        assert editor.workspace.documents.count == 1 && doc.applied == 0
        repeat_keys(^editor, ^scratch, "2dd")
        assert doc.text() == "three\nfour\nfive" && doc.applied == 1
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == "one\ntwo\nthree\nfour\nfive"
        editor.message.clear()
        repeat_keys(^editor, ^scratch, "[2dd].")
        assert doc.text() == "five" && doc.applied == 2
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == "three\nfour\nfive"
        editor.execute(^scratch, Command.Redo)?
        assert doc.text() == "five"
        -- Literal Insert dd is not a pending command.
        repeat_keys(^editor, ^scratch, "idd")
        assert doc.text() == "ddfive" && editor.workspace.active_view().keyboard.delete_count == 0
    }

}

