test "hjkl preserve graphemes and preferred columns while q keeps linewise selection and prompts stay literal" {
    scratch : arena
    defer scratch.done()
    editor : Editor
    editor.workspace.lock_fd = -1
    defer editor.release()
    editor.workspace.add_empty()
    doc := ^editor.workspace.active_document().text
    on doc.load("a👩‍💻bc\nx\na👩‍💻bc") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    view := ^editor.workspace.active_view().interaction
    view.state = Interaction.Normal
    for rune in "2ljjkkhl" {
        editor.character(^scratch, rune^.as(u32))
    }
    assert view.selection.active == 12 && view.selection.empty()
    assert view.state == Interaction.Normal && doc.history.count == 0
    view.place(doc, 0, no)
    editor.character(^scratch, '2'.as(u32))
    editor.character(^scratch, 'q'.as(u32))
    assert view.linewise && view.selection.start() == 0 && view.selection.end() == 17
    editor.character(^scratch, 'q'.as(u32))
    assert view.selection.end() == doc.text().count
    editor.character(^scratch, 'h'.as(u32))
    assert view.selection.empty() && !view.linewise
    editor.prompt_open('/'.as(u32))
    for rune in "qhjkl" {
        editor.character(^scratch, rune^.as(u32))
    }
    assert bytes_text(editor.prompt) == "qhjkl"
    editor.prompt_cancel()
    view.place(doc, 0, no)
    view.state = Interaction.Insert
    for rune in "qhjkl" {
        editor.character(^scratch, rune^.as(u32))
    }
    assert doc.text()[..5] == "qhjkl" && view.state == Interaction.Insert
}

test "buffer picker starts at previous access and Ctrl W closes only saved buffers" {
    scratch : arena
    defer scratch.done()
    editor : Editor
    editor.workspace.lock_fd = -1
    defer editor.release()
    for name in ["/alpha.n", "/Beta.n", "/gamma.n"] {
        editor.workspace.add_empty()
        own(^editor.workspace.active_document().path, name^)
        editor.workspace.active_document().disk_exists = yes
    }
    editor.workspace.active_view().interaction.state = Interaction.Normal
    editor.prompt_open(':'.as(u32), initial = "buffer 2")
    editor.key(^scratch,
               TermKeyEvent { scan_code: Enter action: Press character: 13.as(u32) ... })
    editor.character(^scratch, 13)
    editor.character(^scratch, 'i'.as(u32))
    editor.character(^scratch, 'z'.as(u32))
    assert editor.workspace.active_document().text.text() == "z"
    editor.character(^scratch, 26)
    assert editor.workspace.active_document().text.text() == ""
    assert !editor.workspace.views[2].keyboard.suppress_text
    assert editor.workspace.focus_document(2)
    editor.character(^scratch, ','.as(u32))
    assert editor.picker.active && editor.picker.chosen() == 1
    assert editor.picker.entries[0].id == 2 && editor.picker.entries[1].id == 1
    editor.key(^scratch,
               TermKeyEvent { scan_code: Enter action: Press character: 13.as(u32) ... })
    editor.character(^scratch, 13)
    assert !editor.picker.active && editor.workspace.active_view().document_id == 1
    assert editor.workspace.access_order[0] == 1 && editor.workspace.access_order[1] == 2
    editor.character(^scratch, ','.as(u32))
    editor.character(^scratch, 'G'.as(u32))
    editor.character(^scratch, 'M'.as(u32))
    assert editor.picker.matches.count == 1 && editor.picker.chosen() == 2
    editor.key(^scratch,
               TermKeyEvent { scan_code: Escape action: Press character: 27.as(u32) ... })
    editor.character(^scratch, 27)
    assert editor.workspace.active_view().document_id == 1
    editor.key(^scratch,
               TermKeyEvent { scan_code: W action: Release modifiers: TERM_MOD_CONTROL ... })
    assert editor.workspace.documents.count == 3
    editor.open_buffer_picker(^scratch)
    editor.picker.selected = 0
    editor.key(^scratch,
               TermKeyEvent { scan_code: W action: Press modifiers: TERM_MOD_CONTROL character: 23.as(u32) ... })
    editor.character(^scratch, 23)
    editor.picker.active = no
    assert editor.workspace.documents.count == 2
    assert bytes_text(editor.workspace.active_document().path) == "/gamma.n"
    assert editor.workspace.active_view().interaction.state == Interaction.Normal
    editor.character(^scratch, 'i'.as(u32))
    editor.character(^scratch, ','.as(u32))
    assert !editor.picker.active && editor.workspace.active_document().text.text() == ","
    editor.open_buffer_picker(^scratch)
    editor.picker.selected = 0
    editor.character(^scratch, 23)
    editor.picker.active = no
    assert editor.workspace.documents.count == 2
    assert editor.workspace.active_document().text.text() == ","
    assert editor.workspace.active_view().interaction.state == Interaction.Normal
    assert editor.message.count > 0
    editor.open_buffer_picker(^scratch)
    editor.picker.insert("zzzz")
    editor.key(^scratch,
               TermKeyEvent { scan_code: Enter action: Press character: 13.as(u32) ... })
    editor.character(^scratch, 13)
    assert editor.picker.active && editor.picker.matches.count == 0
    editor.key(^scratch, TermKeyEvent { scan_code: Escape action: Press ... })
    assert !editor.picker.active && editor.workspace.documents.count == 2
}

test "picker Ctrl W closes the chosen buffer and protects unsaved and unmatched work" {
    scratch : arena
    defer scratch.done()
    editor : Editor
    editor.workspace.lock_fd = -1
    defer editor.release()
    for name in ["/alpha.n", "/beta.n", "/gamma.n"] {
        editor.workspace.add_empty()
        own(^editor.workspace.active_document().path, name^)
        editor.workspace.active_document().disk_exists = yes
    }
    editor.character(^scratch, 'x'.as(u32))
    editor.open_buffer_picker(^scratch)
    assert editor.picker.chosen() == 1
    editor.key(^scratch,
               TermKeyEvent { scan_code: W action: Release modifiers: TERM_MOD_CONTROL ... })
    assert editor.workspace.documents.count == 3 && editor.picker.active
    editor.key(^scratch,
               TermKeyEvent { scan_code: W action: Press modifiers: TERM_MOD_CONTROL character: 23.as(u32) ... })
    editor.character(^scratch, 23)
    assert editor.picker.active && editor.workspace.documents.count == 2
    assert editor.picker.chosen() == 0 && editor.picker.selected == 1
    assert bytes_text(editor.workspace.documents[0].path) == "/alpha.n"
    assert bytes_text(editor.workspace.active_document().path) == "/gamma.n"
    assert editor.workspace.active_document().text.text() == "x"
    assert editor.workspace.active_view().interaction.state == Interaction.Normal
    editor.open_buffer_picker(^scratch)
    editor.picker.insert("gamma")
    editor.character(^scratch, 23)
    assert editor.picker.active && editor.workspace.documents.count == 2
    assert bytes_text(editor.picker.query) == "gamma" && editor.picker.caret == 5
    assert editor.message.count > 0 && editor.workspace.active_document().text.text() == "x"
    editor.open_buffer_picker(^scratch)
    editor.picker.insert("no matches")
    editor.key(^scratch,
               TermKeyEvent { scan_code: W action: Press modifiers: TERM_MOD_CONTROL character: 23.as(u32) ... })
    editor.character(^scratch, 23)
    assert editor.picker.active && editor.workspace.documents.count == 2
    editor.open_buffer_picker(^scratch)
    editor.picker.insert("alpha")
    editor.character(^scratch, 23)
    assert editor.picker.active && editor.workspace.documents.count == 1
    assert bytes_text(editor.picker.query) == "alpha" && editor.picker.matches.count == 0
    assert editor.picker.caret == 5
    assert bytes_text(editor.workspace.active_document().path) == "/gamma.n"
}

test "key releases leave navigation counts and message scrolling unchanged" {
    scratch : arena
    defer scratch.done()
    editor : Editor
    editor.workspace.lock_fd = -1
    defer editor.release()
    editor.workspace.add_empty()
    on editor.workspace.active_document().text.load("abcd") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    view := editor.workspace.active_view()
    view.interaction.state = Interaction.Normal
    editor.key(^scratch,
               TermKeyEvent { scan_code: ArrowRight action: Press ... })
    assert view.interaction.selection.active == 1
    editor.key(^scratch,
               TermKeyEvent { scan_code: ArrowRight action: Release ... })
    assert view.interaction.selection.active == 1
    editor.key(^scratch,
               TermKeyEvent { scan_code: ArrowRight action: Repeat ... })
    assert view.interaction.selection.active == 2
    view.keyboard.count = 2
    editor.key(^scratch,
               TermKeyEvent { scan_code: ArrowLeft action: Release ... })
    assert view.keyboard.count == 2 && view.interaction.selection.active == 2
    editor.key(^scratch,
               TermKeyEvent { scan_code: ArrowLeft action: Press ... })
    assert view.keyboard.count == 0 && view.interaction.selection.active == 0
    editor.tell("line one\nline two\nline three")
    editor.message_scroll = 2
    editor.key(^scratch,
               TermKeyEvent { scan_code: PageDown action: Release modifiers: TERM_MOD_ALT ... })
    assert editor.message_scroll == 2
    editor.key(^scratch,
               TermKeyEvent { scan_code: PageDown action: Press modifiers: TERM_MOD_ALT ... })
    editor.key(^scratch,
               TermKeyEvent { scan_code: PageDown action: Repeat modifiers: TERM_MOD_ALT ... })
    assert editor.message_scroll == 4
    editor.key(^scratch,
               TermKeyEvent { scan_code: PageUp action: Release modifiers: TERM_MOD_ALT ... })
    assert editor.message_scroll == 4
    editor.diagnostics.start()
    editor.key(^scratch,
               TermKeyEvent { scan_code: ArrowRight action: Release ... })
    assert editor.diagnostics.active && editor.diagnostics.total == 1
}

test "keyboard diagnostics capture commands without edits and Escape leaves no suppressed input" {
    scratch : arena
    defer scratch.done()
    editor : Editor
    editor.workspace.lock_fd = -1
    defer editor.release()
    editor.workspace.add_empty()
    editor.prompt_open(':'.as(u32), initial = "keys")
    on editor.command_line(^scratch) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    assert editor.diagnostics.active
    editor.message_scroll = 3
    editor.key(^scratch,
               TermKeyEvent { scan_code: TermScanCode.PageUp action: TermKeyAction.Press modifiers: TERM_MOD_ALT ... })
    assert editor.message_scroll == 2
    editor.key(^scratch,
               TermKeyEvent { scan_code: TermScanCode.H action: TermKeyAction.Press modifiers: TERM_MOD_CONTROL ... })
    editor.key(^scratch,
               TermKeyEvent { scan_code: TermScanCode.S action: TermKeyAction.Press modifiers: TERM_MOD_CONTROL character: 19.as(u32) ... })
    editor.character(^scratch, 19)
    for rune in "iqhjklx" {
        editor.character(^scratch, rune^.as(u32))
    }
    assert editor.workspace.active_document().text.text() == ""
    assert editor.workspace.active_document().text.history.count == 0 && !editor.quit
    editor.key(^scratch,
               TermKeyEvent { scan_code: TermScanCode.Escape action: TermKeyAction.Press character: 27.as(u32) ... })
    editor.character(^scratch, 27)
    assert !editor.diagnostics.active
    editor.character(^scratch, 'i'.as(u32))
    editor.character(^scratch, 'z'.as(u32))
    assert editor.workspace.active_document().text.text() == "z"
}

test "Space leader waits for help, cancels and leaves Insert and prompts literal" {
    scratch : arena
    defer scratch.done()
    editor : Editor
    editor.workspace.lock_fd = -1
    defer editor.release()
    editor.workspace.add_empty()
    editor.workspace.active_view().interaction.state = Interaction.Normal
    editor.character(^scratch, 32)
    assert editor.leader && !editor.leader_shown
    editor.tell("Keep this message")
    editor.poll_leader(editor.leader_started)
    assert !editor.leader_shown
    editor.poll_leader(editor.leader_started.add(from_ms(999)))
    assert !editor.leader_shown
    editor.poll_leader(editor.leader_started.add(from_ms(1000)))
    assert editor.leader_shown && bytes_text(editor.message) == "Keep this "
        +"message"

    editor.leader_prefix = "g"
    editor.key(^scratch,
               TermKeyEvent { scan_code: Backspace action: Press character: 8.as(u32) ... })
    editor.character(^scratch, 8)
    assert editor.leader && editor.leader_prefix == ""
    editor.character(^scratch, 'i'.as(u32))
    assert !editor.leader && editor.workspace.active_view().interaction.state == Interaction.Normal
    editor.character(^scratch, 32)
    editor.key(^scratch,
               TermKeyEvent { scan_code: ArrowRight action: Press ... })
    assert !editor.leader && editor.workspace.active_view().interaction.selection.active == 0
    editor.character(^scratch, 32)
    editor.key(^scratch,
               TermKeyEvent { scan_code: Enter action: Press character: 10.as(u32) ... })
    editor.character(^scratch, 10)
    assert !editor.leader && editor.workspace.active_document().text.text() == ""
    editor.character(^scratch, 32)
    editor.key(^scratch,
               TermKeyEvent { scan_code: Delete action: Press character: 127.as(u32) ... })
    editor.character(^scratch, 127)
    assert editor.leader && editor.workspace.active_document().text.text() == ""
    editor.cancel_leader()
    editor.character(^scratch, 'i'.as(u32))
    editor.character(^scratch, 32)
    assert !editor.leader && editor.workspace.active_document().text.text() == " "
    editor.prompt_open(':'.as(u32), initial = "e")
    editor.character(^scratch, 32)
    assert !editor.leader && bytes_text(editor.prompt) == "e "
}

test "Ctrl W closes only the focused pane and retains shared and unsaved buffers" {
    scratch : arena
    defer scratch.done()
    editor : Editor
    editor.workspace.lock_fd = -1
    defer editor.release()
    editor.workspace.add_empty()
    editor.character(^scratch, 'A'.as(u32))
    editor.workspace.active_view().interaction.state = Interaction.Normal
    on editor.pane_operation(LeaderOperation.SplitHorizontal) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    editor.workspace.add_empty()
    editor.character(^scratch, 'B'.as(u32))
    editor.workspace.active_view().interaction.state = Interaction.Normal
    right := editor.workspace.surface.view_id
    on editor.pane_operation(LeaderOperation.SplitVertical) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    editor.workspace.add_empty()
    editor.character(^scratch, 'C'.as(u32))
    editor.workspace.active_view().interaction.state = Interaction.Normal
    editor.key(^scratch,
               TermKeyEvent {
        scan_code : W
        action    : Release
        modifiers : TERM_MOD_CONTROL
        ...
    })
    assert editor.workspace.active_document().text.text() == "C"
    editor.key(^scratch, TermKeyEvent {
        scan_code : W
        action    : Press
        modifiers : TERM_MOD_CONTROL
        character : 23.as(u32)
        ...
    })
    editor.character(^scratch, 23)
    assert editor.workspace.surface.view_id == right
    assert editor.workspace.active_document().text.text() == "B"
    assert editor.workspace.panes.mounted(0)
    assert editor.workspace.documents.count == 3
    assert editor.workspace.documents[2].text.text() == "C"
    editor.character(^scratch, 23)
    assert editor.workspace.surface.view_id == 0
    assert !editor.workspace.panes.mounted(right)
    assert editor.workspace.active_document().text.text() == "A"
    -- Last-pane close is harmless, even with unsaved text.
    editor.character(^scratch, 23)
    assert editor.workspace.surface.view_id == 0 && !editor.quit
    assert editor.workspace.documents.count == 3
    on editor.pane_operation(LeaderOperation.SplitHorizontal) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    editor.character(^scratch, 23)
    assert editor.workspace.surface.view_id == 0
    assert editor.workspace.active_document().text.text() == "A"
}

test "Ctrl N creates distinct unnamed Insert buffers in the focused pane without losing work" {
    scratch : arena
    defer scratch.done()
    editor : Editor
    editor.workspace.lock_fd = -1
    defer editor.release()
    editor.workspace.add_empty()
    editor.character(^scratch, 'A'.as(u32))
    editor.workspace.active_view().interaction.state = Interaction.Normal
    on editor.pane_operation(LeaderOperation.SplitHorizontal) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    editor.key(^scratch,
               TermKeyEvent {
        scan_code : N
        action    : Release
        modifiers : TERM_MOD_CONTROL
        ...
    })
    assert editor.workspace.documents.count == 1
    editor.key(^scratch, TermKeyEvent {
        scan_code : N
        action    : Press
        modifiers : TERM_MOD_CONTROL
        character : 14.as(u32)
        ...
    })
    editor.character(^scratch, 14)
    assert editor.workspace.documents.count == 2
    assert editor.workspace.active_document().path.count == 0
    assert editor.workspace.active_document().text.text() == ""
    assert editor.workspace.active_view().interaction.state == Interaction.Insert
    assert editor.workspace.panes.mounted(0)
    assert editor.workspace.documents[0].text.text() == "A"
    assert editor.dirty
    editor.character(^scratch, 'B'.as(u32))
    editor.character(^scratch, 14)
    assert editor.workspace.documents.count == 3
    assert editor.workspace.documents[1].text.text() == "B"
    assert editor.workspace.active_document().text.text() == ""
    editor.workspace.active_view().interaction.state = Interaction.Normal
    editor.character(^scratch, '2'.as(u32))
    editor.character(^scratch, 14)
    assert editor.workspace.documents.count == 3
    assert editor.workspace.active_view().keyboard.count == 0
    editor.character(^scratch, '2'.as(u32))
    editor.key(^scratch, TermKeyEvent {
        scan_code : N
        action    : Press
        modifiers : TERM_MOD_CONTROL
        character : 14.as(u32)
        ...
    })
    editor.character(^scratch, 14)
    assert editor.workspace.documents.count == 3
    assert editor.workspace.active_view().keyboard.count == 0
    editor.prompt_open(':'.as(u32), initial = "e unfinished")
    editor.character(^scratch, 14)
    assert editor.prompt_kind == 0 && editor.workspace.documents.count == 4
}

test {

    repeat_keys :: fn (editor: ^Editor, scratch: ^arena, keys: string) {
        for byte in keys {
            on byte^ == 27 {
                yes   => editor.key(scratch, TermKeyEvent {
                    scan_code : Escape
                    action    : Press
                    ...
                })
                else  => editor.character(scratch, byte^.as(u32))
            }
        }
    }

    exercise_repeat :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        editor : Editor
        editor.workspace.lock_fd = -1
        defer editor.release()
        editor.workspace.add_empty()
        editor.workspace.active_view().interaction.state = Interaction.Normal
        -- Correct an edit, branch, then undo/redo the replacement while recording.
        repeat_keys(^editor, ^scratch, "[iAB")
        editor.execute(^scratch, Command.Undo)?
        repeat_keys(^editor, ^scratch, "iC")
        editor.execute(^scratch, Command.Undo)?
        editor.execute(^scratch, Command.Redo)?
        editor.execute(^scratch, Command.RecordStop)?
        assert editor.workspace.active_document().text.text() == "AC"
        assert editor.workspace.active_document().text.applied == 2
        editor.execute(^scratch, Command.Undo)?
        assert editor.workspace.active_document().text.text() == "A"
        editor.workspace.add_empty()
        editor.workspace.active_view().interaction.state = Interaction.Normal
        editor.execute(^scratch, Command.Replay)?
        doc := ^editor.workspace.active_document().text
        assert doc.text() == "AC" && doc.applied == 1 && doc.history.count == 1
        assert editor.workspace.active_view().interaction.state == Interaction.Normal
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == ""
        editor.execute(^scratch, Command.Redo)?
        assert doc.text() == "AC"
        -- A second replay is a separate whole undo unit.
        editor.execute(^scratch, Command.Replay)?
        assert doc.text() == "ACAC" && doc.applied == 2
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == "AC"
        editor.execute(^scratch, Command.Redo)?
        assert doc.text() == "ACAC"
        -- Compound history is continuation-compatible without a codec change.
        encoded : Encoder
        defer encoded.bytes.free()
        encoded.document(doc)
        decoded             := Decoder { bytes: bytes_text(encoded.bytes) ... }
        restored : Document

        defer restored.release()
        decoded.document(^restored)?
        _ := restored.undo_edit()
        assert restored.text() == "AC"
        _ := restored.redo_edit()
        assert restored.text() == "ACAC"
    }

    exercise_repeat_corrections :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        editor : Editor
        editor.workspace.lock_fd = -1
        defer editor.release()
        editor.workspace.add_empty()
        editor.workspace.active_view().interaction.state = Interaction.Normal
        repeat_keys(^editor, ^scratch, "[iA")
        editor.execute(^scratch, Command.Move {
            direction : Left
            count     : 1
            extend    : no
        })?
        editor.execute(^scratch, Command.InsertText("B"))?
        editor.execute(^scratch, Command.Move {
            direction : Right
            count     : 1
            extend    : no
        })?
        editor.execute(^scratch, Command.Undo)?
        editor.execute(^scratch, Command.Undo)?
        editor.execute(^scratch, Command.Redo)?
        editor.execute(^scratch, Command.Redo)?
        editor.execute(^scratch, Command.RecordStop)?
        assert editor.workspace.active_document().text.text() == "BA"
        editor.workspace.add_empty()
        editor.workspace.active_view().interaction.state = Interaction.Normal
        editor.execute(^scratch, Command.Replay)?
        assert editor.workspace.active_document().text.text() == "BA"
        assert editor.workspace.active_view().interaction.selection.active == 1
        -- Undo cannot remove history predating this recording.
        editor.execute(^scratch, Command.RecordStart)?
        on editor.execute(^scratch, Command.Undo) {
            _success => {
                assert no
            }

            _error! => {
            }
        }
        assert editor.workspace.active_document().text.text() == "BA"
        editor.execute(^scratch, Command.RecordStop)?
        assert editor.recording.saved.count == 0
        on editor.execute(^scratch, Command.Replay) {
            _success => {
                assert no
            }

            _error! => {
            }
        }
        assert editor.workspace.active_document().text.text() == "BA"
    }

    exercise_repeat_failure :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        editor : Editor
        editor.workspace.lock_fd = -1
        defer editor.release()
        editor.workspace.add_empty()
        editor.workspace.active_view().interaction.state = Interaction.Normal
        own(^editor.clipboard.bytes, "Z")
        repeat_keys(^editor, ^scratch, "[iA")
        editor.execute(^scratch, Command.Escape)?
        editor.execute(^scratch, Command.Paste)?
        editor.execute(^scratch, Command.RecordStop)?
        editor.clipboard.bytes.clear()
        editor.workspace.add_empty()
        editor.workspace.active_view().interaction.state = Interaction.Normal
        on editor.execute(^scratch, Command.Replay) {
            _success => {
                assert no
            }

            error! => {
                assert error.count > 20
            }
        }
        doc := ^editor.workspace.active_document().text
        assert doc.text() == "A" && doc.history.count == 1 && doc.applied == 1
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == ""
        editor.execute(^scratch, Command.Redo)?
        assert doc.text() == "A"
        -- Failed recording commands do not enter the saved sequence or change scope.
        editor.execute(^scratch, Command.RecordStart)?
        on editor.execute(^scratch, Command.NewBuffer) {
            _success => {
                assert no
            }

            _error! => {
            }
        }
        on editor.execute(^scratch, Command.RecordStart) {
            _success => {
                assert no
            }

            _error! => {
            }
        }
        assert editor.workspace.documents.count == 2 && editor.recording.active
        editor.execute(^scratch, Command.RecordStop)?
        -- A zero-net replay remains one history unit; undo/redo still mark its
        -- applied state dirty even though the stored text does not change.
        editor.workspace.add_empty()
        editor.workspace.active_view().interaction.state = Interaction.Normal
        editor.execute(^scratch, Command.RecordStart)?
        editor.execute(^scratch, Command.EnterInsert('i'.as(u32)))?
        editor.execute(^scratch, Command.InsertText("Z"))?
        editor.execute(^scratch, Command.Backspace)?
        editor.execute(^scratch, Command.Escape)?
        editor.execute(^scratch, Command.RecordStop)?
        zero := ^editor.workspace.active_document().text
        editor.execute(^scratch, Command.Replay)?
        assert zero.text() == "" && zero.applied == 3
        editor.dirty = no
        editor.execute(^scratch, Command.Undo)?
        assert zero.applied == 2 && editor.dirty
        editor.dirty = no
        editor.execute(^scratch, Command.Redo)?
        assert zero.applied == 3 && editor.dirty
    }

    exercise_repeat_unicode :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        editor : Editor
        editor.workspace.lock_fd = -1
        defer editor.release()
        editor.workspace.add_empty()
        editor.workspace.active_view().interaction.state = Interaction.Normal
        editor.execute(^scratch, Command.RecordStart)?
        editor.execute(^scratch, Command.EnterInsert('i'.as(u32)))?
        text := scratch.pr("é👩‍💻")
        editor.execute(^scratch, Command.InsertText(text))?
        repeat_keys(^editor, ^scratch, "[]")
        editor.execute(^scratch, Command.Escape)?
        editor.execute(^scratch, Command.RecordStop)?
        editor.workspace.add_empty()
        editor.workspace.active_view().interaction.state = Interaction.Normal
        on editor.workspace.active_document().text.load("Z") {
            _success => {
            }

            _error! => {
                assert no
            }
        }
        editor.workspace.active_view().interaction.selection.collapse(1)
        editor.workspace.split_pane(SplitAxis.Columns)?
        editor.workspace.active_view().interaction.selection.collapse(0)
        editor.execute(^scratch, Command.Replay)?
        doc := ^editor.workspace.active_document().text
        assert doc.text() == "é👩‍💻[]Z" && doc.applied == 1
        assert editor.workspace.views[1].interaction.selection.active == doc.text().count
        editor.execute(^scratch, Command.Undo)?
        assert doc.text() == "Z"
        assert editor.workspace.views[1].interaction.selection.active == 1
        editor.execute(^scratch, Command.Redo)?
        assert doc.text() == "é👩‍💻[]Z"
        assert editor.workspace.views[1].interaction.selection.active == doc.text().count
        -- Payload ownership does not depend on the caller's scratch arena.
        scratch.reset()
        editor.execute(^scratch, Command.Replay)?
        assert doc.text() == "é👩‍💻[]é👩‍💻[]Z"
    }

}

