test {

    exercise_recording_cancel :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        editor : Editor
        editor.workspace.lock_fd = -1
        defer editor.release()
        editor.workspace.add_empty()
        editor.workspace.active_view().interaction.state = Interaction.Normal
        repeat_keys(^editor, ^scratch, "[iA")
        editor.execute(^scratch, Command.Escape)?
        editor.execute(^scratch, Command.RecordStop)?
        saved := editor.recording.saved.count
        repeat_keys(^editor, ^scratch, "[iB")
        editor.key(^scratch,
                   TermKeyEvent {
            scan_code : G
            action    : Release
            modifiers : TERM_MOD_CONTROL
            ...
        })
        assert editor.recording.active
        editor.key(^scratch, TermKeyEvent {
            scan_code : G
            action    : Press
            modifiers : TERM_MOD_CONTROL
            character : 7.as(u32)
            ...
        })
        editor.character(^scratch, 7)
        assert !editor.recording.active && editor.recording.draft.count == 0
        assert editor.recording.saved.count == saved
        assert editor.workspace.active_view().interaction.state == Interaction.Insert
        assert editor.workspace.active_document().text.text() == "AB"
        editor.character(^scratch, 'C'.as(u32))
        editor.execute(^scratch, Command.Escape)?
        editor.execute(^scratch, Command.Replay)?
        assert editor.workspace.active_document().text.text() == "ABCA"
        editor.execute(^scratch, Command.RecordStart)?
        editor.character(^scratch, 'd'.as(u32))
        assert editor.workspace.active_view().keyboard.delete_count > 0
        editor.character(^scratch, 7)
        assert !editor.recording.active && editor.workspace.active_view().keyboard.delete_count == 0
        assert editor.recording.saved.count == saved
        -- Signal-driven quitting shares this path. Refused unsafe quitting still
        -- cancels only the unfinished draft, preserving both edits and recipe.
        editor.execute(^scratch, Command.RecordStart)?
        on editor.quit_safely(^scratch) {
            _success => {
                assert no
            }

            _error! => {
            }
        }
        assert !editor.quit && !editor.recording.active
        assert editor.recording.saved.count == saved
        for command in ["q", "q!", "wq"] {
            editor.workspace.active_view().interaction.state = Interaction.Normal
            editor.execute(^scratch, Command.RecordStart)?
            editor.execute(^scratch, Command.Prompt(':'.as(u32)))?
            repeat_keys(^editor, ^scratch, command^)
            on editor.execute(^scratch, Command.InsertText("\n")) {
                _success => {
                }

                _error! => {
                }
            }
            assert !editor.recording.active && editor.recording.saved.count == saved
            on editor.prompt_kind != 0 => editor.prompt_cancel()
            editor.quit = no
        }
    }

}

test "Ctrl G cancels drafts in either mode and quitting preserves the previous recipe" {
    on exercise_recording_cancel() {
        _success => {
        }

        _error! => {
            assert no
        }
    }
}
