-- Literal byte search on validated UTF-8. A valid query cannot begin with a
-- continuation byte, so occurrences also begin at UTF-8 boundaries.
pub find_literal :: fn (text        : string,
                        query       : string,
                        origin      : usize,
                        backwards   : bool,
                        skip_origin : bool = no) -> ?usize {
    on query.count == 0 || query.count > text.count => return nil
    limit := text.count - query.count + 1
    start := on origin < limit {
        yes => origin

        else => on backwards { yes => limit - 1 else => 0 }
    }
    for step in [0 .. limit] {
        index := on backwards {
            yes   => (start + limit - step) % limit
            else  => (start + step) % limit
        }
        on skip_origin && index == origin => again
        on text[index..index + query.count] == query => return index
    }
    return nil
}

test "literal search wraps and skips the active occurrence" {
    on find_literal("one two one", "one", 0, no) {
        position => {
            assert position == 0
        }

        else => {
            assert no
        }
    }
    on find_literal("one two one", "one", 0, no, skip_origin = yes) {
        position => {
            assert position == 8
        }

        else => {
            assert no
        }
    }
    on find_literal("one two one", "one", 0, yes, skip_origin = yes) {
        position => {
            assert position == 8
        }

        else => {
            assert no
        }
    }
    on find_literal("abc", "", 0, no) {
        _position => {
            assert no
        }

        else => {
        }
    }
    on find_literal("abc", "long", 0, no) {
        _position => {
            assert no
        }

        else => {
        }
    }
}
