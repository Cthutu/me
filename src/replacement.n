use buffer

pub ReplaceCommand :: plex {
    needle      string
    replacement string
    confirm     bool
}

pub Replacement :: plex {
    range TextRange
    text  string
    count usize
}

-- Strip the optional forward-origin prefix before looking for a replacement
-- separator. The prompt itself already omits the opening slash.
pub forward_body :: fn (text: string) -> string {
    return on text.count > 0 && text[0] == '/' { yes => text[1..] else => text }
}

-- Only an unescaped slash after the query starts switches search to
-- replacement; \/ and \\ retain their ordinary literal meanings.
pub slash_separator :: fn (text: string) -> ?usize {
    i : usize = 0
    for i < text.count {
        on text[i] == '\\' && i + 1 < text.count && (text[i + 1] == '/' || text[i + 1] == '\\') {
            yes => i += 2

            else => {
                on text[i] == '/' => return i
                i += 1
            }
        }
    }
    return nil
}

pub decode_slashes :: fn (text: string, output: []u8) -> usize {
    i    : usize = 0
    used : usize = 0

    for i < text.count {
        on text[i] == '\\' &&
            i + 1 < text.count &&
            (text[i + 1] == '/' || text[i + 1] == '\\') => i += 1
        output[used] = text[i]
        used += 1
        i    += 1
    }
    return used
}

part :: fn (scratch: ^arena, text: string) -> string {
    bytes := scratch.alloc_bytes(text.count)
    used  := decode_slashes(text, bytes)

    return bytes[..used].as(string)
}

pub parse_replace :: fn (scratch: ^arena, spec: string) -> ReplaceCommand\string {
    on spec.count < 2 || spec[0] != '/' => return "Use /old/new or /old/new/c"!
    body := spec[1..]
    split := on slash_separator(body) {
        value  => value
        else   => return "Use /old/new or /old/new/c"!
    }
    needle := part(scratch, body[..split])
    on needle.count == 0 => return "Replacement needs a non-empty search term; "
        +"escape a literal slash with \\/"!
    tail    := body[split + 1..]
    confirm := no

    on slash_separator(tail) => [end] {
        flag := tail[end + 1..]
        on flag != "" &&
            flag != "c" => return "Only c confirmation is supported; "
            +"replace-all is already the default"!
        confirm = flag == "c"
        tail    = tail[..end]
    }
    return ReplaceCommand { needle replacement: part(scratch, tail) confirm }
}

pub replacement_matches :: fn (matches : ^[..]usize,
                               text    : string,
                               needle  : string,
                               minimum : usize = 0) {
    matches.clear()
    on needle.count == 0 || minimum > text.count => return
    cursor := minimum
    for cursor <= text.count && needle.count <= text.count - cursor {
        on text[cursor..cursor + needle.count] == needle {
            yes => {
                matches.push(cursor)
                cursor += needle.count
            }

            else => cursor += 1
        }
    }
}

-- A single contiguous operation spans only the affected original matches.
-- Replacement text is never recursively searched.
pub plan_replacement :: fn (scratch : ^arena,
                            text    : string,
                            command : ReplaceCommand,
                            minimum : usize = 0) -> ?Replacement {
    matches : [..]usize
    defer matches.free()
    replacement_matches(^matches, text, command.needle, minimum = minimum)
    on matches.count == 0 => return nil
    start               := matches[0]
    end                 := matches[matches.count - 1] + command.needle.count
    size                := end - start - matches.count * command.needle.count + matches.count * command.replacement.count
    payload             := scratch.alloc_bytes(size)
    source              := start
    destination : usize = 0

    for position in matches {
        unchanged := position^ - source
        payload[destination..destination + unchanged] = text[source..position^].as([]u8)
        destination += unchanged
        payload[destination..destination + command.replacement.count] = command.replacement.as([]u8)
        destination += command.replacement.count
        source      = position^ + command.needle.count
    }
    return Replacement {
        range : { start end }
        text  : payload.as(string)
        count : matches.count
    }
}

pub ReplaceConfirmation :: plex {
    needle            [..]u8
    replacement       [..]u8
    matches           [..]usize
    index             usize
    approved          usize
    removed_total     usize
    added_total       usize
    document_id       usize
    invoking_view     usize
    history_base      usize
    expected_revision u64
    caret_before      usize
    grouped           bool
    active            bool
}

impl ReplaceConfirmation {

    pub reset :: fn (self: ^Self) {
        self.active = no
        self.index = 0
        self.approved = 0
        self.removed_total = 0
        self.added_total = 0
        self.grouped = no
        self.matches.clear()
        self.needle.clear()
        self.replacement.clear()
    }

    pub release :: fn (self: ^Self) {
        self.matches.free()
        self.needle.free()
        self.replacement.free()
    }

    pub position :: fn (self: ^Self) => self.matches[self.index] - self.removed_total + self.added_total

}

test {

    parser_plans :: fn () -> void\string {
        scratch : arena
        defer scratch.done()
        command := parse_replace(^scratch, "/one/two")?
        assert command.needle == "one" && command.replacement == "two" && !command.confirm
        on plan_replacement(^scratch, "before one middle one after", command) {
            plan => {
                assert plan.range.start == 7 && plan.range.end == 21
                assert plan.text == "two middle two" && plan.count == 2
            }

            else => {
                assert no
            }
        }
        escaped := parse_replace(^scratch, "/a\\/b/c\\\\d/c")?
        assert escaped.needle == "a/b" && escaped.replacement == "c\\d" && escaped.confirm
        literal := parse_replace(^scratch, "/one/\\n/")?
        assert literal.replacement == "\\n"
        deletion := parse_replace(^scratch, "/a/")?
        on plan_replacement(^scratch, "a a", deletion) {
            plan => {
                assert plan.text == " " && plan.count == 2
            }

            else => {
                assert no
            }
        }
        assert slash_separator("src\\/old") == nil
        assert slash_separator("src\\/old/new") == 8
        for invalid in ["//new", "/old", "/old/new/g", "/old/new/c/x"] {
            on parse_replace(^scratch, invalid^) {
                _valid => {
                    assert no
                }

                _invalid! => {
                }
            }
        }
    }

}

test "second-slash replacement parsing defaults to literal replace-all and supports only optional confirmation" {
    on parser_plans() {
        _success => {
        }

        error! => {
            assert no, error
        }
    }
}
