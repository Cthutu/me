pub whitespace_property :: fn (r: u32) -> u8 {
    return on r {
        in [0x9 ..= 0xd] => 1
        0x20 => 1
        0x85 => 1
        0xa0 => 1
        0x1680 => 1
        in [0x2000 ..= 0x200a] => 1
        in [0x2028 ..= 0x2029] => 1
        0x202f => 1
        0x205f => 1
        0x3000 => 1
        else => 0
    }
}

