use buffer
use document
use native

pub Encoder :: plex {
    bytes [..]u8
}

impl Encoder {

    pub number :: fn (self: ^Self, value: u64) {
        for shift in [0.as(usize) .. 8] {
            self.bytes.push(((value >> (shift * 8).as(u64)) & 255).as(u8))
        }
    }

    pub text :: fn (self: ^Self, text: string) {
        self.number(text.count.as(u64))
        start := self.bytes.count
        self.bytes.resize_undefined_to(start + text.count)
        self.bytes[start..] = text.as([]u8)
    }

    pub document :: fn (self: ^Self, doc: ^Document, legacy: bool = no) {
        self.text(doc.text())
        self.number(doc.applied.as(u64))
        self.number(doc.history.count.as(u64))
        for record in doc.history {
            self.number(record.start.as(u64))
            self.text(bytes_text(record.removed))
            self.text(bytes_text(record.added))
            on !legacy => {
                self.number(on record.caret_before {
                    position  => position.as(u64) + 1
                    else      => 0
                })
                self.number(on record.caret_after {
                    position  => position.as(u64) + 1
                    else      => 0
                })
            }
        }
    }

}

pub Decoder :: plex {
    bytes  string
    offset usize
}

impl Decoder {

    pub number :: fn (self: ^Self) -> u64\string {
        on self.offset > self.bytes.count ||
            self.bytes.count - self.offset < 8 => return "Truncated "
            +"continuation"!
        number : u64 = 0
        for shift in [0.as(usize) .. 8] {
            number |= self.bytes[self.offset + shift].as(u64) << (shift * 8).as(u64)
        }
        self.offset += 8
        return number
    }

    pub text :: fn (self: ^Self) -> string\string {
        count := self.number()?
        on count > (self.bytes.count - self.offset).as(u64) => return "Invalid "
            +"continuation length"!
        start := self.offset
        self.offset += count.as(usize)
        return self.bytes[start..self.offset]
    }

    pub document :: fn (self   : ^Self,
                        doc    : ^Document,
                        legacy : bool = no) -> void\string {
        text := self.text()?
        on doc.load(text) {
            _success => {
            }

            _error! => return "Invalid UTF-8 in continuation"!
        }
        applied := self.number()?
        count   := self.number()?

        -- Every record needs its start/two byte lengths and (in v2) caret hints.
        -- Bound allocation by the actual envelope, not an arbitrary history
        -- limit that the encoder could exceed during a long-lived session.
        minimum := on legacy {
            yes   => 24.as(usize)
            else  => 40.as(usize)
        }
        on count > ((self.bytes.count - self.offset) / minimum).as(u64) ||
            applied > count => return "Invalid continuation history size"!
        for _ in [0 .. count] {
            start                := self.number()?
            removed              := self.text()?
            added                := self.text()?
            before               := on legacy { yes => 0.as(u64) else => self.number()? }
            after                := on legacy { yes => 0.as(u64) else => self.number()? }
            record  : EditRecord

            on before > 0 => record.caret_before = (before - 1).as(usize)
            on after > 0 => record.caret_after = (after - 1).as(usize)

            record.start = start.as(usize)
            own(^record.removed, removed)
            own(^record.added, added)
            doc.history.push(record)
        }
        -- Validate both the undo and redo chain before exposing recovered data.
        -- User-writable or truncated snapshots must never reach abort-only
        -- internal history invariants during ordinary editing.
        doc.applied = applied.as(usize)
        index := doc.applied
        for index > 0 {
            index -= 1
            self.verify_record(doc, ^doc.history[index], no)?
        }
        for record in doc.history {
            self.verify_record(doc, record, yes)?
        }
        index = doc.history.count
        for index > doc.applied {
            index -= 1
            self.verify_record(doc, ^doc.history[index], no)?
        }
        doc.refresh()
        on doc.text() != text => return "Inconsistent continuation history"!
    }

    verify_caret :: fn (_self : ^Self,
                        doc   : ^Document,
                        caret : ?usize) -> void\string {
        on caret => [position] {
            on position > doc.storage.length() => return "Invalid continuation "
                +"history caret"!
            on position < doc.storage.length() => {
                chunks := doc.storage.chunks()
                byte := on position < chunks.before.count {
                    yes   => chunks.before[position]
                    else  => chunks.after[position - chunks.before.count]
                }
                on (byte & 0xc0) == 0x80 => return "Invalid continuation "
                    +"history caret boundary"!
            }
        }
    }

    verify_record :: fn (self    : ^Self,
                         doc     : ^Document,
                         record  : ^EditRecord,
                         forward : bool) -> void\string {
        expected := on forward {
            yes   => bytes_text(record.removed)
            else  => bytes_text(record.added)
        }
        replacement := on forward {
            yes   => bytes_text(record.added)
            else  => bytes_text(record.removed)
        }
        on record.start > doc.storage.length() ||
            expected.count > doc.storage.length() - record.start => return "Inv"
            +"alid"
            +" continuation history range"!
        self.verify_caret(doc, on forward { yes => record.caret_before else => record.caret_after })?
        chunks := doc.storage.chunks()
        for index, byte in expected {
            position := record.start + index
            actual := on position < chunks.before.count {
                yes   => chunks.before[position]
                else  => chunks.after[position - chunks.before.count]
            }
            on actual != byte^ => return "Invalid continuation history payload"!
        }
        -- Loading a projection must not clear the history being checked.
        on doc.storage.replace({ start: record.start end: record.start + expected.count }, replacement) {
            _change => {
            }

            _error! => return "Invalid continuation history boundary"!
        }
        self.verify_caret(doc, on forward { yes => record.caret_after else => record.caret_before })?
        -- Keep validation operation-sized; refreshing the entire projection
        -- for every replay record would make recovery O(file size × history).
    }

}

test {

    roundtrip :: fn () -> void\string {
        doc : Document
        defer doc.release()
        on doc.load("BOM: ﻿\r\nwithout final newline") {
            _success => {
            }

            _error! => return "load"!
        }
        on doc.edit({ start: 0 end: 0 }, "a") {
            _change => {
            }

            _error! => return "edit"!
        }
        on doc.edit({ start: 1 end: 1 }, "b") {
            _change => {
            }

            _error! => return "edit"!
        }
        on doc.undo_edit() {
            _change => {
            }

            else => {
                assert no
            }
        }
        encoded : Encoder
        defer encoded.bytes.free()
        encoded.document(^doc)
        decoded : Document
        defer decoded.release()
        reader := Decoder { bytes: bytes_text(encoded.bytes) ... }
        reader.document(^decoded)?
        assert decoded.text() == doc.text()
        assert decoded.applied == 1 && decoded.history.count == 2
        on decoded.redo_edit() {
            _change => {
            }

            else => {
                assert no
            }
        }
        assert decoded.text()[..2] == "ab"
        assert reader.offset == reader.bytes.count
        corrupt := Decoder { bytes: "truncated" ... }
        on corrupt.document(^decoded) {
            _success => {
                assert no
            }

            _error! => {
            }
        }
    }

    exercise_caret_codec :: fn () -> void\string {
        doc : Document
        defer doc.release()
        on doc.load("ab") {
            _success => {
            }

            _error! => return "load"!
        }
        on doc.edit({ start: 1 end: 2 }, "") {
            _change => {
            }

            _error! => return "edit"!
        }
        doc.history[0].caret_before = 2.as(usize)
        doc.history[0].caret_after = 1.as(usize)
        encoded : Encoder
        defer encoded.bytes.free()
        encoded.document(^doc)
        decoded : Document
        defer decoded.release()
        reader := Decoder { bytes: bytes_text(encoded.bytes) ... }
        reader.document(^decoded)?
        on decoded.history[0].caret_before {
            position => {
                assert position == 2
            }

            else => {
                assert no
            }
        }
        on decoded.history[0].caret_after {
            position => {
                assert position == 1
            }

            else => {
                assert no
            }
        }
        assert reader.offset == reader.bytes.count
        encoded.bytes.clear()
        encoded.document(^doc, legacy = yes)
        reader = Decoder { bytes: bytes_text(encoded.bytes) ... }
        reader.document(^decoded, legacy = yes)?
        assert decoded.history[0].caret_before == nil
        assert decoded.history[0].caret_after == nil
        assert decoded.text() == "a"
        assert reader.offset == reader.bytes.count
        -- Reject invalid pre-edit/post-edit coordinates before exposing history.
        for invalid in [3.as(usize), 100.as(usize)] {
            doc.history[0].caret_before = invalid^
            encoded.bytes.clear()
            encoded.document(^doc)
            reader = Decoder { bytes: bytes_text(encoded.bytes) ... }
            on reader.document(^decoded) {
                _success => {
                    assert no
                }

                _error! => {
                }
            }
        }
        on doc.load("éx") {
            _success => {
            }

            _error! => return "load"!
        }
        on doc.edit({ start: 2 end: 3 }, "") {
            _change => {
            }

            _error! => return "edit"!
        }
        doc.history[0].caret_before = 3.as(usize)
        doc.history[0].caret_after = 1.as(usize)
        encoded.bytes.clear()
        encoded.document(^doc)
        reader = Decoder { bytes: bytes_text(encoded.bytes) ... }
        on reader.document(^decoded) {
            _success => {
                assert no
            }

            _error! => {
            }
        }
    }

}

test "continuation codec round-trips bytes, branched history, undo position and redo" {
    on roundtrip() {
        _success => {
        }

        error! => {
            assert no, error
        }
    }
}

test "continuation caret hints round-trip, import legacy history and reject unsafe positions" {
    on exercise_caret_codec() {
        _success => {
        }

        error! => {
            assert no, error
        }
    }
}
