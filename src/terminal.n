use characters
use document
use editor
use key_diagnostics
use leader_menu
use native
use os.linux
use panes
use picker
use positions
use std.term
use std.text
use std.time
use unicode_data
use view
use workspace

Cell :: plex {
    rune  u32
    ink   Colour
    paper Colour
    force bool
}

Glyph :: plex {
    x       usize
    y       usize
    text    string
    ink     Colour
    paper   Colour
    pending bool
}

-- std.term cells currently store one codepoint. Local compositing adds full
-- graphemes on the next simulation step, after dirty-cell output has completed.
-- Plain cells and all layout still use std.term's retained framebuffer. Keep
-- this bridge bounded to complex glyphs; a native glyph-cell API is a library
-- candidate, not a reason to replace the terminal backend.
pub Terminal :: plex {
    editor          Editor
    scratch         arena
    cells           [..]Cell
    previous_cells  [..]Cell
    glyphs          [..]Glyph
    previous_glyphs [..]Glyph
    glyph_arena     arena
    previous_arena  arena
    glyph_storage   ^arena
    width           usize
    height          usize
    frames          usize
    last_poll       Instant
    origin_x        usize
    origin_y        usize
    canvas_width    usize
    signal_fd       i32
    signal_mask     u64
    signals_active  bool
}

INK          :: 0xd8dee9.as(Colour)
PAPER        :: 0x171d27.as(Colour)
MUTED        :: 0x738299.as(Colour)
GUTTER_PAPER :: 0x29394f.as(Colour)
NORMAL_PAPER :: 0x214c38.as(Colour)
INSERT_PAPER :: 0x602d35.as(Colour)
NORMAL_CARET :: 0x7bd88f.as(Colour)
INSERT_CARET :: 0xf07178.as(Colour)
SELECT       :: 0x386a91.as(Colour)
MATCH        :: 0x5b5030.as(Colour)
MENU_PAPER   :: 0x202e42.as(Colour)
MENU_EDGE    :: 0x597a9c.as(Colour)
MENU_KEY     :: 0xa8dbef.as(Colour)
MENU_CAP     :: 0x344d69.as(Colour)
GUTTER_INK   :: 0xd6b35a.as(Colour)

message_rows :: fn (text: string, width: usize) -> [..]string {
    rows   : [..]string
    start  : usize      = 0
    offset : usize      = 0
    column : usize      = 0

    for offset < text.count {
        next := next_character(text, offset)
        on text[offset] == '\n' ||
            text[offset] == '\r' => {
            rows.push(text[start..offset])
            start  = next
            offset = next
            column = 0
            again
        }
        cells := character_width(text, offset, column)
        on column + cells > width &&
            offset > start => {
            rows.push(text[start..offset])
            start  = offset
            column = 0
            again
        }
        column += cells
        offset = next
    }
    rows.push(text[start..])
    return rows
}

impl Terminal {

    pub release :: fn (self: ^Self) {
        self.editor.release()
        self.scratch.done()
        self.cells.free()
        self.previous_cells.free()
        self.glyphs.free()
        self.previous_glyphs.free()
        self.glyph_arena.done()
        self.previous_arena.done()
        on self.signal_fd >= 0 => {
            _ := sys_close(self.signal_fd)
        }
        on self.signals_active => {
            _ := syscall(SYS_RT_SIGPROCMASK,
                         2,
                         (^self.signal_mask).as(usize).as(u64),
                         0,
                         8,
                         0,
                         0)
        }
    }

    pub signals_start :: fn (self: ^Self) -> void\string {
        self.signal_fd = -1
        mask : u64 = (1 << 14) | 3
        on syscall(SYS_RT_SIGPROCMASK, 0, (^mask).as(usize).as(u64), (^self.signal_mask).as(usize).as(u64), 8, 0, 0).as(i64) < 0 => return "Cannot arrange safe termination signals"!
        self.signals_active = yes
        fd := syscall(SYS_SIGNALFD4, (-1).as(u64), (^mask).as(usize).as(u64), 8, (0x800 | 0x80000), 0, 0).as(i32)
        on fd < 0 => return "Cannot open termination signal descriptor"!
        self.signal_fd = fd
    }

    pub simulate :: fn (self: ^Self) {
        self.scratch.reset()
        on self.frames >= 2 => {
            output : [..]u8
            defer output.free()
            for glyph in self.glyphs {
                on !glyph.pending => again
                ink   := glyph.ink.as(u32)
                paper := glyph.paper.as(u32)
                text  := self.scratch.pr($"\x1b[{glyph.y + 1};{glyph.x + 1}H\x1b[38;2;{(ink >> 16) & 255};{(ink >> 8) & 255};{ink & 255}m\x1b[48;2;{(paper >> 16) & 255};{(paper >> 8) & 255};{paper & 255}m{glyph.text}\x1b[0m")
                start := output.count

                output.resize_undefined_to(start + text.count)
                output[start..] = text.as([]u8)
                glyph.pending = no
            }
            on output.count > 0 => term_print(bytes_text(output))
        }
        signal : [128]u8
        on self.signal_fd >= 0 &&
            sys_read(self.signal_fd, ^signal, 128) == 128 => {
            on self.editor.quit_safely(^self.scratch) {
                _success => {
                }

                error! => self.editor.tell(error)
            }
        }
        self.editor.poll_file_picker()
        current := now()
        self.editor.poll_leader(current)
        on elapsed(self.last_poll, current) >= from_ms(250) => {
            self.editor.tick(^self.scratch)
            self.last_poll = current
        }
        on self.editor.quit => term_done()
    }

    set :: fn (self  : ^Self,
               x     : usize,
               y     : usize,
               rune  : u32,
               ink   : Colour,
               paper : Colour) {
        on x < self.width &&
            y < self.height => self.cells[(y + self.origin_y) * self.canvas_width + x + self.origin_x] = Cell {
            rune
            ink
            paper
            ...
        }
    }

    text :: fn (self      : ^Self,
                x         : usize,
                y         : usize,
                input     : string,
                ink       : Colour,
                paper     : Colour,
                max_width : usize) {
        text           := display_text(^self.scratch, input, single_line = yes)
        offset : usize = 0
        column : usize = 0

        for offset < text.count &&
            column < max_width &&
            x + column < self.width {
            next := next_character(text, offset)
            on text[offset] == '\n' || text[offset] == '\r' => break
            width := character_width(text, offset, column)
            on width == 0 => width = 1
            on column + width > max_width ||
                x + column + width > self.width => break
            self.character(x + column, y, text[offset..next], width, ink, paper)
            column += width
            offset = next
        }
    }

    character :: fn (self  : ^Self,
                     x     : usize,
                     y     : usize,
                     text  : string,
                     width : usize,
                     ink   : Colour,
                     paper : Colour) {
        (rune, size) := utf8_decode(text.as([]u8))
        on rune < 32 ||
            (rune >= 0x7f && rune < 0xa0) ||
            grapheme_property(rune) == 3 => {
            rune = 0xfffd
            on text[0] == '\t' => rune = ' '.as(u32)
        }
        cluster := text
        on scalar_width(rune) == 0 => {
            rune    = 0x25cc
            cluster = self.glyph_storage.pr($"◌{text}")
        }
        native_width := rune.display_width()
        composite    := (size < text.count || rune == 0x25cc || native_width.as(usize) != width) && text[0] != '\t'
        -- The backend's scalar-width table is narrower than Unicode 16.
        -- Do not emit a misleading head cell: it would shift subsequent
        -- physical output. Reserve spaces and overlay the real glyph instead.
        on composite &&
            native_width.as(usize) != width => {
            rune         = ' '.as(u32)
            native_width = 1
        }
        self.set(x, y, rune, ink, paper)
        for tail in [1.as(usize) .. width] {
            padding := on native_width > 0 && tail < native_width.as(usize) {
                yes   => 0.as(u32)
                else  => ' '.as(u32)
            }
            self.set(x + tail, y, padding, ink, paper)
        }
        on composite => {
            self.glyphs.push(Glyph {
                x    : x + self.origin_x
                y    : y + self.origin_y
                text : self.glyph_storage.pr(cluster)
                ink
                paper
                pending: yes
            })
        }
    }

    paint_preview :: fn (self    : ^Self,
                         preview : ?^Document,
                         x       : usize,
                         y       : usize,
                         width   : usize,
                         rows    : usize) {
        on width == 0 || rows == 0 => return
        self.text(x, y, "Preview (read-only)", MUTED, GUTTER_PAPER, width)
        on rows < 2 => return
        on preview => [document] {
            on document.text().count == document.line_start(0) => {
                self.text(x, y + 1, "[empty]", MUTED, GUTTER_PAPER, width)
                return
            }
            for row in [0.as(usize) .. rows - 1] {
                on row >= document.lines.count => break
                offset         := document.line_start(row)
                end            := document.line_end(row)
                column : usize = 0
                text           := document.text()

                for offset < end &&
                    column < width {
                    next  := next_character(text, offset)
                    cells := character_width(text, offset, column)

                    on cells == 0 => cells = 1
                    on column + cells > width => break
                    self.character(x + column,
                                   y + 1 + row,
                                   text[offset..next],
                                   cells,
                                   INK,
                                   GUTTER_PAPER)
                    column += cells
                    offset = next
                }
            }
        } else {
            self.text(x, y + 1, "No selection", MUTED, GUTTER_PAPER, width)
        }
    }

    paint_picker :: fn (self: ^Self, picker: ^FuzzyPicker, preview: ?^Document) {
        box := popup_bounds(self.width, self.height)
        -- Composite glyph overlays must not redraw through an opaque popup.
        kept : usize = 0
        for glyph in self.glyphs {
            cells := character_width(glyph.text, 0, glyph.x)
            on glyph.y >= box.y && glyph.y < box.y + box.height && glyph.x < box.x + box.width && glyph.x + cells > box.x {
                yes => {
                    end := on glyph.x + cells < self.width {
                        yes   => glyph.x + cells
                        else  => self.width
                    }
                    for x in [glyph.x .. end] {
                        self.set(x, glyph.y, ' '.as(u32), INK, PAPER)
                    }
                }

                else => {
                    self.glyphs[kept] = glyph^
                    kept += 1
                }
            }
        }
        self.glyphs.resize_undefined_to(kept)
        -- Also clip native double-width scalars whose head/tail straddles
        -- the popup edge, keeping retained cells equal to the physical screen.
        right := box.x + box.width
        for y in [box.y .. box.y + box.height] {
            on box.x > 0 &&
                self.cells[y * self.width + box.x].rune == 0 => {
                self.set(box.x - 1, y, ' '.as(u32), INK, PAPER)
            }
            on right < self.width &&
                self.cells[y * self.width + right].rune == 0 => {
                self.set(right, y, ' '.as(u32), INK, PAPER)
            }
        }
        for y in [box.y .. box.y + box.height] {
            for x in [box.x .. box.x + box.width] {
                self.set(x, y, ' '.as(u32), INK, GUTTER_PAPER)
            }
        }
        border := on box.width >= 4 && box.height >= 4 {
            yes   => 1.as(usize)
            else  => 0
        }
        left     := box.x + border
        inner    := box.width - border * 2
        search_y := box.y + border
        footer   := box.height >= 5
        bottom   := box.y + box.height - border

        on footer => bottom -= 1
        list_y := search_y + 1
        rows := on bottom > list_y {
            yes   => bottom - list_y
            else  => 0
        }
        list_width := on !self.editor.picking_files && inner >= 48 && rows >= 2 {
            yes   => inner * 2 / 5
            else  => inner
        }
        picker.reveal(rows)
        on border != 0 => {
            for x in [box.x + 1 .. box.x + box.width - 1] {
                self.set(x, box.y, '─'.as(u32), NORMAL_CARET, GUTTER_PAPER)
                self.set(x,
                         box.y + box.height - 1,
                         '─'.as(u32),
                         NORMAL_CARET,
                         GUTTER_PAPER)
            }
            for y in [box.y + 1 .. box.y + box.height - 1] {
                self.set(box.x, y, '│'.as(u32), NORMAL_CARET, GUTTER_PAPER)
                self.set(box.x + box.width - 1,
                         y,
                         '│'.as(u32),
                         NORMAL_CARET,
                         GUTTER_PAPER)
            }
            self.set(box.x, box.y, '┌'.as(u32), NORMAL_CARET, GUTTER_PAPER)
            self.set(box.x + box.width - 1,
                     box.y,
                     '┐'.as(u32),
                     NORMAL_CARET,
                     GUTTER_PAPER)
            self.set(box.x,
                     box.y + box.height - 1,
                     '└'.as(u32),
                     NORMAL_CARET,
                     GUTTER_PAPER)
            self.set(box.x + box.width - 1,
                     box.y + box.height - 1,
                     '┘'.as(u32),
                     NORMAL_CARET,
                     GUTTER_PAPER)
            title := self.scratch.pr($" {picker.title} · {picker.matches.count}/{picker.entries.count} ")
            self.text(box.x + 2,
                      box.y,
                      title,
                      NORMAL_CARET,
                      GUTTER_PAPER,
                      box.width - 4)
        }
        prefix := on inner >= 2 {
            yes   => 2.as(usize)
            else  => 0
        }
        on prefix > 0 => self.text(left, search_y, "> ", NORMAL_CARET, GUTTER_PAPER, prefix)
        shown             := display_text(^self.scratch, bytes_text(picker.query), single_line = yes)
        before            := display_text(^self.scratch, bytes_text(picker.query)[..picker.caret], single_line = yes)
        column            := display_column(before, 0, before.count)
        available         := inner - prefix
        offset    : usize = 0
        skipped   : usize = 0

        for offset < shown.count &&
            available > 0 &&
            column - skipped >= available {
            skipped += character_width(shown, offset, skipped)
            offset  = next_character(shown, offset)
        }
        self.text(left + prefix,
                  search_y,
                  shown[offset..],
                  INK,
                  GUTTER_PAPER,
                  available)
        on available > 0 &&
            column >= skipped &&
            column - skipped < available => {
            x    := left + prefix + column - skipped
            cell := ^self.cells[search_y * self.width + x]

            cell.ink = PAPER
            cell.paper = NORMAL_CARET
            for glyph in self.glyphs {
                on glyph.x == x &&
                    glyph.y == search_y => {
                    glyph.ink = PAPER
                    glyph.paper = NORMAL_CARET
                }
            }
        }
        for row in [0.as(usize) .. rows] {
            index := picker.top + row
            on index >= picker.matches.count => break
            item := picker.entries[picker.matches[index]]
            paper := on index == picker.selected {
                yes   => SELECT
                else  => GUTTER_PAPER
            }
            for x in [left .. left + list_width] {
                self.set(x, list_y + row, ' '.as(u32), INK, paper)
            }
            label := self.scratch.pr($" {item.annotation} {item.label}")
            self.text(left, list_y + row, label, INK, paper, list_width)
        }
        on picker.matches.count == 0 &&
            rows > 0 => self.text(left, list_y, " "
            +"No matches", MUTED, GUTTER_PAPER, list_width)
        on list_width < inner => {
            divider := left + list_width
            for row in [0.as(usize) .. rows] {
                self.set(divider,
                         list_y + row,
                         '│'.as(u32),
                         NORMAL_CARET,
                         GUTTER_PAPER)
            }
            self.paint_preview(preview,
                               divider + 1,
                               list_y,
                               inner - list_width - 1,
                               rows)
        }
        hint := on self.editor.picking_files {
            yes   => "Enter open · Esc cancel"
            else  => "Enter choose · Esc cancel · Ctrl+W close selected"
        }
        on footer => self.text(left, bottom, hint, MUTED, GUTTER_PAPER, inner)
    }

    paint_leader :: fn (self: ^Self, current: Instant) {
        prefix          := self.editor.leader_prefix
        choices : usize = 0

        for entry in LEADER_ENTRIES {
            on leader_child(entry^, prefix) => choices += 1
        }
        columns := on self.width >= 64 {
            yes   => 2.as(usize)
            else  => 1
        }
        rows := (choices + columns - 1) / columns
        full := rows + 6

        on full > self.height => full = self.height
        visible := leader_slide_rows(full, elapsed(self.editor.leader_revealed, current).to_ms())
        top     := self.height - visible
        -- This full-width surface is opaque to both native cells and the
        -- deferred composite-grapheme overlay, without changing view geometry.
        kept : usize = 0
        for glyph in self.glyphs {
            on glyph.y < top => {
                self.glyphs[kept] = glyph^
                kept += 1
            }
        }
        self.glyphs.resize_undefined_to(kept)
        for y in [top .. self.height] {
            for x in [0.as(usize) .. self.width] {
                self.set(x, y, ' '.as(u32), INK, MENU_PAPER)
            }
        }
        compact := self.height < rows + 6
        padding := on self.width >= 8 {
            yes   => 2.as(usize)
            else  => 0
        }
        inner   := self.width - padding * 2
        title_y := top
        entry_y := top + 1

        on !compact => {
            for x in [0.as(usize) .. self.width] {
                self.set(x, top, 0x2500, MENU_EDGE, MENU_PAPER)
            }
            title_y += 1
            entry_y += 2
        }
        heading := "Space menu"
        for entry in LEADER_ENTRIES {
            on entry.sequence == prefix => heading = self.scratch.pr($"Space menu / {entry.label}")
        }
        self.text(padding, title_y, heading, MENU_KEY, MENU_PAPER, inner)
        index : usize = 0
        for entry in LEADER_ENTRIES {
            on !leader_child(entry^, prefix) => again
            column     := index % columns
            row        := entry_y + index / columns
            x          := padding + column * (inner / columns)
            cell_width := inner / columns
            key        := entry.sequence[prefix.count..]

            cap := on key == " " {
                yes   => "[ SPC ]"
                else  => self.scratch.pr($"[  {key}  ]")
            }

            self.text(x, row, cap, MENU_KEY, MENU_CAP, cell_width)
            on cell_width > 9 => {
                label := on entry.operation == LeaderOperation.Group {
                    yes   => self.scratch.pr($"{entry.label}  ›")
                    else  => entry.label
                }
                self.text(x + 9, row, label, INK, MENU_PAPER, cell_width - 9)
            }
            index += 1
        }
        on !compact => {
            hint := on prefix.count == 0 {
                yes   => "Esc cancel"
                else  => "Esc cancel   ·   Backspace back"
            }
            self.text(padding, top + full - 2, hint, MUTED, MENU_PAPER, inner)
        }
    }

    paint_pane :: fn (self    : ^Self,
                      view_id : usize,
                      rect    : PaneRect,
                      active  : bool,
                      resized : bool) {
        on rect.width == 0 || rect.height == 0 => return
        width        := rect.width
        height       := rect.height
        saved_height := self.height

        self.width = width
        self.height = height
        self.origin_x = rect.x
        self.origin_y = rect.y
        editor    := ^self.editor
        text_view := ^editor.workspace.views[view_id]
        view      := ^text_view.interaction
        inserting := view.state == Interaction.Insert

        caret_paper := on inserting {
            yes   => INSERT_CARET
            else  => NORMAL_CARET
        }
        status_paper := on !active {
            yes => GUTTER_PAPER

            else => on inserting { yes => INSERT_PAPER else => NORMAL_PAPER }
        }
        entry      := ^editor.workspace.documents[text_view.document_id]
        doc        := ^entry.text
        caret_line := doc.line_at(view.selection.active)

        rows := on height > 1 {
            yes   => height - 1
            else  => 0
        }
        previously_visible := caret_line >= view.top && caret_line < view.top + view.rows
        on (resized || view.rows != rows) &&
            previously_visible &&
            (caret_line < view.top || caret_line >= view.top + rows) => {
            view.top = on caret_line > rows / 2 {
                yes   => caret_line - rows / 2
                else  => 0
            }
        }
        view.rows = on rows > 0 {
            yes   => rows
            else  => 1
        }
        digits    : usize = 1
        magnitude         := doc.lines.count

        for magnitude >= 10 {
            magnitude /= 10
            digits    += 1
        }
        gutter := on width >= digits + 5 {
            yes   => digits + 2
            else  => 0
        }
        view.columns = width - gutter
        on caret_line != text_view.previous_caret_line => view.horizontal = 0
        text_view.previous_caret_line = caret_line
        on view.reveal => {
            on caret_line < view.top => view.top = caret_line
            on caret_line >= view.top + view.rows => view.top = caret_line - view.rows + 1
            column := display_column(doc.text(),
                                     doc.line_start(caret_line),
                                     view.selection.active)
            on column < view.horizontal => view.horizontal = column
            on view.columns > 0 &&
                column >= view.horizontal + view.columns => view.horizontal = column - view.columns + 1
            view.reveal = no
        }
        query := on editor.prompt_kind != 0 && editor.prompt_kind != ':'.as(u32) {
            yes   => editor.search_query()
            else  => bytes_text(editor.last_search)
        }
        for row in [0.as(usize) .. rows] {
            line := view.top + row
            on line >= doc.lines.count => again
            number := on view.state == Interaction.Insert || line == caret_line {
                yes => line + 1

                else => on line > caret_line {
                    yes   => line - caret_line
                    else  => caret_line - line
                }
            }
            on gutter > 0 => {
                current := line == caret_line
                ink := on current {
                    yes   => GUTTER_INK
                    else  => MUTED
                }
                paper := on current {
                    yes   => GUTTER_PAPER
                    else  => PAPER
                }
                on current => {
                    for x in [0.as(usize) .. gutter] {
                        self.set(x, row, ' '.as(u32), ink, paper)
                    }
                }
                label := self.scratch.pr($"{number}")
                self.text(gutter - 1 - label.count,
                          row,
                          label,
                          ink,
                          paper,
                          label.count)
            }
            horizontal := on line == caret_line {
                yes   => view.horizontal
                else  => 0
            }
            position          := doc.line_start(line)
            end               := doc.line_end(line)
            column    : usize = 0
            match_end : usize = 0
            -- Find visible-line occurrences independently; include a match
            -- beginning on an earlier line and continuing into this one.
            match_position : usize = 0
            on active &&
                editor.highlights &&
                query.count > 0 => {
                match_position = on position > query.count {
                    yes   => position - query.count
                    else  => 0
                }
            }
            for position < end {
                next  := next_character(doc.text(), position)
                cells := character_width(doc.text(), position, column)

                on cells == 0 => cells = 1
                paper := PAPER
                ink   := INK

                on active &&
                    editor.highlights &&
                    query.count > 0 => {
                    for match_position < next &&
                        match_position + query.count <= doc.text().count {
                        on doc.text()[match_position..match_position + query.count] == query => match_end = match_position + query.count
                        match_position += 1
                    }
                    on position < match_end => paper = MATCH
                }
                on position < view.selection.end() &&
                    next > view.selection.start() => paper = SELECT
                on active &&
                    editor.prompt_kind == 0 &&
                    view.selection.active >= position &&
                    view.selection.active < next => {
                    paper = caret_paper
                    ink   = PAPER
                }
                on column >= horizontal &&
                    column - horizontal + cells <= view.columns => {
                    self.character(gutter + column - horizontal,
                                   row,
                                   doc.text()[position..next],
                                   cells,
                                   ink,
                                   paper)
                }
                column   += cells
                position = next
                on column >= horizontal + view.columns => break
            }
            on active &&
                editor.prompt_kind == 0 &&
                view.selection.active == end &&
                column >= horizontal &&
                column - horizontal < view.columns => self.set(gutter + column - horizontal, row, ' '.as(u32), PAPER, caret_paper)
        }
        on height > 0 => {
            status_y := height - 1
            for x in [0.as(usize) .. width] {
                self.set(x, status_y, ' '.as(u32), INK, status_paper)
            }
            badge := on width < 32 {
                yes => on inserting { yes => " I " else => " N " }

                else => on inserting {
                    yes   => " ✎ INSERT "
                    else  => " ◆ NORMAL "
                }
            }
            badge_width := display_column(badge, 0, badge.count)
            path := on entry.path.count == 0 {
                yes   => "[unnamed]"
                else  => bytes_text(entry.path)
            }
            folder := bytes_text(editor.workspace.folder)
            on folder.count > 0 &&
                path.count > folder.count &&
                path[..folder.count] == folder &&
                path[folder.count] == '/' => path = path[folder.count + 1..]
            modified := on entry.modified() {
                yes   => " ●"
                else  => ""
            }
            conflict := on entry.conflict {
                yes   => " !conflict"
                else  => ""
            }
            missing := on entry.missing {
                yes   => " ?missing"
                else  => ""
            }
            persistence := on editor.workspace.checkpoint_failed {
                yes => " !C"

                else => on editor.workspace.persistent {
                    yes   => ""
                    else  => " ~"
                }
            }
            count := on text_view.keyboard.count > 0 {
                yes   => self.scratch.pr($"  {text_view.keyboard.count}")
                else  => ""
            }
            status := self.scratch.pr($"{persistence}{conflict}{missing}{modified} │ {caret_line + 1}:{display_column(doc.text(), doc.line_start(caret_line), view.selection.active) + 1}{count} │ {text_view.document_id + 1}/{editor.workspace.documents.count} │ {path}")
            self.text(0, status_y, badge, PAPER, caret_paper, width)
            on width > badge_width => self.text(badge_width, status_y, status, INK, status_paper, width - badge_width)
        }
        self.width = self.canvas_width
        self.height = saved_height
        self.origin_x = 0
        self.origin_y = 0
    }

    pub paint :: fn (self: ^Self, width: usize, height: usize) {
        self.scratch.reset()
        on width == 0 || height == 0 => return
        resized := width != self.width || height != self.height
        self.width = width
        self.height = height
        self.canvas_width = width
        self.origin_x = 0
        self.origin_y = 0
        self.frames += 1
        old_glyphs := self.previous_glyphs
        self.previous_glyphs = self.glyphs
        self.glyphs = old_glyphs
        self.glyphs.clear()
        self.glyph_storage = on self.frames % 2 == 0 {
            yes   => ^self.glyph_arena
            else  => ^self.previous_arena
        }
        self.glyph_storage.reset()
        old_cells := self.previous_cells
        self.previous_cells = self.cells
        self.cells = old_cells
        self.cells.resize_undefined_to(width * height)
        for cell in self.cells {
            cell^ = Cell { rune: ' '.as(u32) ink: INK paper: PAPER ... }
        }
        editor := ^self.editor
        caret_paper := on editor.workspace.active_view().interaction.state == Interaction.Insert {
            yes   => INSERT_CARET
            else  => NORMAL_CARET
        }
        message  := display_text(^self.scratch, bytes_text(editor.message))
        messages := message_rows(message, width)

        defer messages.free()
        message_lines := messages.count
        message_height := on editor.completion.active {
            yes => on editor.completion.items.count > 0 {
                yes => editor.completion.items.count + 1

                else => on message.count > 0 {
                    yes   => message_lines + 1
                    else  => 2
                }
            }

            else => on message.count > 0 {
                yes => message_lines + (on editor.prompt_kind != 0 { yes => 1 else => 0 })

                else => 1
            }
        }
        maximum_message_height := on editor.diagnostics.active {
            yes   => height - 1
            else  => height / 2
        }
        on message_height > maximum_message_height => message_height = maximum_message_height
        on message_height == 0 => message_height = 1
        available := on height > message_height {
            yes   => height - message_height
            else  => 0
        }
        workspace := ^editor.workspace
        workspace.panes.ensure(workspace.surface.view_id)
        workspace.panes.arrange(width, available)
        on workspace.panes.compact {
            yes => self.paint_pane(workspace.surface.view_id, PaneRect {
                width
                height: available
                ...
            }, yes, resized)

            else => {
                for id, node in workspace.panes.nodes {
                    on !node.used => again
                    on node.split {
                        yes => {
                            a := workspace.panes.nodes[node.first].rect
                            r := node.rect

                            on node.vertical {
                                yes => {
                                    for y in [r.y .. r.y + r.height] {
                                        self.set(a.x + a.width,
                                                 y,
                                                 '│'.as(u32),
                                                 MENU_EDGE,
                                                 PAPER)
                                    }
                                }

                                else => {
                                    for x in [r.x .. r.x + r.width] {
                                        self.set(x,
                                                 a.y + a.height,
                                                 '─'.as(u32),
                                                 MENU_EDGE,
                                                 PAPER)
                                    }
                                }
                            }
                        }

                        else => self.paint_pane(node.view_id, node.rect, id == workspace.panes.focused, resized)
                    }
                }
            }
        }
        bottom := height - message_height
        on editor.prompt_kind != 0 {
            yes => {
                prompt_y         := height - 1
                encoded  : [4]u8
                size             := editor.prompt_kind.as(Rune).utf8_encode(encoded[..])
                shown            := display_text(^self.scratch, bytes_text(editor.prompt), single_line = yes)
                prefix           := display_text(^self.scratch, bytes_text(editor.prompt)[..editor.prompt_caret], single_line = yes)
                prompt           := self.scratch.pr($"{encoded[..size].as(string)}{shown}")
                column           := 1 + display_column(prefix, 0, prefix.count)

                horizontal := on column >= width {
                    yes   => column - width + 1
                    else  => 0
                }
                offset  : usize = 0
                skipped : usize = 0

                for offset < prompt.count &&
                    skipped < horizontal {
                    skipped += character_width(prompt, offset, skipped)
                    offset  = next_character(prompt, offset)
                }
                self.text(0, prompt_y, prompt[offset..], INK, PAPER, width)
                on column >= skipped &&
                    column - skipped < width => {
                    cell := ^self.cells[prompt_y * width + column - skipped]
                    cell.ink = PAPER
                    cell.paper = caret_paper
                    for glyph in self.glyphs {
                        on glyph.x == column - skipped &&
                            glyph.y == prompt_y => {
                            glyph.ink = PAPER
                            glyph.paper = caret_paper
                        }
                    }
                }
                available := message_height - 1
                on editor.completion.active {
                    yes => {
                        on editor.completion.items.count == 0 => {
                            on message.count > 0 {
                                yes => {
                                    for row in [0.as(usize) .. available] {
                                        on row < messages.count => self.text(0, bottom + row, messages[row], INK, PAPER, width)
                                    }
                                }

                                else => on available > 0 => self.text(0, bottom, on editor.completion.command_mode { yes => "No matching commands" else => "No "
                                    +"matching files" }, MUTED, PAPER, width)
                            }
                        }
                        first := on editor.completion.selected >= available {
                            yes   => editor.completion.selected - available + 1
                            else  => 0
                        }
                        for row in [0.as(usize) .. available] {
                            index := first + row
                            on index >= editor.completion.items.count => break
                            selected := index == editor.completion.selected
                            paper := on selected {
                                yes   => SELECT
                                else  => PAPER
                            }
                            for x in [0.as(usize) .. width] {
                                self.set(x,
                                         bottom + row,
                                         ' '.as(u32),
                                         INK,
                                         paper)
                            }
                            marker := on selected {
                                yes   => "› "
                                else  => "  "
                            }
                            label := display_text(^self.scratch,
                                                  editor.completion.items[index],
                                                  single_line = yes)
                            self.text(0,
                                      bottom + row,
                                      self.scratch.pr($"{marker}{label}"),
                                      INK,
                                      paper,
                                      width)
                        }
                    }

                    else => {
                        for row in [0.as(usize) .. available] {
                            on row < messages.count => self.text(0, bottom + row, messages[row], INK, PAPER, width)
                        }
                    }
                }
            }

            else => {
                scroll := editor.message_scroll
                on scroll + message_height > message_lines => scroll = on message_lines > message_height {
                    yes   => message_lines - message_height
                    else  => 0
                }
                editor.message_scroll = scroll
                for row in [0.as(usize) .. message_height] {
                    on scroll + row < messages.count => self.text(0, bottom + row, messages[scroll + row], INK, PAPER, width)
                }
            }
        }
        on editor.picker.active => {
            preview : ?^Document = nil
            on !editor.picking_files => {
                on editor.picker.chosen() => [id] {
                    on id < editor.workspace.documents.count => preview = ^editor.workspace.documents[id].text
                }
            }
            self.paint_picker(^editor.picker, preview)
        }
        on editor.leader && editor.leader_shown => self.paint_leader(now())
        -- Invalidate an old composite only when its text/colour/position changes.
        -- Otherwise std.term must leave its base cell clean for the overlay.
        for previous in self.previous_glyphs {
            same := no
            for glyph in self.glyphs {
                on glyph.x == previous.x &&
                    glyph.y == previous.y &&
                    glyph.text == previous.text &&
                    glyph.ink == previous.ink &&
                    glyph.paper == previous.paper => {
                    glyph.pending = previous.pending || resized
                    same = yes
                }
            }
            on !same &&
                previous.x < width &&
                previous.y < height => {
                term_fb_put(previous.x.as(i32),
                            previous.y.as(i32),
                            ' '.as(u32),
                            ink = previous.ink,
                            paper = previous.paper)
                self.cells[previous.y * width + previous.x].force = yes
                on previous.x + 1 < width => self.cells[previous.y * width + previous.x + 1].force = yes
            }
        }
        for y in [0.as(usize) .. height] {
            for x in [0.as(usize) .. width] {
                cell := self.cells[y * width + x]
                on cell.rune == 0 => again
                on !resized &&
                    !cell.force &&
                    y * width + x < self.previous_cells.count => {
                    previous := self.previous_cells[y * width + x]
                    on cell.rune == previous.rune &&
                        cell.ink == previous.ink &&
                        cell.paper == previous.paper => again
                }
                term_fb_put(x.as(i32),
                            y.as(i32),
                            cell.rune,
                            ink = cell.ink,
                            paper = cell.paper)
            }
        }
        term_present_cursor(0, 0, visible = no)
    }

}

pub input_hook :: fn (input: TermInput) {
    terminal := input.user_data.as(^Terminal)
    terminal.scratch.reset()
    terminal.editor.diagnostics.capabilities = input.keyboard.capabilities
    for event in input.events {
        on event^ {
            Key(key)         => terminal.editor.key(^terminal.scratch, key)
            Character(rune)  => terminal.editor.character(^terminal.scratch, rune)

            else => {
            }
        }
        on terminal.editor.quit => {
            term_done()
            break
        }
    }
    on terminal.editor.diagnostics.active => {
        scroll := terminal.editor.message_scroll
        terminal.editor.tell(terminal.editor.diagnostics.message(^terminal.scratch))
        terminal.editor.message_scroll = scroll
    }
}

pub simulation_hook :: fn (simulation: TermSimulate) {
    simulation.user_data.as(^Terminal).simulate()
}

pub presentation_hook :: fn (presentation: TermPresent) {
    presentation.user_data.as(^Terminal).paint(presentation.width.as(usize),
                                               presentation.height.as(usize))
}

test "buffer preview follows selection without touching views or history" {
    terminal : Terminal
    terminal.signal_fd = -1
    terminal.editor.workspace.lock_fd = -1
    defer terminal.release()
    terminal.editor.workspace.add_empty()
    on terminal.editor.workspace.active_document().text.load("Alpha") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    terminal.editor.workspace.active_view().interaction.selection.collapse(2)
    terminal.editor.workspace.add_empty()
    on terminal.editor.workspace.active_document().text.load("Bravo\n\t界👩‍💻\x1b") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    terminal.editor.character(^terminal.scratch, 'U'.as(u32))
    assert terminal.editor.workspace.active_document().modified()
    assert terminal.editor.workspace.focus_document(0)
    terminal.editor.open_buffer_picker(^terminal.scratch)
    terminal.paint(80, 24)
    box := popup_bounds(80, 24)
    x   := box.x + 1 + (box.width - 2) * 2 / 5 + 1
    y   := box.y + 3

    assert terminal.cells[y * 80 + x].rune == 'U'.as(u32)
    assert terminal.cells[(y + 1) * 80 + x + 4].rune == '界'.as(u32)
    assert terminal.glyphs.count > 0
    assert terminal.editor.workspace.active_view().document_id == 0
    assert terminal.editor.workspace.views[0].interaction.selection.active == 2
    assert terminal.editor.workspace.views[1].interaction.selection.active == 1
    assert terminal.editor.workspace.access_order[0] == 0
    terminal.editor.picker.move_selection(yes)
    terminal.paint(80, 24)
    assert terminal.cells[y * 80 + x].rune == 'A'.as(u32)
    terminal.editor.picker.insert("no matches")
    terminal.paint(80, 24)
    assert terminal.cells[y * 80 + x].rune == 'N'.as(u32)
    assert terminal.editor.workspace.documents[1].text.text() == "UBravo\n\t界👩‍💻\x1b"
    for width in [1.as(usize), 20, 40, 58, 80] {
        terminal.paint(width^, 8)
        assert terminal.cells.count == width^ * 8
    }
}

test "buffer popup is opaque, selected and safe across Unicode and tiny resizes" {
    terminal : Terminal
    terminal.signal_fd = -1
    terminal.editor.workspace.lock_fd = -1
    defer terminal.release()
    terminal.editor.workspace.add_empty()
    own(^terminal.editor.workspace.active_document().path, "/first")
    on terminal.editor.workspace.active_document().text.load("0\n1\n2\na界abcdefghij👩‍💻rest") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    terminal.editor.workspace.add_empty()
    own(^terminal.editor.workspace.active_document().path, "/second")
    assert terminal.editor.workspace.focus_document(0)
    terminal.paint(80, 24)
    assert terminal.glyphs.count > 0
    assert terminal.cells[3 * 80 + 4].rune == '界'.as(u32)
    terminal.editor.open_buffer_picker(^terminal.scratch)
    terminal.paint(80, 24)
    assert terminal.editor.picker.selected == 1
    assert terminal.cells[5 * 80 + 6].paper == SELECT
    assert terminal.glyphs.count == 0
    assert terminal.cells[3 * 80 + 4].rune == ' '.as(u32)
    assert terminal.editor.workspace.active_view().interaction.selection.active == 0
    terminal.editor.picker.insert("👩‍💻")
    terminal.paint(80, 24)
    assert terminal.glyphs.count > 0
    for size in [1.as(usize), 2, 4, 8, 20] {
        terminal.paint(size^, size^)
        assert terminal.cells.count == size^ * size^
    }
    terminal.editor.picker.active = no
    terminal.paint(80, 24)
    assert terminal.glyphs.count > 0
    assert terminal.cells[3 * 80 + 4].rune == '界'.as(u32)
}

test "mode presentation uses contrasting green/red cursors and UTF-8 status badges, including narrow layouts" {
    terminal : Terminal
    terminal.signal_fd = -1
    terminal.editor.workspace.lock_fd = -1
    defer terminal.release()
    terminal.editor.workspace.add_empty()
    doc := ^terminal.editor.workspace.active_document().text
    on doc.load("abc") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    view := ^terminal.editor.workspace.active_view().interaction
    view.state = Interaction.Normal
    terminal.paint(40, 8)
    assert terminal.cells[3].paper == 0x7bd88f.as(Colour)
    assert terminal.cells[3].ink == 0x171d27.as(Colour)
    assert terminal.cells[3].rune == 'a'.as(u32)
    assert terminal.cells[6 * 40].paper == 0x7bd88f.as(Colour)
    assert terminal.cells[6 * 40 + 39].paper == 0x214c38.as(Colour)
    assert terminal.cells[6 * 40 + 1].rune == 0x25c6
    assert terminal.cells[6 * 40 + 3].rune == 'N'.as(u32)
    marker := no
    for cell in terminal.cells[6 * 40..7 * 40] {
        on cell.rune == 0x25cf => marker = yes
    }
    assert marker
    view.state = Interaction.Insert
    terminal.paint(40, 8)
    assert terminal.cells[3].paper == 0xf07178.as(Colour)
    assert terminal.cells[3].ink == 0x171d27.as(Colour)
    assert terminal.cells[6 * 40].paper == 0xf07178.as(Colour)
    assert terminal.cells[6 * 40 + 39].paper == 0x602d35.as(Colour)
    assert terminal.cells[6 * 40 + 1].rune == 0x270e
    assert terminal.cells[6 * 40 + 3].rune == 'I'.as(u32)
    for width in [1.as(usize), 2, 7, 10, 20] {
        terminal.paint(width^, 2)
        assert terminal.cells.count == width^ * 2
    }
    terminal.editor.workspace.checkpoint_failed = yes
    terminal.paint(8, 2)
    assert terminal.cells[1].rune == 'I'.as(u32)
    assert terminal.cells[4].rune == '!'.as(u32)
    assert terminal.cells[5].rune == 'C'.as(u32)
    terminal.editor.prompt_open(':'.as(u32), initial = "e a")
    terminal.editor.completion.items.push("a\n\t.txt")
    terminal.editor.completion.items.push("another.txt")
    terminal.editor.completion.active = yes
    terminal.paint(40, 8)
    assert terminal.cells[5 * 40].paper == 0x386a91.as(Colour)
    assert terminal.cells[5 * 40].rune == 0x203a
    assert terminal.cells[5 * 40 + 3].rune == 0xfffd
    assert terminal.cells[7 * 40].rune == ':'.as(u32)
    terminal.editor.completion.selected = 1
    terminal.paint(40, 8)
    assert terminal.cells[6 * 40].paper == 0x386a91.as(Colour)
    assert terminal.cells[7 * 40].rune == ':'.as(u32)
    terminal.editor.completion.items.clear()
    terminal.paint(40, 8)
    assert terminal.cells[6 * 40].rune == 'N'.as(u32)
    assert terminal.cells[7 * 40].rune == ':'.as(u32)
    terminal.paint(1, 1)
    assert terminal.cells.count == 1
    terminal.paint(0, 0)
    terminal.editor.diagnostics.start()
    terminal.editor.tell(terminal.editor.diagnostics.message(^terminal.scratch))
    for rows in [1.as(usize), 2, 8] {
        terminal.paint(20, rows^)
        assert terminal.cells.count == 20 * rows^
    }
    terminal.paint(0, 0)
}

test "leader overlay is opaque and clipped without changing view geometry or messages" {
    terminal : Terminal
    terminal.signal_fd = -1
    terminal.editor.workspace.lock_fd = -1
    defer terminal.release()
    terminal.editor.workspace.add_empty()
    storage : arena
    defer storage.done()
    text := ""
    for _index in [0 .. 40] {
        text = storage.pr($"{text}界👩‍💻menu background\n")
    }
    on terminal.editor.workspace.active_document().text.load(text) {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    terminal.editor.tell("Existing message")
    terminal.paint(80, 24)
    view  := ^terminal.editor.workspace.active_view().interaction
    rows  := view.rows
    top   := view.top
    caret := view.selection.active

    terminal.editor.leader = yes
    terminal.editor.leader_shown = yes
    terminal.editor.leader_revealed = 0
    terminal.paint(80, 24)
    assert view.rows == rows && view.top == top && view.selection.active == caret
    assert bytes_text(terminal.editor.message) == "Existing message"
    for glyph in terminal.glyphs {
        assert glyph.y < 15
    }
    assert terminal.cells[16 * 80 + 2].rune == 'S'.as(u32)
    terminal.editor.cancel_leader()
    terminal.paint(80, 24)
    assert view.rows == rows && bytes_text(terminal.editor.message) == "Existin"
        +"g message"

    terminal.editor.leader = yes
    terminal.editor.leader_shown = yes
    for size in [1.as(usize), 2, 4, 8, 24] {
        terminal.paint(size^, size^)
        assert terminal.cells.count == size^ * size^
        for glyph in terminal.glyphs {
            assert glyph.x < size^ && glyph.y < size^
        }
    }
}

test "pane rendering offsets Unicode glyphs, shows only the active caret and survives tiny resizes" {
    terminal : Terminal
    terminal.signal_fd = -1
    terminal.editor.workspace.lock_fd = -1
    defer terminal.release()
    terminal.editor.workspace.add_empty()
    own(^terminal.editor.workspace.folder, "/pane")
    own(^terminal.editor.workspace.active_document().path, "/pane/demo.n")
    on terminal.editor.workspace.active_document().text.load("a界👩‍💻\nsecond") {
        _success => {
        }

        _error! => {
            assert no
        }
    }
    terminal.editor.workspace.active_view().interaction.state = Interaction.Normal
    terminal.paint(80, 24)
    on terminal.editor.workspace.split_pane(SplitAxis.Vertical) {
        _success => {
        }

        error! => {
            assert no, error
        }
    }
    terminal.paint(80, 24)
    assert terminal.cells[39].rune == '│'.as(u32)
    assert terminal.cells[3].rune == 'a'.as(u32) && terminal.cells[43].rune == 'a'.as(u32)
    assert terminal.cells[3].paper == PAPER && terminal.cells[43].paper == NORMAL_CARET
    filename := no
    for x in [0.as(usize) .. 34] {
        on terminal.cells[22 * 80 + x].rune == 'd'.as(u32) &&
            terminal.cells[22 * 80 + x + 5].rune == 'n'.as(u32) => filename = yes
    }
    assert filename, "Pane status must retain the relative filename"
    left  := no
    right := no

    for glyph in terminal.glyphs {
        on glyph.text == "👩‍💻" => {
            on glyph.x < 39 {
                yes   => left = yes
                else  => right = yes
            }
        }
    }
    assert left && right
    for size in [1.as(usize), 2, 4, 8] {
        terminal.paint(size^, size^)
        assert terminal.editor.workspace.panes.compact
        for glyph in terminal.glyphs {
            assert glyph.x < size^ && glyph.y < size^
        }
    }
    terminal.paint(80, 24)
    assert !terminal.editor.workspace.panes.compact
    assert terminal.cells[39].rune == '│'.as(u32)
    terminal.editor.workspace.close_pane()
    on terminal.editor.workspace.split_pane(SplitAxis.Horizontal) {
        _success => {
        }

        error! => {
            assert no, error
        }
    }
    terminal.paint(80, 24)
    assert terminal.cells[11 * 80].rune == '─'.as(u32)
    assert terminal.cells[12 * 80 + 3].rune == 'a'.as(u32)
}
