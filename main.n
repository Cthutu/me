use os.linux
use src.editor
use src.native
use src.terminal
use src.workspace
use std.term
use std.time

main :: fn (args: []string) -> i32 {
    reset           := no
    plain_files     := no
    continued_files := no

    for argument in args[1..] {
        on argument^ == "--help" => {
            prn("ME — Matt's Editor\nUsage: me [-r] [filename ...] OR me [+filename ...]\nBare me restores continuation; plain filenames clear it and start fresh.\n+filename restores continuation and adds files; do not mix plain and + paths.\nThe first successful path is displayed. -r explicitly clears continuation.\n:q quit  :q! remove unsaved buffers  :w[!] [filename] save\n:kill[!] kills the active buffer (force with !).\n:keys shows keyboard capabilities and decoded events.\nCursor keys and Normal hjkl navigate; i enters Insert; Escape returns to Normal.\nCtrl+S save  Ctrl+Z undo  Ctrl+R redo  Ctrl+D duplicate line\nCtrl+H/L move by word; Ctrl+J/K scroll (enhanced keyboard reports).\nNormal , opens buffers; Ctrl+W closes the selected/active saved buffer.\nNormal Space Space or :files opens files; Space waits one second for key help.\nSpace w h splits side by side; w v stacks above/below; w s splits automatically.\nSpace w c closes a pane.\nSpace w w picks a file for a new pane; Space hjkl/arrows focuses neighbours.\nw/q select words/lines; y/x/v copy/cut/paste; c changes selection.\n/ and ? search; n/p select next/previous matches.")
            return 0
        }
        on argument^ == "-r" {
            yes => reset = yes

            else => {
                on argument.count > 0 &&
                    argument^[0] == '-' => {
                    eprn("\x1b[31mME: expected me [-r] [filename ...]\x1b[0m")
                    return 2
                }
                on argument.count > 0 => {
                    on argument^[0] == '+' {
                        yes => {
                            on argument.count == 1 => {
                                eprn("\x1b[31mME: + requires a filename; use ./+ for a literal plus filename\x1b[0m")
                                return 2
                            }
                            continued_files = yes
                        }

                        else => plain_files = yes
                    }
                }
            }
        }
    }
    on continued_files &&
        (plain_files || reset) => {
        eprn("\x1b[31mME: cannot mix +filename with plain filenames or -r\x1b[0m")
        return 2
    }
    reset = reset || plain_files
    attributes : Termios
    on sys_ioctl(STDIN_FILENO, TCGETS.as(u64), ^attributes) != 0 ||
        sys_ioctl(STDOUT_FILENO, TCGETS.as(u64), ^attributes) != 0 => {
        eprn("ME requires an interactive Linux terminal. Use --help for usage.")
        return 2
    }
    terminal : Terminal
    terminal.signal_fd = -1
    terminal.editor.workspace.lock_fd = -1
    defer terminal.release()
    on terminal.editor.workspace.initialise(^terminal.scratch, reset) {
        _success => {
        }

        message! => {
            on reset &&
                terminal.editor.workspace.lock_fd >= 0 => {
                eprn($"\x1b[31mME: {message}\x1b[0m")
                return 2
            }
            terminal.editor.tell(message)
        }
    }
    first_view  : ?usize = nil
    open_failed          := no

    for filename in args[1..] {
        on filename.count == 0 || filename^ == "-r" => again
        path := on continued_files {
            yes   => filename^[1..]
            else  => filename^
        }
        on terminal.editor.workspace.open_file(^terminal.scratch, path) {
            _success => {
                on first_view == nil => first_view = terminal.editor.workspace.surface.view_id
            }

            error! => {
                eprn($"\x1b[31mME: {display_text(^terminal.scratch, path, single_line = yes)}: {error}\x1b[0m")
                open_failed = yes
                terminal.editor.tell(error)
            }
        }
    }
    on open_failed && terminal.editor.workspace.documents.count == 0 => return 2
    on first_view => [id] {
        terminal.editor.workspace.focus_view(id)
    }
    on terminal.editor.workspace.views.count == 0 => terminal.editor.workspace.add_empty()
    on terminal.signals_start() {
        _success => {
        }

        error! => {
            eprn($"\x1b[31mME: {error}\x1b[0m")
            return 2
        }
    }
    terminal.editor.dirty = yes
    terminal.editor.changed_at = now()
    term_init(min_width = 1,
              min_height = 1,
              too_small_policy = TermTooSmallPolicy.ContinueSimulation)
    term_cursor_enable(no)
    term_hook_input(input_hook, user_data = ^terminal)
    term_hook_simulation(from_ms(16), simulation_hook, user_data = ^terminal)
    term_hook_presentation(from_ms(16),
                           presentation_hook,
                           user_data = ^terminal)
    term_run()
    return 0
}
